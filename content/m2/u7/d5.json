{
 "id": "m2.u7.d5",
 "title": "الأَشْكَالُ المُرَكَّبَةُ",
 "icon": [
  "arcomp"
 ],
 "concepts": {
  "C208": "مساحة الشكل المركّب بالتقسيم إلى مستطيلات، أو بالإتمام ثم الطرح (استدعاء تفكيك الأشكال C163)",
  "C209": "محيط الشكل المركّب، واستنتاج الضلع غير المكتوب، ومحيط L = محيط المستطيل المحيط به (لا شكل U)"
 },
 "bag": {
  "items": [
   {
    "icon": "gridPaper",
    "label": "bagGrid"
   },
   {
    "icon": "pencils",
    "label": "bagPens"
   }
  ],
  "ask": "bag.ask",
  "adult": "ورق مربعات وأقلام تلوين.",
  "screenPath": "على الشاشة يقسّم الطفل الشكل المركّب أو يتمّه ثم يطرح، ويجد محيطه ويستنتج الأطوال الناقصة؛ والتلوين الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagPens": "أَقْلَامُ تَلْوِينٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "lt.01": "أَرْضٌ عَلَى شَكْلِ حَرْفِ L. كَيْفَ نَحْسُبُ مَسَاحَتَهَا؟",
  "lt.02": "أَوَّلًا: نُقَسِّمُهَا مُسْتَطِيلَيْنِ، وَنَجْمَعُ مَسَاحَتَيْهِمَا: اثْنَا عَشَرَ وَثَمَانِيَةٌ، عِشْرُونَ.",
  "lt.03": "أَوْ نُتِمُّهَا مُسْتَطِيلًا كَبِيرًا، ثُمَّ نَطْرَحُ الرُّكْنَ النَّاقِصَ: أَرْبَعَةٌ وَعِشْرُونَ نَاقِصَ أَرْبَعَةٍ، عِشْرُونَ.",
  "lt.04": "التَّقْسِيمُ وَالإِتْمَامُ يُعْطِيَانِ الجَوَابَ نَفْسَهُ.",
  "lp.01": "وَالمُحِيطُ؟ نَمْشِي عَلَى أَضْلَاعِ شَكْلِ L كُلِّهَا.",
  "lp.02": "مُحِيطُهُ يُسَاوِي مُحِيطَ المُسْتَطِيلِ المُحِيطِ بِهِ: عِشْرُونَ.",
  "lp.03": "وَهَذَا شَكْلُ U: قُطِعَ الجُزْءُ مِنَ الوَسَطِ لَا مِنَ الرُّكْنِ.",
  "lp.04": "مُحِيطُهُ أَرْبَعَةٌ وَعِشْرُونَ، لَا عِشْرُونَ: القَاعِدَةُ لِلْقَطْعِ مِنَ الرُّكْنِ فَقَطْ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} شَكْلَ L، {وَلَوِّنْ|وَلَوِّنِي} كُلَّ جُزْءٍ بِلَوْنٍ مِنْ أَقْلَامِ التَّلْوِينِ، {وَاحْسُبْ|وَاحْسُبِي} مَسَاحَتَهُ بِالتَّقْسِيمِ ثُمَّ بِالإِتْمَامِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: حَدِيقَةُ القَصْرِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الأَشْكَالِ المُرَكَّبَةِ.",
  "pr.comp": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ هَذِهِ الأَرْضِ؟",
  "pr.compP": "بَعْضُ الأَطْوَالِ غَيْرُ مَكْتُوبٍ. كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذِهِ الأَرْضِ؟",
  "ch.find": "حَسَبَتْ فَوْضَى مَسَاحَةَ جُزْءٍ وَاحِدٍ فَقَطْ! كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ الأَرْضِ كُلِّهَا؟",
  "ch.after": [
   "chaos",
   "آه! نَسِيتُ الجُزْءَ الثَّانِيَ."
  ],
  "ch.right": "{لَوِّنْ|لَوِّنِي} كُلَّ جُزْءٍ بِلَوْنٍ، ثُمَّ {اِجْمَعِ|اِجْمَعِي} المَسَاحَاتِ.",
  "ch.wrong": [
   "chaos",
   "جُزْءٌ وَاحِدٌ يَكْفِي."
  ],
  "ms.1": "قَسَّمْنَا الأَرْضَ مَرَّةً، وَمَرَّةً أَكْمَلْنَاهَا مُسْتَطِيلًا وَطَرَحْنَا النَّاقِصَ. لِمَاذَا الجَوَابُ وَاحِدٌ؟",
  "ms.1a": "لِأَنَّهَا الأَرْضُ نَفْسُهَا بِمُرَبَّعَاتِهَا.",
  "ms.1b": "لِأَنَّ الطَّرْحَ وَالجَمْعَ عَمَلِيَّةٌ وَاحِدَةٌ.",
  "ms.1c": "لِأَنَّ كُلَّ أَرْضٍ مَسَاحَتُهَا عِشْرُونَ مُرَبَّعًا.",
  "ms.2": "لِمَاذَا مُحِيطُ شَكْلِ L يُسَاوِي مُحِيطَ المُسْتَطِيلِ المُحِيطِ بِهِ؟",
  "ms.2a": "لِأَنَّ الضِّلْعَيْنِ الدَّاخِلِيَّيْنِ يُعَوِّضَانِ الرُّكْنَ.",
  "ms.2b": "لِأَنَّ مَسَاحَةَ الشَّكْلَيْنِ مُتَسَاوِيَةٌ دَائِمًا.",
  "ms.2c": "لِأَنَّ كُلَّ شَكْلٍ مُحِيطُهُ مِثْلُ مُسْتَطِيلِهِ.",
  "ms.recall": "نُقَسِّمُ الشَّكْلَ مُسْتَطِيلَاتٍ وَنَجْمَعُ، أَوْ نُتِمُّهُ مُسْتَطِيلًا وَنَطْرَحُ النَّاقِصَ.",
  "ms.recall2": "نَمْشِي عَلَى كُلِّ الأَضْلَاعِ، وَنَسْتَنْتِجُ الطُّولَ غَيْرَ المَكْتُوبِ مِنَ المُقَابِلِ لَهُ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَحْسُبُ|صِرْتِ تَحْسُبِينَ} الأَشْكَالَ المُرَكَّبَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "زَرَعْنَا حَدِيقَةَ القَصْرِ جُزْءًا جُزْءًا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {صَمِّمْ|صَمِّمِي} عَلَى وَرَقِ المُرَبَّعَاتِ أَرْضًا عَلَى شَكْلِ T، {وَاحْسُبْ|وَاحْسُبِي} مَسَاحَتَهَا وَمُحِيطَهَا."
  ]
 },
