  ],
  "ask": "bag.ask",
  "adult": "عودا مثلّجات مثبّتان بمشبك عند طرفيهما.",
  "screenPath": "على الشاشة يفتح الطفل باباً ويحرّك عودين ويدير ضلعاً حول الرأس، ويسمّي الزاوية؛ والعودان الحقيقيان في مسار «معي»."
 },
 "labels": {
  "bagSticks": "عُودَانِ وَمِشْبَكٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُودَانِ وَمِشْبَكٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذَا بَابٌ مُغْلَقٌ. {اِلْمِسْهُ|اِلْمِسِيهِ} لِيَنْفَتِحَ، ثُمَّ {اِلْمِسْهُ|اِلْمِسِيهِ} مِنْ جَدِيدٍ.",
  "hook.02": "مَا الَّذِي تَغَيَّرَ؟ طُولُ البَابِ لَمْ يَتَغَيَّرْ، وَتَغَيَّرَ انْفِتَاحُهُ. وَهَذَا الاِنْفِتَاحُ اسْمُهُ: زَاوِيَةٌ.",
  "mat.01": "{ثَبِّتِ|ثَبِّتِي} العُودَيْنِ بِالمِشْبَكِ عِنْدَ طَرَفِهِمَا، ثُمَّ {اِفْتَحْهُمَا|اِفْتَحِيهِمَا} وَ{أَغْلِقْهُمَا|أَغْلِقِيهِمَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "st.01": "عُودَانِ ثَبَّتْنَاهُمَا عِنْدَ طَرَفِهِمَا. {اِلْمِسْهُمَا|اِلْمِسِيهِمَا} لِنَفْتَحَهُمَا وَنُغْلِقَهُمَا.",
  "st.02": "نُقْطَةُ التَّثْبِيتِ اسْمُهَا: الرَّأْسُ.",
  "st.03": "وَالعُودَانِ هُمَا الضِّلْعَانِ، يَخْرُجَانِ مِنَ الرَّأْسِ.",
  "st.04": "عَرَفْنَا الرَّأْسَ فِي الأَشْكَالِ: عِنْدَ كُلِّ رَأْسٍ يَلْتَقِي ضِلْعَانِ، وَالاِنْفِتَاحُ بَيْنَهُمَا اسْمُهُ زَاوِيَةٌ.",
  "tn.01": "الزَّاوِيَةُ دَوَرَانٌ أَيْضًا. {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنُدِيرَ الضِّلْعَ حَوْلَ الرَّأْسِ.",
  "tn.02": "دَارَ الضِّلْعُ رُبْعَ دَوْرَةٍ: مِثْلَ رُكْنِ الوَرَقَةِ. {اِلْمِسْ|اِلْمِسِي} مِنْ جَدِيدٍ.",
  "tn.03": "وَالآنَ نِصْفُ دَوْرَةٍ: صَارَ الضِّلْعَانِ عَلَى خَطٍّ وَاحِدٍ. {اِلْمِسْ|اِلْمِسِي} مِنْ جَدِيدٍ.",
  "tn.04": "وَهَذِهِ دَوْرَةٌ كَامِلَةٌ: عَادَ الضِّلْعُ إِلَى مَكَانِهِ. الزَّاوِيَةُ مِقْدَارُ الدَّوَرَانِ مِنْ ضِلْعٍ إِلَى الضِّلْعِ الآخَرِ.",
  "nm.01": "لِلزَّاوِيَةِ اسْمٌ مِنْ ثَلَاثَةِ أَحْرُفٍ. {اِلْمِسِ|اِلْمِسِي} الرَّأْسَ.",
  "nm.02": "حَرْفُ الرَّأْسِ يَكُونُ فِي وَسَطِ الاِسْمِ دَائِمًا، وَنَبْدَأُ بِأَيِّ ضِلْعٍ نَشَاءُ.",
  "game.01": "لُعْبَةُ: بَابُ القَلْعَةِ!",
  "gm.q": "{أَدِرِ|أَدِيرِي} البَابَ بِالزِّرَّيْنِ حَتَّى يَنْفَتِحَ مِثْلَ الزَّاوِيَةِ الصَّغِيرَةِ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الزَّوَايَا.",
  "pr.v": "{اِلْمِسْ|اِلْمِسِي} رَأْسَ الزَّاوِيَةِ.",
  "pr.s": "{اِلْمِسْ|اِلْمِسِي} ضِلْعًا مِنْ ضِلْعَيِ الزَّاوِيَةِ.",
  "pr.big": "أَيُّ الزَّاوِيَتَيْنِ أَكْبَرُ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.small": "أَيُّ الزَّاوِيَتَيْنِ أَصْغَرُ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.name": "مَا اسْمُ هَذِهِ الزَّاوِيَةِ؟",
  "pr.turn": "{اِلْمِسِ|اِلْمِسِي} السَّاعَةَ لِيَدُورَ العَقْرَبُ. كَمْ دَارَ؟",
  "ch.find": "تَقُولُ فَوْضَى: الزَّاوِيَةُ ذَاتُ الضِّلْعَيْنِ الطَّوِيلَيْنِ هِيَ الأَكْبَرُ! أَيُّ الزَّاوِيَتَيْنِ أَكْبَرُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! الزَّاوِيَةُ انْفِتَاحٌ، لَا طُولُ ضِلْعَيْنِ."
  ],
  "ch.right": "نُقَارِنُ الزَّوَايَا بِانْفِتَاحِهَا.",
  "ch.wrong": [
   "chaos",
   "نُقَارِنُ الزَّوَايَا بِطُولِ أَضْلَاعِهَا."
  ],
  "ms.3": "لِمَاذَا الزَّاوِيَةُ الأُولَى أَكْبَرُ مَعَ أَنَّ ضِلْعَيْهَا قَصِيرَانِ؟",
  "ms.3a": "لِأَنَّ انْفِتَاحَهَا أَكْبَرُ، وَالطُّولُ لَا يُغَيِّرُهَا.",
  "ms.3b": "لِأَنَّ الضِّلْعَ القَصِيرَ يَجْعَلُ الزَّاوِيَةَ أَكْبَرَ فِي كُلِّ رَسْمٍ.",
  "ms.3c": "لِأَنَّهَا مَرْسُومَةٌ عَلَى يَمِينِ الصَّفْحَةِ.",
  "ms.4": "لِمَاذَا نَقُولُ: الزَّاوِيَةُ دَوَرَانٌ؟",
  "ms.4a": "لِأَنَّ الضِّلْعَ يَدُورُ حَوْلَ الرَّأْسِ مِنْ مَكَانٍ إِلَى آخَرَ.",
  "ms.4b": "لِأَنَّ كُلَّ زَاوِيَةٍ دَائِرَةٌ كَامِلَةٌ مَهْمَا كَانَ انْفِتَاحُهَا.",
  "ms.4c": "لِأَنَّ ضِلْعَيِ الزَّاوِيَةِ يَطُولَانِ كُلَّمَا دَارَا.",
  "ms.5": "لِمَاذَا نَكْتُبُ حَرْفَ الرَّأْسِ فِي وَسَطِ اسْمِ الزَّاوِيَةِ؟",
  "ms.5a": "لِأَنَّ الرَّأْسَ بَيْنَ الضِّلْعَيْنِ.",
  "ms.5b": "لِأَنَّ حَرْفَ الرَّأْسِ أَكْبَرُ الحُرُوفِ فِي الاِسْمِ.",
  "ms.5c": "لِأَنَّ الحُرُوفَ تُكْتَبُ دَائِمًا بِتَرْتِيبِ الأَبْجَدِيَّةِ.",
  "ms.recall": "لِلزَّاوِيَةِ رَأْسٌ وَضِلْعَانِ، وَهِيَ الاِنْفِتَاحُ بَيْنَهُمَا، لَا طُولُهُمَا.",
  "ms.recall2": "الزَّاوِيَةُ دَوَرَانٌ: رُبْعُ دَوْرَةٍ، وَنِصْفُ دَوْرَةٍ، وَدَوْرَةٌ كَامِلَةٌ.",
  "ms.recall3": "نُسَمِّي الزَّاوِيَةَ بِثَلَاثَةِ أَحْرُفٍ، وَحَرْفُ الرَّأْسِ فِي الوَسَطِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} الزَّاوِيَةَ: رَأْسَهَا وَضِلْعَيْهَا وَاسْمَهَا. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَنَعْنَا فِي حَيِّ الزَّوَايَا أَوَّلَ بَابٍ يَنْفَتِحُ!",
  "wrap.home": [
   "chaos",
