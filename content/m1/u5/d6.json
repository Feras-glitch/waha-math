 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَرَزَاتٌ كَبِيرَةٌ بِلَوْنَيْنِ وَخَيْطٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "صَنَعْتُ الأَنْمَاطَ {مَعَكَ|مَعَكِ}! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَضَعُ أَنَا الحَجَرَ الخَامِسَ فِي مَكَانِهِ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "mat.01": "{اِصْنَعْ|اِصْنَعِي} نَمَطًا: {ضَعْ|ضَعِي} فِي الخَيْطِ خَرَزَةً بَعْدَ خَرَزَةٍ، وَ{اُطْلُبْ|اُطْلُبِي} مِنْ أَحَدِ {أَهْلِكَ|أَهْلِكِ} أَنْ يُكْمِلَهُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "النَّمَطُ فِيهِ وَحْدَةٌ تَتَكَرَّرُ بِالتَّرْتِيبِ نَفْسِهِ، مِنْ شَيْئَيْنِ أَوْ مِنْ ثَلَاثَةٍ.",
  "rv.02": "وَنَعُدُّ بِالقَفْزِ: بِالاِثْنَيْنِ، وَبِالخَمْسَةِ، وَبِالعَشَرَةِ.",
  "rv.03": "وَعَلَى شَبَكَةِ المِئَةِ كُلُّ صَفٍّ عَشَرَةُ أَعْدَادٍ، وَفِي آخِرِهِ عَشَرَةٌ جَدِيدَةٌ.",
  "gm.intro": "لُعْبَةُ {سَاحِرِ|سَاحِرَةِ} الأَنْمَاطِ! {أَكْمِلْ|أَكْمِلِي}، ثُمَّ {اِصْنَعْ|اِصْنَعِي}، ثُمَّ {اِقْفِزْ|اِقْفِزِي}.",
  "gm.1": "{أَكْمِلِ|أَكْمِلِي} النَّمَطَ بِثَلَاثَةِ أَشْكَالٍ.",
  "gm.2": "{اِصْنَعْ|اِصْنَعِي} نَمَطًا وَحْدَتُهُ المُتَكَرِّرَةُ مِنْ ثَلَاثَةِ أَشْكَالٍ.",
  "gm.3": "{اِقْفِزْ|اِقْفِزِي} بِالخَمْسَةِ مِنَ البَلَاطَةِ المُلَوَّنَةِ إِلَى البَلَاطَةِ المُحَاطَةِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ أَسْئِلَةِ الوَاحَةِ.",
  "pr.1": "فِي هَذَا الصَّفِّ شَكْلٌ خَطَأٌ يَكْسِرُ النَّمَطَ. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.2": "{اِلْمِسْ|اِلْمِسِي} عَلَى الشَّبَكَةِ العَدَدَ الَّذِي {تَسْمَعُهُ|تَسْمَعِينَهُ}:",
  "pr.3": "كَمْ مُكَعَّبًا هُنَا؟ فِي كُلِّ مَجْمُوعَةٍ عَشَرَةٌ، فَ{عُدَّ|عُدِّي} بِالعَشَرَةِ.",
  "pr.4": "بَلَاطَةٌ مَخْفِيَّةٌ! مَا عَدَدُهَا؟",
  "pr.5": "مَا العَدَدُ التَّالِي فِي القَفْزِ بِالخَمْسَةِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.1": "مَا الشَّكْلُ التَّالِي؟ {ضَعْهُ|ضَعِيهِ} فِي مَكَانِهِ.",
  "ts.2": "فِي هَذِهِ السِّلْسِلَةِ خَرَزَةٌ خَطَأٌ تَكْسِرُ النَّمَطَ. {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "ts.4": "{أَكْمِلِ|أَكْمِلِي} النَّمَطَ بِشَكْلَيْنِ.",
  "ts.5": "{أَحِطِ|أَحِيطِي} الوَحْدَةَ المُتَكَرِّرَةَ بِحَلْقَةٍ: {اِلْمِسْ|اِلْمِسِي} آخِرَ خَرَزَةٍ فِيهَا.",
  "ts.7": "{اِصْنَعْ|اِصْنَعِي} نَمَطًا {تَخْتَارُهُ|تَخْتَارِينَهُ}: {ضَعْ|ضَعِي} خَرَزَةً فِي كُلِّ مَكَانٍ.",
  "ts.9": "{اِقْفِزْ|اِقْفِزِي} بِالخَمْسَةِ مِنَ البَلَاطَةِ المُلَوَّنَةِ إِلَى البَلَاطَةِ المُحَاطَةِ.",
  "ts.10": "مَا العَدَدُ الَّذِي بَعْدَ العَدَدِ المُلَوَّنِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.11": "{اِلْمِسْ|اِلْمِسِي} عَلَى الشَّبَكَةِ العَدَدَ الَّذِي {تَسْمَعُهُ|تَسْمَعِينَهُ}:",
  "ts.12": "{اِقْفِزْ|اِقْفِزِي} بِالعَشَرَةِ مِنَ البَلَاطَةِ المُلَوَّنَةِ إِلَى البَلَاطَةِ المُحَاطَةِ.",
  "ts.rem": "نَصْنَعُ مَعَ الكِبَارِ أَنْمَاطًا بِالخَرَزِ وَبِالتَّصْفِيقِ، وَنَعُدُّ الأَصَابِعَ بِالخَمْسَةِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَضَعُ الحَجَرَ الخَامِسَ فِي مَكَانِهِ."
  ],
  "ts.win1": "{أَنْتَ سَاحِرُ الأَنْمَاطِ|أَنْتِ سَاحِرَةُ الأَنْمَاطِ}!",
  "ts.win2": "جَرَى المَاءُ فِي جَدْوَلِ «سُوقِ الخَرَزِ»، وَاخْضَرَّتْ نَخْلَتَانِ!",
  "wrap.01": "جَرَى المَاءُ فِي خَمْسَةِ جَدَاوِلَ مِنْ جَدَاوِلِ الوَاحَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِصْنَعْ|اِصْنَعِي} نَمَطًا مِنْ أَشْيَاءِ البَيْتِ، وَ{اُطْلُبْ|اُطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} أَنْ يَجِدُوا وَحْدَتَهُ المُتَكَرِّرَةَ."
  ],
  "ts.1b": "{أَكْمِلِ|أَكْمِلِي} السِّلْسِلَةَ بِخَرَزَتَيْنِ.",
  "ts.2s": "فِي هَذَا الصَّفِّ شَكْلٌ خَطَأٌ يَكْسِرُ النَّمَطَ. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.5s": "{أَحِطِ|أَحِيطِي} الوَحْدَةَ المُتَكَرِّرَةَ بِحَلْقَةٍ: {اِلْمِسْ|اِلْمِسِي} آخِرَ شَكْلٍ فِيهَا.",
  "gm.2b": "{اِصْنَعْ|اِصْنَعِي} نَمَطًا وَحْدَتُهُ المُتَكَرِّرَةُ مِنْ ثَلَاثِ خَرَزَاتٍ."
 },
