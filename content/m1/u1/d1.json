  "ask": "bag.ask",
  "adult": "طبق، وبلاطة أو منديل مربع.",
  "screenPath": "على الشاشة يتتبّع الحافة بإصبعه، ويُوسم الدرس «مدخل» حتى يلمس الطبق والبلاطة الحقيقيين."
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} طَبَقٌ وَبَلَاطَةٌ مُرَبَّعَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "هِيهِي! صَنَعْتُ عَرَبَتَيْنِ، وَسَأَدْفَعُهُمَا مَعًا!"
  ],
  "hook.02": "أَيُّ عَرَبَةٍ سَتَسِيرُ بِسُهُولَةٍ؟ {تَوَقَّعْ|تَوَقَّعِي}، ثُمَّ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "hook.03a": "تَوَقُّعٌ جَمِيلٌ! هَيَّا نُشَاهِدُ.",
  "hook.03b": "هَيَّا نُشَاهِدُ مَا يَحْدُثُ.",
  "hook.04": "العَرَبَةُ ذَاتُ العَجَلَاتِ الدَّائِرِيَّةِ سَارَتْ بِسُهُولَةٍ، وَالأُخْرَى تَعَثَّرَتْ.",
  "hook.05": [
   "chaos",
   "أُوه! لِمَاذَا تَتَعَثَّرُ عَرَبَتِي؟"
  ],
  "hook.06": "هَذَا مَا سَنَكْتَشِفُهُ الآنَ بِأَصَابِعِنَا.",
  "mat.01": "{أَمْسِكِ|أَمْسِكِي} الطَّبَقَ، وَ{مَرِّرْ|مَرِّرِي} {إِصْبَعَكَ|إِصْبَعَكِ} عَلَى حَافَّتِهِ دَوْرَةً كَامِلَةً، ثُمَّ عَلَى حَافَّةِ البَلَاطَةِ. وَحِينَ {تَنْتَهِي|تَنْتَهِينَ}، {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "أَيْنَ تَوَقَّفَ {إِصْبَعُكَ|إِصْبَعُكِ}؟ هَيَّا نَرَى عَلَى الشَّاشَةِ أَيْضًا.",
  "exp.01": "{مَرِّرْ إِصْبَعَكَ|مَرِّرِي إِصْبَعَكِ} عَلَى حَافَّةِ كُلِّ شَكْلٍ، دَوْرَةً كَامِلَةً. أَيْنَ يَتَوَقَّفُ الإِصْبَعُ؟",
  "exp.03": "عَلَى الدَّائِرَةِ مَرَّ الإِصْبَعُ بِسُهُولَةٍ: حَافَّتُهَا مُنْحَنِيَةٌ، وَلَا رُؤُوسَ لَهَا.",
  "exp.04": "وَعَلَى المُرَبَّعِ تَوَقَّفَ أَرْبَعَ مَرَّاتٍ. النُّقْطَةُ الَّتِي يَتَوَقَّفُ عِنْدَهَا الإِصْبَعُ اسْمُهَا: رَأْسٌ. لِلْمُرَبَّعِ أَرْبَعَةُ رُؤُوسٍ، وَحَوَافُّهُ مُسْتَقِيمَةٌ.",
  "exp.05": [
   "chaos",
   "آه! لِذَلِكَ تَعَثَّرَتْ عَرَبَتِي عِنْدَ الرُّؤُوسِ!"
  ],
  "wk.01": "هَذَا مُرَبَّعٌ. نَعُدُّ رُؤُوسَهُ، وَنَبْدَأُ مِنَ الرَّأْسِ الأَعْلَى عَلَى اليَمِينِ.",
  "wk.02": "أَرْبَعَةُ رُؤُوسٍ، وَحَوَافُّهُ مُسْتَقِيمَةٌ.",
  "wk.03": "هَلْ مَا زَالَ مُرَبَّعًا؟ هَيَّا نَعُدُّ: {اِلْمَسْ|اِلْمَسِي} كُلَّ رَأْسٍ.",
  "wk.05": "مَا زَالَ لَهُ أَرْبَعَةُ رُؤُوسٍ، وَحَوَافُّهُ مُسْتَقِيمَةٌ. فَهُوَ مَا زَالَ مُرَبَّعًا!",
  "wk.06": "وَالمُرَبَّعُ يَكُونُ صَغِيرًا أَوْ كَبِيرًا، مَائِلًا أَوْ مُسْتَقِيمًا، وَبِأَيِّ لَوْنٍ.",
  "wk.07": "وَالدَّائِرَةُ؟ حَافَّتُهَا مُنْحَنِيَةٌ كُلُّهَا، وَلَا رُؤُوسَ لَهَا، مَهْمَا أَدَرْنَاهَا.",
  "pr.intro": "إِلَى أَيِّ سَلَّةٍ يَذْهَبُ كُلُّ شَكْلٍ؟ سَلَّةُ الدَّوَائِرِ، وَسَلَّةُ المُرَبَّعَاتِ، وَسَلَّةُ «غَيْرُ ذَلِكَ». {اِلْمَسِ|اِلْمَسِي} السَّلَّةَ، {أَوِ اسْحَبِ|أَوِ اسْحَبِي} الشَّكْلَ إِلَيْهَا.",
  "pr.paint": "{لَوِّنِ|لَوِّنِي} الدَّوَائِرَ بِالمَرْجَانِيِّ، وَالمُرَبَّعَاتِ بِالأَخْضَرِ المُزْرَقِّ: {اِخْتَرِ|اِخْتَارِي} اللَّوْنَ، ثُمَّ {اِلْمَسِ|اِلْمَسِي} الشَّكْلَ.",
  "pr.which": "أَيُّ هَذِهِ الأَشْيَاءِ دَوَائِرُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا} كُلَّهَا، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "pr.odd": "ثَلَاثَةٌ مِنْ هَذِهِ دَوَائِرُ، وَوَاحِدٌ مُخْتَلِفٌ. {اِلْمَسِ|اِلْمَسِي} المُخْتَلِفَ.",
  "game.01": "لُعْبَةُ سَلَّةِ الأَشْكَالِ: سَلَّتَانِ فَقَطْ، لِلدَّوَائِرِ وَلِلْمُرَبَّعَاتِ. {خُذْ وَقْتَكَ|خُذِي وَقْتَكِ}.",
  "why.sqRot": "أَرْبَعَةُ رُؤُوسٍ وَحَوَافُّ مُسْتَقِيمَةٌ، حَتَّى وَهُوَ مَائِلٌ.",
  "why.sq": "أَرْبَعَةُ رُؤُوسٍ وَحَوَافُّ مُسْتَقِيمَةٌ.",
  "why.c": "حَافَّتُهُ مُنْحَنِيَةٌ، وَلَا رُؤُوسَ لَهُ.",
  "why.oval": "مَمْطُوطٌ: طَوِيلٌ مِنْ جِهَةٍ وَقَصِيرٌ مِنْ جِهَةٍ، فَلَيْسَ دَائِرَةً.",
  "why.other": "لَيْسَ دَائِرَةً وَلَا مُرَبَّعًا.",
  "ch.after": "مَا زَالَ لَهُ أَرْبَعَةُ رُؤُوسٍ. مَكَانُهُ سَلَّةُ المُرَبَّعَاتِ.",
  "ch.right": "المُرَبَّعُ المَائِلُ مَا زَالَ مُرَبَّعًا: لَهُ أَرْبَعَةُ رُؤُوسٍ.",
  "ch.wrong": [
   "chaos",
   "إِذَا مَالَ صَارَ شَكْلًا آخَرَ."
  ],
  "ms.recall": "المُرَبَّعُ المَائِلُ مَا زَالَ مُرَبَّعًا: أَرْبَعَةُ رُؤُوسٍ. وَالدَّائِرَةُ حَافَّتُهَا مُنْحَنِيَةٌ، بِلَا رُؤُوسٍ.",
  "ms.ok": "رَائِعٌ! {أَتْقَنْتَ|أَتْقَنْتِ} الدَّائِرَةَ وَالمُرَبَّعَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَارَ فِي الوَاحَةِ نَبْعٌ دَائِرِيٌّ، وَبَلَاطٌ مُرَبَّعٌ حَوْلَهُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} مَعَ الكِبَارِ عَنْ شَيْءٍ دَائِرِيٍّ وَشَيْءٍ مُرَبَّعٍ، وَ{مَرِّرْ|مَرِّرِي} {إِصْبَعَكَ|إِصْبَعَكِ} عَلَى حَافَّتَيْهِمَا."
  ]
 },
