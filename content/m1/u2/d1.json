 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} كُرَةٌ، وَمُكَعَّبٌ أَوْ نَرْدٌ، وَكِيسُ قُمَاشٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فَوْضَى خَبَّأَتْ كُرَةً وَمُكَعَّبًا فِي كِيسَيْنِ. {اِلْمَسْ|اِلْمَسِي} كِيسًا، فَتَدْخُلُ يَدُنَا دُونَ أَنْ نَنْظُرَ.",
  "feel.sphere": "أَصَابِعِي تَشْعُرُ بِسَطْحٍ مُنْحَنٍ نَاعِمٍ فِي كُلِّ مَكَانٍ، بِلَا رُؤُوسٍ.",
  "feel.cube": "أَصَابِعِي تَشْعُرُ بِسُطُوحٍ مُسَطَّحَةٍ، وَبِرُؤُوسٍ مُدَبَّبَةٍ.",
  "hook.ask": "مَا الَّذِي فِي هَذَا الكِيسِ؟",
  "is.sphere": "إِنَّهَا الكُرَةُ!",
  "is.cube": "إِنَّهُ المُكَعَّبُ!",
  "hook.03": "عَرَفْنَاهُمَا بِأَصَابِعِنَا: سَطْحٌ مُنْحَنٍ، أَوْ سُطُوحٌ مُسَطَّحَةٌ وَرُؤُوسٌ.",
  "mat.01": "خَبِّئُوا الكُرَةَ وَالنَّرْدَ فِي الكِيسِ. {أَدْخِلْ يَدَكَ|أَدْخِلِي يَدَكِ} دُونَ أَنْ {تَنْظُرَ|تَنْظُرِي}، وَ{أَخْرِجِ|أَخْرِجِي} الكُرَةَ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "كَيْفَ {عَرَفْتَهَا|عَرَفْتِهَا} {بِيَدِكَ|بِيَدِكِ}؟ هَيَّا نُجَرِّبُ عَلَى الشَّاشَةِ.",
  "push.sphere": "سَنَدْفَعُ الكُرَةَ. هَلْ تَتَدَحْرَجُ، أَمْ تَبْقَى مَكَانَهَا؟ {تَوَقَّعْ|تَوَقَّعِي}.",
  "push.sphere.after": "تَدَحْرَجَتِ الكُرَةُ بَعِيدًا! وَتَتَدَحْرَجُ فِي كُلِّ اتِّجَاهٍ.",
  "push.cube": "وَالآنَ المُكَعَّبُ. هَلْ يَتَدَحْرَجُ مِثْلَ الكُرَةِ، أَمْ يَقِفُ؟ {تَوَقَّعْ|تَوَقَّعِي}.",
  "push.cube.after": "انْقَلَبَ المُكَعَّبُ مَرَّةً وَاحِدَةً، ثُمَّ وَقَفَ ثَابِتًا. لَا يَتَدَحْرَجُ.",
  "pose.01": "وَالمُكَعَّبُ عَلَى وَجْهٍ، أَوْ عَلَى أَحَدِ رُؤُوسِهِ، يَبْقَى مُكَعَّبًا.",
  "pose.02": "الكُرَةُ وَالمُكَعَّبُ مُجَسَّمَانِ: المُجَسَّمُ يَمْلَأُ الكَفَّ، وَلَهُ سُمْكٌ.",
  "pose.03": "وَهَذِهِ صُوَرُ مُجَسَّمَاتٍ؛ المُجَسَّمُ الحَقِيقِيُّ نُمْسِكُهُ بِأَيْدِينَا.",
  "wk.01": "هَذَا مُكَعَّبٌ: وُجُوهُهُ مُسَطَّحَةٌ، وَيَقِفُ ثَابِتًا.",
  "wk.02": "هَلْ مَا زَالَ مُكَعَّبًا؟",
  "wk.03": "مَا زَالَ يَمْلَأُ الكَفَّ، وَإِذَا أَرْسَلْنَاهُ وَقَفَ عَلَى وَجْهٍ: مَا زَالَ مُكَعَّبًا!",
  "wk.04": "المُرَبَّعُ الوَرَقِيُّ رَقِيقٌ بِلَا سُمْكٍ. أَمَّا المُكَعَّبُ فَيَمْلَأُ الكَفَّ.",
  "wk.05": "وَالدَّائِرَةُ الوَرَقِيَّةُ رَقِيقَةٌ بِلَا سُمْكٍ. أَمَّا الكُرَةُ فَتَمْلَأُ الكَفَّ.",
  "wk.06": "وَالبُرْتُقَالَةُ شَبِيهَةٌ بِالكُرَةِ: تَتَدَحْرَجُ، لَكِنَّهَا لَيْسَتْ كُرَةً تَامَّةً.",
  "pr.intro": "سِلَالُنَا: لِلْمُكَعَّبَاتِ، وَلِلْكُرَاتِ، وَ«غَيْرُ ذَلِكَ». هَيَّا نَتَمَرَّنُ.",
  "pr.rolls": "أَيُّ هَذِهِ الأَشْيَاءِ تَتَدَحْرَجُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا} كُلَّهَا، ثُمَّ «تَمَّ».",
  "pr.odd": "ثَلَاثَةٌ مِنْ هَذِهِ شَبِيهَةٌ بِالكُرَةِ، وَوَاحِدٌ مُخْتَلِفٌ. {اِلْمَسِ|اِلْمَسِي} المُخْتَلِفَ.",
  "game.01": "لُعْبَةُ صُنْدُوقِ اللَّمْسِ: {اِسْمَعِ|اِسْمَعِي} مَا يَقُولُهُ الشَّيْءُ عَنْ نَفْسِهِ، وَ{اِخْتَرْهُ|اِخْتَارِيهِ}.",
  "fb.1": "أَتَدَحْرَجُ فِي كُلِّ اتِّجَاهٍ، وَلَيْسَ لِي رُؤُوسٌ. مَنْ أَنَا؟",
  "fb.2": "أَقِفُ ثَابِتًا، وَوُجُوهِي كُلُّهَا مُسَطَّحَةٌ. مَنْ أَنَا؟",
  "fb.3": "إِذَا {دَفَعْتَنِي|دَفَعْتِنِي} انْقَلَبْتُ مَرَّةً وَوَقَفْتُ. مَنْ أَنَا؟",
  "why.cube": "وُجُوهُهُ مُسَطَّحَةٌ، وَيَقِفُ ثَابِتًا.",
  "why.cubeTurned": "وُجُوهُهُ مُسَطَّحَةٌ، حَتَّى وَهُوَ مَائِلٌ.",
  "why.sphere": "سَطْحُهُ مُنْحَنٍ كُلُّهُ، وَيَتَدَحْرَجُ.",
  "why.flat": "رَقِيقٌ بِلَا سُمْكٍ: لَيْسَ مُجَسَّمًا.",
  "why.box": "لَهُ وُجُوهٌ مُسَطَّحَةٌ، لَكِنَّهَا لَيْسَتْ كُلُّهَا مُرَبَّعَاتٍ: لَيْسَ مُكَعَّبًا.",
  "why.other": "لَيْسَ مُكَعَّبًا وَلَا كُرَةً.",
  "ch.after": "صَارَ خَطًّا رَقِيقًا: مُرَبَّعٌ مِنْ وَرَقٍ. مَكَانُهُ «غَيْرُ ذَلِكَ».",
  "ch.right": "المُرَبَّعُ الوَرَقِيُّ رَقِيقٌ بِلَا سُمْكٍ، وَالمُكَعَّبُ يَمْلَأُ الكَفَّ.",
  "ch.wrong": [
   "chaos",
   "المُرَبَّعُ وَالمُكَعَّبُ شَيْءٌ وَاحِدٌ."
  ],
  "ms.recall6": "المُكَعَّبُ وُجُوهُهُ مُسَطَّحَةٌ، مَهْمَا أَدَرْنَاهُ. وَالكُرَةُ سَطْحُهَا مُنْحَنٍ. وَالوَرَقُ رَقِيقٌ بِلَا سُمْكٍ.",
  "ms.recall9": "مَا لَهُ سَطْحٌ مُنْحَنٍ يَتَدَحْرَجُ، وَمَا لَهُ وُجُوهٌ مُسَطَّحَةٌ يَقِفُ.",
  "ms.ok": "رَائِعٌ! {أَتْقَنْتَ|أَتْقَنْتِ} المُكَعَّبَ وَالكُرَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "فِي الوَاحَةِ الآنَ بُرْجٌ مِنَ المُكَعَّبَاتِ، وَكُرَةٌ تَتَدَحْرَجُ!",
  "wrap.home": [
