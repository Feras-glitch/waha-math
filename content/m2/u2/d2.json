  "ask": "bag.ask",
  "adult": "مسطرة وورق مربعات وقلم مبريّ.",
  "screenPath": "على الشاشة يمدّ الطفل خطّي السكة، ويقيس المسافة بين متوازيين بثلاثة قياسات، ويرسم موازياً على الشبكة؛ والرسم على حافتي المسطرة في مسار «معي»."
 },
 "labels": {
  "bagRuler": "مِسْطَرَةٌ",
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَوَرَقُ مُرَبَّعَاتٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذَانِ خَطَّانِ مِثْلُ قُضْبَانِ سِكَّةِ القِطَارِ. هَلْ يَلْتَقِيَانِ لَوْ مَدَدْنَاهُمَا؟ {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ.",
  "sym.01": "هَذِهِ القِطْعَةُ أَلِف بَاء، وَهَذِهِ جِيم دَال، وَهُمَا مُتَوَازِيَتَانِ.",
  "sym.02": "نَكْتُبُ التَّوَازِيَ بِرَمْزٍ: خَطَّانِ صَغِيرَانِ مُتَوَازِيَانِ بَيْنَ الاِسْمَيْنِ.",
  "sym.03": "وَنَقْرَؤُهُ: أَلِف بَاء يُوَازِي جِيم دَال.",
  "pr.sym": "أَيُّ رَسْمٍ يُطَابِقُ هَذَا الرَّمْزَ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "hook.02": "لَا يَلْتَقِيَانِ مَهْمَا امْتَدَّا. نَقُولُ: مُسْتَقِيمَانِ مُتَوَازِيَانِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ خَطَّيْنِ عَلَى حَافَّتَيِ المِسْطَرَةِ، وَ{اُنْظُرْ|اُنْظُرِي}: هَلْ يَقْتَرِبُ أَحَدُهُمَا مِنَ الآخَرِ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "pl.intro": "ثَلَاثَةُ أَزْوَاجٍ مِنَ المُتَوَازِيَاتِ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "pl.1": "مُتَوَازِيَانِ أُفُقِيَّانِ.",
  "pl.2": "مُتَوَازِيَانِ رَأْسِيَّانِ.",
  "pl.3": "وَمُتَوَازِيَانِ مَائِلَانِ. المُتَوَازِيَانِ لَيْسَا أُفُقِيَّيْنِ دَائِمًا.",
  "ds.01": "كَمِ المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ؟ هَذِهِ ثَلَاثَةُ قِيَاسَاتٍ. {اِلْمِسْ|اِلْمِسِي} كُلَّ قِيَاسٍ.",
  "ds.02": "القِيَاسُ المَائِلُ أَطْوَلُ، وَيَتَغَيَّرُ مَعَ المَيْلِ. المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ نَقِيسُهَا عَلَى الخَطِّ الَّذِي يَصْنَعُ مَعَهُمَا رُكْنًا مِثْلَ رُكْنِ المُرَبَّعِ، وَهِيَ ثَابِتَةٌ فِي كُلِّ مَوْضِعٍ.",
  "sy.intro": "كَيْفَ نَقُولُ فِي الرَّسْمِ إِنَّهُمَا مُتَوَازِيَانِ؟ {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "sy.1": "هَذَانِ مُتَوَازِيَانِ بِلَا عَلَامَةٍ.",
  "sy.2": "وَهُنَا سَهْمٌ صَغِيرٌ عَلَى كُلِّ مُسْتَقِيمٍ: هَذِهِ عَلَامَةُ التَّوَازِي.",
  "game.01": "لُعْبَةُ: رَسَّامُ المُتَوَازِيَاتِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُتَوَازِيَاتِ.",
  "pr.1": "فِي أَيِّ رَسْمٍ مُسْتَقِيمَانِ مُتَوَازِيَانِ؟",
  "pr.2": "كَمْ مُرَبَّعًا المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ؟",
  "pr.3": "أَيُّ قِيَاسٍ هُوَ المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.4": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَمُدَّ الخَطَّيْنِ. هَلْ يَلْتَقِيَانِ؟",
  "pr.5": "فِي أَيِّ رَسْمٍ عَلَامَةُ التَّوَازِي؟",
  "ch.find": "قَاسَتْ فَوْضَى المَسَافَةَ بَيْنَ المُتَوَازِيَيْنِ بِخَطٍّ مَائِلٍ. أَيُّ قِيَاسٍ هُوَ المَسَافَةُ حَقًّا؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ch.after": [
   "chaos",
   "آه! القِيَاسُ المَائِلُ أَطْوَلُ مِنَ المَسَافَةِ."
  ],
  "ch.right": "المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ لَا تُقَاسُ بِخَطٍّ مَائِلٍ.",
  "ch.wrong": [
   "chaos",
   "أَيُّ خَطٍّ بَيْنَ المُتَوَازِيَيْنِ يَقِيسُ المَسَافَةَ بَيْنَهُمَا."
  ],
  "ms.3": "لِمَاذَا لَا نَقِيسُ المَسَافَةَ بَيْنَ المُتَوَازِيَيْنِ بِخَطٍّ مَائِلٍ؟",
  "ms.3a": "لِأَنَّ القِيَاسَ المَائِلَ يَتَغَيَّرُ مَعَ المَيْلِ.",
  "ms.3b": "لِأَنَّ المِسْطَرَةَ لَا تَقِيسُ إِلَّا الخُطُوطَ الأُفُقِيَّةَ.",
  "ms.3c": "لِأَنَّ الخَطَّ المَائِلَ أَقْصَرُ.",
  "ms.4": "مَاذَا يَقُولُ السَّهْمَانِ الصَّغِيرَانِ فِي هَذَا الرَّسْمِ؟",
  "ms.4a": "أَنَّ المُسْتَقِيمَيْنِ مُتَوَازِيَانِ.",
  "ms.4b": "أَنَّ المُسْتَقِيمَيْنِ بِالطُّولِ نَفْسِهِ.",
  "ms.4c": "أَنَّ المُسْتَقِيمَيْنِ يَلْتَقِيَانِ.",
  "ms.recall": "المُتَوَازِيَانِ لَا يَلْتَقِيَانِ مَهْمَا امْتَدَّا، أُفُقِيَّيْنِ كَانَا أَوْ مَائِلَيْنِ.",
  "ms.recall2": "المَسَافَةُ بَيْنَ المُتَوَازِيَيْنِ لَا تُقَاسُ مَائِلَةً، وَهِيَ ثَابِتَةٌ.",
  "ms.recall3": "عَلَامَةُ التَّوَازِي: سَهْمٌ صَغِيرٌ عَلَى كُلِّ مُسْتَقِيمٍ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُتَوَازِيَيْنِ وَالمَسَافَةَ بَيْنَهُمَا. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "رَسَمْنَا فِي حَيِّ التَّقَاطُعَاتِ خُطُوطًا مُتَوَازِيَةً، لَا تَلْتَقِي أَبَدًا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} عَنْ خَطَّيْنِ مُتَوَازِيَيْنِ فِي بَلَاطِ الأَرْضِ، وَ{قِسِ|قِيسِي} المَسَافَةَ بَيْنَهُمَا فِي مَوْضِعَيْنِ."
  ]
