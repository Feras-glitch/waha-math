 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ كَبِيرَةٌ، وَثَلَاثُ قُصَاصَاتٍ مُلَوَّنَةٍ، وَكَنْزٌ صَغِيرٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذِهِ غُرْفَةُ فَوْضَى، وَتَحْتَهَا خَرِيطَتُهَا. وَضَعَتْ فَوْضَى السَّرِيرَ عَلَى عَلَامَةِ البَابِ! {اُنْقُلْهُ|اُنْقُلِيهِ} إِلَى مَكَانِهِ.",
  "hook.02": "{اُنْظُرْ|اُنْظُرِي} إِلَى الغُرْفَةِ: هَلِ السَّرِيرُ قُرْبَ البَابِ، أَمْ قُرْبَ النَّافِذَةِ؟",
  "hook.03": "الآنَ تُشْبِهُ الخَرِيطَةُ الغُرْفَةَ.",
  "mat.01": "{ضَعِ|ضَعِي} القُصَاصَاتِ الثَّلَاثَ عَلَى الأَرْضِ، وَ{قِفْ وَانْظُرْ|قِفِي وَانْظُرِي} إِلَيْهَا مِنْ فَوْقُ: هَكَذَا يَرَاهَا الطَّائِرُ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "وَالآنَ غُرْفَةٌ عَلَى الشَّاشَةِ.",
  "bv.01": "لِنَتَخَيَّلْ أَنَّنَا طُيُورٌ فَوْقَ الغُرْفَةِ: نَرَى الأَشْيَاءَ مُسَطَّحَةً عَلَى الأَرْضِ. {تَوَقَّعْ|تَوَقَّعِي}: كَيْفَ يَرَى الطَّائِرُ الطَّاوِلَةَ؟",
  "bv.bed": "{اِلْمَسِ|اِلْمَسِي} السَّرِيرَ.",
  "bv.rug": "{اِلْمَسِ|اِلْمَسِي} السَّجَّادَةَ.",
  "bv.table": "{اِلْمَسِ|اِلْمَسِي} الطَّاوِلَةَ.",
  "bv.bedN": "السَّرِيرُ مِنْ فَوْقُ مُسْتَطِيلٌ كَهْرَمَانِيٌّ.",
  "bv.rugN": "وَالسَّجَّادَةُ مِنْ فَوْقُ دَائِرَةٌ مَرْجَانِيَّةٌ.",
  "bv.tableN": "وَالطَّاوِلَةُ مِنْ فَوْقُ مُرَبَّعٌ أَخْضَرُ مُزْرَقٌّ.",
  "bv.02": "هَذِهِ خَرِيطَةُ الغُرْفَةِ: البَابُ وَالنَّافِذَةُ عَلَامَتَانِ عَلَى حَافَّتِهَا، وَكُلُّ شَيْءٍ فِي مَكَانِهِ كَمَا فِي الغُرْفَةِ.",
  "ex.find0": "خَبَّأْنَا كَنْزًا فِي الغُرْفَةِ، عَلَى الأَرْضِ. نَبْحَثُ عَنْ مَكَانِهِ فِي الخَرِيطَةِ: مَا الَّذِي بِجَانِبِهِ؟ وَهَلْ هُوَ قُرْبَ الجِدَارِ أَمْ قُرْبَنَا؟",
  "ex.find": "أَيْنَ الكَنْزُ فِي الخَرِيطَةِ؟ {اِلْمَسْ مَكَانَهُ|اِلْمَسِي مَكَانَهُ}.",
  "ex.put": "{ضَعِ|ضَعِي} قِطْعَةَ الطَّاوِلَةِ فِي مَكَانِهَا عَلَى الخَرِيطَةِ.",
  "ex.route": "{اُنْظُرْ|اُنْظُرِي} إِلَى الطَّرِيقِ المَرْسُومِ مِنَ البَابِ: أَيُّ وَصْفٍ يُنَاسِبُهُ؟",
  "ex.routeA": "مِنَ البَابِ إِلَى الطَّاوِلَةِ، ثُمَّ إِلَى السَّرِيرِ.",
  "ex.routeB": "مِنَ البَابِ إِلَى السَّجَّادَةِ، ثُمَّ إِلَى السَّرِيرِ.",
  "gm.intro": "لُعْبَةُ الكَنْزِ: نَرَى الكَنْزَ فِي الغُرْفَةِ، وَنَبْحَثُ عَنْهُ فِي الخَرِيطَةِ.",
  "gm.1": "أَيْنَ الكَنْزُ فِي الخَرِيطَةِ؟ {اِلْمَسْ مَكَانَهُ|اِلْمَسِي مَكَانَهُ}.",
  "gm.2": "أَيْنَ القِطَّةُ فِي الخَرِيطَةِ؟ {اِلْمَسْ مَكَانَهَا|اِلْمَسِي مَكَانَهَا}.",
