 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} ثَلَاثَةُ أَعْوَادٍ وَصَلْصَالٌ، وَعَشَرَةُ أَغْطِيَةٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فَوْضَى تَبْنِي سَقْفَ البَيْتِ. أَيُّ قِطْعَةٍ تُنَاسِبُ مَكَانَ السَّقْفِ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "hook.02": "المُرَبَّعُ يَتْرُكُ فَرَاغَاتٍ عَلَى الجَانِبَيْنِ. {جَرِّبِ|جَرِّبِي} القِطْعَةَ الأُخْرَى.",
  "hook.03": "تَمَامًا! السَّقْفُ مُثَلَّثٌ.",
  "hook.04": "مَا الَّذِي يَجْعَلُ المُثَلَّثَ مُخْتَلِفًا؟ هَيَّا نَكْتَشِفُ.",
  "mat.01": "{اِصْنَعْ|اِصْنَعِي} مُثَلَّثًا بِالأَعْوَادِ الثَّلَاثَةِ، وَ{صِلْ|صِلِي} أَطْرَافَهَا بِالصَّلْصَالِ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "كَمْ عُودًا {اسْتَعْمَلْتَ|اسْتَعْمَلْتِ}؟ وَكَمْ كُرَةَ صَلْصَالٍ؟ هَيَّا نَرَى عَلَى الشَّاشَةِ.",
  "exp.01": "{مَرِّرْ إِصْبَعَكَ|مَرِّرِي إِصْبَعَكِ} عَلَى حَافَّةِ المُثَلَّثِ. أَيْنَ يَتَوَقَّفُ الإِصْبَعُ؟",
  "exp.sides": "ثَلَاثَةُ رُؤُوسٍ! وَالحَافَّةُ المُسْتَقِيمَةُ بَيْنَ رَأْسَيْنِ اسْمُهَا: ضِلْعٌ. {اِلْمَسْ|اِلْمَسِي} كُلَّ ضِلْعٍ لِنَعُدَّهَا.",
  "exp.03": "لِلْمُثَلَّثِ ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ، وَثَلَاثَةُ رُؤُوسٍ. وَلِلْمُرَبَّعِ أَرْبَعَةُ أَضْلَاعٍ، وَأَرْبَعَةُ رُؤُوسٍ.",
  "n.01": "كَمْ رَأْسًا لِلْمُرَبَّعِ؟ {اُنْظُرْ|اُنْظُرِي} كَيْفَ أَعُدُّ: أَلْمَسُ كُلَّ رَأْسٍ مَرَّةً وَاحِدَةً.",
  "n.02": "آخِرُ عَدَدٍ قُلْتُهُ هُوَ عَدَدُ الرُّؤُوسِ: أَرْبَعَة.",
  "n.03": "وَالآنَ {عُدَّ أَنْتَ|عُدِّي أَنْتِ}: {اِلْمَسْ|اِلْمَسِي} كُلَّ رَأْسٍ مَرَّةً وَاحِدَةً.",
  "n.04": "فَوْضَى عَدَّتْ رُؤُوسَ المُرَبَّعِ، فَظَهَرَ عَلَى عَدَّادِهَا هَذَا العَدَدُ. أَيُّ رَأْسٍ عَدَّتْهُ مَرَّتَيْنِ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "n.05": "{اُنْظُرْ|اُنْظُرِي} إِلَى الشَّارَاتِ: أَيُّ رَأْسٍ عَلَيْهِ شَارَتَانِ؟",
  "n.06": "{وَجَدْتَهُ|وَجَدْتِهِ}! نَعُدُّ مِنْ جَدِيدٍ، رَأْسًا رَأْسًا: {اِلْمَسْ|اِلْمَسِي} كُلَّ رَأْسٍ مَرَّةً.",
  "n.07": "أَرْبَعَة! لِكُلِّ رَأْسٍ عَدَدٌ وَاحِدٌ.",
  "n.08": "وَالأَشْيَاءُ نَعُدُّهَا هَكَذَا أَيْضًا: نَلْمَسُ كُلَّ وَاحِدٍ مَرَّةً، وَآخِرُ عَدَدٍ هُوَ «كَمْ».",
  "wk.01": "هَذَا مُثَلَّثٌ: نَعُدُّ أَضْلَاعَهُ.",
  "wk.02": "ثَلَاثَةُ أَضْلَاعٍ، وَثَلَاثَةُ رُؤُوسٍ.",
  "wk.03": "هَلْ مَا زَالَ مُثَلَّثًا؟ نَعُدُّ: {اِلْمَسْ|اِلْمَسِي} كُلَّ رَأْسٍ.",
  "wk.05": "ثَلَاثَةُ رُؤُوسٍ، وَثَلَاثَةُ أَضْلَاعٍ: مَا زَالَ مُثَلَّثًا!",
  "wk.06": "وَالمُثَلَّثُ يَكُونُ طَوِيلًا رَفِيعًا، أَوْ عَرِيضًا، كَبِيرًا أَوْ صَغِيرًا.",
  "wk.07": "وَهَذَانِ الشَّكْلَانِ؟ {اِلْمَسِ|اِلْمَسِي} الحَافَّةَ المُنْحَنِيَةَ فِي الأَوَّلِ.",
  "wk.08": "وَ{اِلْمَسِ|اِلْمَسِي} الفَتْحَةَ فِي الثَّانِي.",
  "wk.09": "إِذَا انْحَنَتْ إِحْدَى الحَوَافِّ، أَوْ كَانَ الشَّكْلُ مَفْتُوحًا، فَلَيْسَ مُثَلَّثًا.",
  "pr.intro": "سِلَالُنَا: لِلْمُثَلَّثَاتِ، وَلِلْمُرَبَّعَاتِ، وَ«غَيْرُ ذَلِكَ». هَيَّا نَتَمَرَّنُ.",
  "pr.mark": "أَيُّ هَذِهِ مُثَلَّثَاتٌ؟ {اِلْمَسْهَا|اِلْمَسِيهَا} كُلَّهَا، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "pr.how": "كَمْ ضِلْعًا لِلْمُثَلَّثِ؟",
  "pr.howV": "كَمْ رَأْسًا لِهَذَا المُرَبَّعِ؟",
  "pr.howC": "كَمْ دَائِرَةً فِي الصُّورَةِ؟",
  "game.01": "لُعْبَةُ بَيْتِ الأَشْكَالِ: {اِلْمَسْ|اِلْمَسِي} قِطْعَةً، ثُمَّ {اِلْمَسْ|اِلْمَسِي} مَكَانَهَا فِي البَيْتِ.",
  "game.02": "بَيْتٌ كَامِلٌ!",
  "why.t": "ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ، وَثَلَاثَةُ رُؤُوسٍ.",
  "why.tRot": "ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ، مَهْمَا قَلَبْنَاهُ.",
  "why.sq": "أَرْبَعَةُ أَضْلَاعٍ، فَلَيْسَ مُثَلَّثًا.",
  "why.curved": "إِحْدَى حَوَافِّهِ مُنْحَنِيَةٌ، فَلَيْسَ مُثَلَّثًا.",
  "why.open": "مَفْتُوحٌ، فِيهِ فَتْحَةٌ، فَلَيْسَ مُثَلَّثًا.",
  "why.other": "لَيْسَ مُثَلَّثًا وَلَا مُرَبَّعًا.",
  "ch.after": "ثَلَاثَةُ أَضْلَاعٍ: إِنَّهُ مُثَلَّثٌ مَقْلُوبٌ. مَكَانُهُ سَلَّةُ المُثَلَّثَاتِ.",
  "ch.right": "المُثَلَّثُ المَقْلُوبُ مَا زَالَ مُثَلَّثًا: لَهُ ثَلَاثَةُ أَضْلَاعٍ.",
  "ch.wrong": [
