 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قَلَمَانِ، وَأَشْرِطَةٌ مِنْ وَرَقٍ، وَشَرِيطٌ لَاصِقٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "مَنْ قَلَمُهُ أَطْوَلُ: فِرْجَار أَمْ فَوْضَى؟ {اِلْمَسِ|اِلْمَسِي} القَلَمَ الَّذِي {تَظُنُّهُ|تَظُنِّينَهُ} أَطْوَلَ.",
  "hook.02": "دَفَعَتْ فَوْضَى قَلَمَهَا إِلَى الأَمَامِ! فَكَيْفَ نَعْرِفُ الأَطْوَلَ حَقًّا؟ هَيَّا نَتَعَلَّمُ.",
  "mat.01": "{ضَعِ|ضَعِي} القَلَمَيْنِ عَلَى الطَّاوِلَةِ، وَبِدَايَةُ كُلٍّ مِنْهُمَا عِنْدَ الشَّرِيطِ اللَّاصِقِ، ثُمَّ {اُنْظُرْ|اُنْظُرِي} إِلَى النِّهَايَتَيْنِ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "al.01": "الشَّرِيطُ الأَسْفَلُ لَا يَبْدَأُ مِنْ خَطِّ البِدَايَةِ. {اِسْحَبْهُ|اِسْحَبِيهِ} إِلَيْهِ.",
  "al.02": "هَكَذَا: نَسْحَبُهُ حَتَّى تَلْمَسَ بِدَايَتُهُ الخَطَّ.",
  "al.03": "الآنَ يَبْدَآنِ مِنْ خَطٍّ وَاحِدٍ. أَيُّهُمَا أَطْوَلُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "al.04": "{اُنْظُرْ|اُنْظُرِي} إِلَى النِّهَايَتَيْنِ: أَيُّهُمَا أَبْعَدُ عَنِ الخَطِّ؟",
  "al.05": "نُحَاذِي البِدَايَتَيْنِ عَلَى خَطٍّ وَاحِدٍ، ثُمَّ نَنْظُرُ إِلَى النِّهَايَتَيْنِ: الأَطْوَلُ نِهَايَتُهُ أَبْعَدُ.",
  "al.06": "وَإِذَا حَرَّكْنَا الشَّرِيطَ، هَلْ يَتَغَيَّرُ طُولُهُ؟",
  "al.07": "صَحِيحٌ: تَغَيَّرَ مَكَانُهُ، وَبَقِيَ طُولُهُ كَمَا هُوَ.",
  "al.08": "تَغَيَّرَ مَكَانُهُ فَقَطْ: أَعَدْنَاهُ، فَإِذَا طُولُهُ كَمَا هُوَ.",
  "ex.01": "وَالآنَ نُرَتِّبُ الأَقْلَامَ: نُقَارِنُ اثْنَيْنِ اثْنَيْنِ.",
  "ex.ord": "رَتِّبِ الأَقْلَامَ الثَّلَاثَةَ مِنَ الأَقْصَرِ إِلَى الأَطْوَلِ: {اِلْمَسِ|اِلْمَسِي} الأَقْصَرَ أَوَّلًا، ثُمَّ الَّذِي يَلِيهِ، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "gm.intro": "سِبَاقُ الدِّيدَانِ! الدِّيدَانُ تَزْحَفُ إِلَى أَمَاكِنَ مُخْتَلِفَةٍ: {حَاذِ|حَاذِي} أَذْيَالَهَا عَلَى خَطِّ البِدَايَةِ، ثُمَّ {اِحْكُمْ|اِحْكُمِي}.",
  "gm.q1": "أَيُّ الدُّودَتَيْنِ أَطْوَلُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "gm.q2": "أَيُّ الدِّيدَانِ أَقْصَرُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "gm.q3": "أَيُّ الدِّيدَانِ أَطْوَلُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "gm.after": "نَعْرِفُ الفَائِزَ حِينَ تَبْدَأُ الدِّيدَانُ مِنْ خَطٍّ وَاحِدٍ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُقَارَنَةِ.",
  "pr.1": "أَيُّ الشَّرِيطَيْنِ أَطْوَلُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
