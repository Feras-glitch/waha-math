{
 "id": "m2.u7.d1",
 "title": "مَا المُحِيطُ؟",
 "icon": [
  "arperim"
 ],
 "concepts": {
  "C200": "المحيط: الطول الكلي حول الشكل، بقياس الأضلاع وجمعها، وبعدّ أضلاع المربعات على حدود الشكل في الشبكة"
 },
 "bag": {
  "items": [
   {
    "icon": "thread",
    "label": "bagThread"
   },
   {
    "icon": "ruler",
    "label": "bagRuler"
   }
  ],
  "ask": "bag.ask",
  "adult": "خيط ومسطرة وكتاب.",
  "screenPath": "على الشاشة يرى الطفل الشريط يدور حول اللوحة، والخيط يُفرد على المسطرة، ويعدّ أضلاع المربعات على الحدود؛ والخيط الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagThread": "خَيْطٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "home.back": "{قِسْتَ|قِسْتِ} طُولَ سَرِيرِكُمْ بِالشَّرِيطِ. فَلَوْ أَرَادَتْ فَوْضَى شَرِيطَ زِينَةٍ يَدُورُ حَوْلَ السَّرِيرِ كُلِّهِ، هَلْ يَكْفِيهَا هَذَا الطُّولُ؟ كَمْ تَحْتَاجُ؟",
  "rb.01": "تُرِيدُ فَوْضَى شَرِيطَ زِينَةٍ حَوْلَ لَوْحَتِهَا. كَمْ طُولُ الشَّرِيطِ الَّذِي تَحْتَاجُهُ؟",
  "rb.02": "الشَّرِيطُ يَدُورُ حَوْلَ اللَّوْحَةِ كُلِّهَا: طُولُهُ اسْمُهُ المُحِيطُ.",
  "st.01": "نَمُدُّ خَيْطًا حَوْلَ حَافَّةِ الكِتَابِ.",
  "st.02": "ثُمَّ نَفْرُدُهُ عَلَى المِسْطَرَةِ: طُولُهُ هُوَ المُحِيطُ، الطُّولُ الكُلِّيُّ حَوْلَ الشَّكْلِ.",
  "st.03": "وَإِذَا {قِسْتَ|قِسْتِ} كُلَّ ضِلْعٍ {وَجَمَعْتَهَا|وَجَمَعْتِهَا} كُلَّهَا، {تَجِدُ|تَجِدِينَ} الطُّولَ نَفْسَهُ.",
  "gb.01": "وَعَلَى الشَّبَكَةِ: ضِلْعُ كُلِّ مُرَبَّعٍ سَنْتِيمِتْرٌ. نَمْشِي عَلَى الحُدُودِ وَنَعُدُّ.",
  "gb.02": "لَا نَعُدُّ المُرَبَّعَاتِ فِي الدَّاخِلِ، بَلْ أَضْلَاعَهَا عَلَى الحُدُودِ.",
  "gb.03": "وَعِنْدَ الرُّكْنِ ضِلْعَانِ: نَعُدُّ كُلًّا مِنْهُمَا مَرَّةً وَاحِدَةً.",
  "mat.01": "{مُدَّ|مُدِّي} خَيْطًا حَوْلَ كِتَابٍ {وَافْرُدْهُ|وَافْرُدِيهِ} عَلَى المِسْطَرَةِ، ثُمَّ {قِسْ|قِيسِي} كُلَّ ضِلْعٍ {وَاجْمَعْهَا|وَاجْمَعِيهَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: سِيَاجُ المَزْرَعَةِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُحِيطِ.",
  "pr.perim": "كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذَا الشَّكْلِ؟",
  "pr.perimG": "ضِلْعُ كُلِّ مُرَبَّعٍ سَنْتِيمِتْرٌ. كَمْ سَنْتِيمِتْرًا مُحِيطُ الشَّكْلِ؟",
  "ch.find": "عَدَّتْ فَوْضَى المُرَبَّعَاتِ فِي الدَّاخِلِ، وَقَالَتْ إِنَّهُ المُحِيطُ! كَمْ سَنْتِيمِتْرًا المُحِيطُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! المُحِيطُ عَلَى الحُدُودِ، لَا فِي الدَّاخِلِ."
  ],
  "ch.right": "نَمْشِي عَلَى السُّورِ وَنَعُدُّ أَضْلَاعَ المُرَبَّعَاتِ.",
  "ch.wrong": [
   "chaos",
   "المُرَبَّعَاتُ فِي الدَّاخِلِ هِيَ المُحِيطُ."
  ],
  "ms.1": "قَالَ وَلَدٌ: مُحِيطُ المُسْتَطِيلِ سِتَّةَ عَشَرَ. وَقَالَتْ بِنْتٌ: سِتَّةَ عَشَرَ سَنْتِيمِتْرًا. أَيُّهُمَا أَدَقُّ؟",
  "ms.1a": "البِنْتُ، لِأَنَّهَا ذَكَرَتِ الوَحْدَةَ.",
  "ms.1b": "الوَلَدُ، لِأَنَّ جَوَابَهُ أَقْصَرُ.",
  "ms.1c": "هُمَا سَوَاءٌ، فَالوَحْدَةُ لَا تُهِمُّ.",
  "ms.recall": "المُحِيطُ: الطُّولُ الكُلِّيُّ حَوْلَ الشَّكْلِ؛ نَجْمَعُ أَطْوَالَ أَضْلَاعِهِ كُلِّهَا.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُحِيطَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "دَخَلْنَا حَيَّ الأَسْوَارِ: السُّورُ يَدُورُ حَوْلَ المَدِينَةِ كُلِّهَا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {مُدَّ|مُدِّي} خَيْطًا حَوْلَ طَاوِلَةٍ أَوْ صُورَةٍ، {وَقِسْهُ|وَقِيسِيهِ}، ثُمَّ {اِجْمَعْ|اِجْمَعِي} أَطْوَالَ أَضْلَاعِهَا {وَقَارِنْ|وَقَارِنِي}."
  ]
 },
