  "ask": "bag.ask",
  "adult": "ورق مربعات ومرآة صغيرة غير زجاجية وقلم.",
  "screenPath": "أسئلة الوحدة على الشاشة: هل الخط محور؟ وعدد المحاور، وصورة النقطة والشكل، والإكمال على الشبكة، واكتشاف الخطأ، والتعليل، وتصميم بمحورين؛ والرسم الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagMirror": "مِرْآةٌ صَغِيرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِرْآةٌ صَغِيرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "وَصَلْنَا بَابَ القَصْرِ. حَارِسُهُ يَسْأَلُ أَسْئِلَةَ المِرْآةِ.",
  "hook.02": "{إِنْ أَجَبْتَ عَنْهَا صِرْتَ حَارِسَ|إِنْ أَجَبْتِ عَنْهَا صِرْتِ حَارِسَةَ} القَصْرِ، {وَأَخَذْتَ|وَأَخَذْتِ} الحَجَرَ الخَامِسَ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} شَكْلًا مُتَمَاثِلًا، وَ{تَحَقَّقْ|تَحَقَّقِي} بِالمِرْآةِ مِنْ مَحَاوِرِهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المِحْوَرُ نَطْوِي عَلَيْهِ فَيَنْطَبِقُ النِّصْفَانِ، وَكُلُّ نُقْطَةٍ وَصُورَتُهَا عَلَى البُعْدِ نَفْسِهِ مِنْهُ.",
  "rv.02": "وَالمُنْتَظِمُ لَهُ مَحَاوِرُ بِعَدَدِ أَضْلَاعِهِ، وَالمِحْوَرُ قَدْ يَكُونُ مَائِلًا.",
  "rv.03": "وَنُكْمِلُ الصُّورَةَ بِعَدِّ المُرَبَّعَاتِ مِنَ المِحْوَرِ.",
  "gm.intro": "لُعْبَةُ: اخْتِبَارُ المِرْآةِ! وَفَوْضَى تَخْلِطُ المَحَاوِرَ، {فَصَحِّحْ|فَصَحِّحِي} لَهَا.",
  "gm.is": "تَقُولُ فَوْضَى: هَذَا الخَطُّ مِحْوَرُ تَمَاثُلٍ. هَلْ هُوَ مِحْوَرُ تَمَاثُلٍ؟",
  "gm.count": "تَقُولُ فَوْضَى: عَدَدُ مَحَاوِرِهِ وَاحِدٌ. كَمْ مِحْوَرًا لَهُ حَقًّا؟",
  "gm.img": "رَسَمَتْ فَوْضَى صُورَةً خَطَأً. {اِلْمِسِ|اِلْمِسِي} الصُّورَةَ الصَّحِيحَةَ لِكُلِّ نُقْطَةٍ مُحَاطَةٍ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "q.is": "هَلْ هَذَا الخَطُّ مِحْوَرُ تَمَاثُلٍ لِلشَّكْلِ؟",
  "q.count": "كَمْ مِحْوَرَ تَمَاثُلٍ لِهَذَا الشَّكْلِ؟",
  "q.img": "{اِلْمِسْ|اِلْمِسِي} صُورَةَ كُلِّ نُقْطَةٍ مُحَاطَةٍ بِالنِّسْبَةِ لِلْمِحْوَرِ الأَحْمَرِ.",
  "q.fill": "{أَكْمِلِ|أَكْمِلِي} الشَّكْلَ بِالنِّسْبَةِ لِلْمِحْوَرِ: {اِلْمِسْ|اِلْمِسِي} صُورَةَ كُلِّ نُقْطَةٍ مُحَاطَةٍ.",
  "q.err": "فِي هَذِهِ الصُّورَةِ نُقْطَةٌ فِي غَيْرِ مَكَانِهَا. {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "q.find": "هَذِهِ نُقْطَةٌ وَصُورَتُهَا. {اِلْمِسِ|اِلْمِسِي} النُّقْطَةَ الَّتِي يَمُرُّ بِهَا المِحْوَرُ.",
  "q.legs": "{اِلْمِسِ|اِلْمِسِي} المِسْطَرَةَ لِنَقِيسَ. هَلْ سَاقَا شِبْهِ المُنْحَرِفِ مُتَسَاوِيَتَانِ؟",
  "q.dsg": "{صَمِّمْ|صَمِّمِي} شَكْلًا لَهُ مِحْوَرَانِ عَلَى الأَقَلِّ: {لَوِّنْ|لَوِّنِي} خَانَاتِهِ، ثُمَّ «تَمَّ».",
  "ts.11": "لِمَاذَا قُطْرُ المُسْتَطِيلِ لَيْسَ مِحْوَرَ تَمَاثُلٍ؟",
  "ts.11a": "لِأَنَّنَا إِذَا طَوَيْنَا عَلَيْهِ لَا يَنْطَبِقُ النِّصْفَانِ.",
  "ts.11b": "لِأَنَّهُ لَا يَقْسِمُ المُسْتَطِيلَ نِصْفَيْنِ مُتَسَاوِيَيْنِ.",
  "ts.11c": "لِأَنَّهُ مَائِلٌ، وَالمِحْوَرُ لَا يَكُونُ مَائِلًا.",
  "ts.rem": "نَطْوِي مَعَ الكِبَارِ وَرَقًا وَنَتَحَقَّقُ بِالوَرَقِ الشَّفَّافِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": "هَذَا الحَجَرُ الخَامِسُ لِلْوَاحَةِ!",
  "ts.win1": "{أَنْتَ حَارِسُ|أَنْتِ حَارِسَةُ} القَصْرِ!",
  "ts.win2": "{عَرَفْتَ|عَرَفْتِ} المِحْوَرَ وَالصُّورَةَ وَعَدَدَ المَحَاوِرِ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ القَصْرِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} حُدُودَ ثَلَاثَةِ أَشْيَاءَ مُسَطَّحَةٍ مِنَ البَيْتِ عَلَى وَرَقَةٍ، {وَاطْوِهَا|وَاطْوِيهَا} بِكُلِّ طَرِيقَةٍ يَنْطَبِقُ عِنْدَهَا النِّصْفَانِ، وَ{عُدَّ|عُدِّي} مَحَاوِرَ كُلٍّ مِنْهَا."
  ]
 },
