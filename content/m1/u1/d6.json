 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} أَشْكَالٌ مَقْصُوصَةٌ مِنَ الوَرَقِ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "تَعَلَّمْتُ {مَعَكَ|مَعَكِ} الأَشْكَالَ! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَضَعُ أَنَا حَجَرَ النَّبْعِ فِي مَكَانِهِ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "rv.circle": "الدَّائِرَةُ: حَافَّةٌ مُنْحَنِيَةٌ، بِلَا رُؤُوسٍ.",
  "rv.square": "المُرَبَّعُ: أَرْبَعَةُ أَضْلَاعٍ مُتَسَاوِيَةٍ.",
  "rv.triangle": "المُثَلَّثُ: ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ.",
  "rv.rect": "المُسْتَطِيلُ: كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَأَرْكَانُهُ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "mat.01": "{اِصْنَعْ|اِصْنَعِي} رُوبُوتًا مِنَ الأَشْكَالِ المَقْصُوصَةِ عَلَى الطَّاوِلَةِ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ رُوبُوتٌ عَلَى الشَّاشَةِ!",
  "rb.01": "{صَمِّمْ|صَمِّمِي} رُوبُوتًا مِنَ الأَشْكَالِ الأَرْبَعَةِ: {اِلْمِسْ|اِلْمِسِي} شَكْلًا فَيَظْهَرُ، ثُمَّ {اِسْحَبْهُ|اِسْحَبِيهِ}. وَحِينَ {تَنْتَهِي|تَنْتَهِينَ}، «تَمَّ».",
  "rb.02": "{ضَعْ|ضَعِي} ثَلَاثَةَ أَشْكَالٍ عَلَى الأَقَلِّ.",
  "rb.03": "رُوبُوتٌ رَائِعٌ! حَفِظْتُهُ فِي {مَعْرِضِكَ|مَعْرِضِكِ}.",
  "cp.01": "وَالأَشْكَالُ تَصْنَعُ أَشْكَالًا! {شَاهِدْ|شَاهِدِي}: مُثَلَّثَانِ…",
  "cp.02": "مُثَلَّثَانِ مَعًا يَصْنَعَانِ مُرَبَّعًا!",
  "cp.03": "وَمُرَبَّعَانِ مُتَجَاوِرَانِ…",
  "cp.04": "يَصْنَعَانِ مُسْتَطِيلًا: كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ فِيهِ مُتَسَاوِيَانِ!",
  "gm.intro": "سِبَاقُ الأَشْكَالِ: ثَلَاثُ مَحَطَّاتٍ. {خُذْ وَقْتَكَ|خُذِي وَقْتَكِ}، فَنَحْنُ نَفُوزُ بِالجَوَابِ الصَّحِيحِ لَا بِالسُّرْعَةِ.",
  "gm.q1": "أَيْنَ المُثَلَّثُ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "gm.r1": "لِي أَرْبَعَةُ أَضْلَاعٍ…",
  "gm.r2": "وَأَضْلَاعِي كُلُّهَا مُتَسَاوِيَةٌ. مَنْ أَنَا؟",
  "acc.sq": "نَعَمْ، هُوَ مُسْتَطِيلٌ. وَلَهُ اسْمٌ أَخَصُّ: مُرَبَّعٌ.",
  "why.c": "حَافَّتُهُ مُنْحَنِيَةٌ، وَلَا رُؤُوسَ لَهُ.",
  "why.sq": "أَرْبَعَةُ أَضْلَاعٍ مُتَسَاوِيَةٍ.",
  "why.t": "ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ.",
  "why.r": "كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَأَرْكَانُهُ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "ts.sq": "أَيْنَ المُرَبَّعُ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.tri": "أَيْنَ المُثَلَّثُ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.rect": "أَيْنَ المُسْتَطِيلُ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.sides": "كَمْ ضِلْعًا لِهَذَا المُثَلَّثِ؟",
  "ts.vert": "كَمْ رَأْسًا لِهَذَا الشَّكْلِ؟",
  "ts.circle": "هَلْ لِلدَّائِرَةِ رُؤُوسٌ؟",
  "ts.why": "لِمَاذَا هَذَا مُثَلَّثٌ؟ {اِسْمَعِ|اِسْمَعِي} الأَسْبَابَ الثَّلَاثَةَ، ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "ts.r1": "لِأَنَّ لَهُ ثَلَاثَةَ أَضْلَاعٍ مُسْتَقِيمَةٍ.",
  "ts.r2": "لِأَنَّ لَوْنَهُ أَخْضَرُ مِثْلُ العُشْبِ.",
  "ts.r3": "لِأَنَّ رَأْسَهُ إِلَى الأَعْلَى.",
  "ts.rem": "نَبْحَثُ مَعَ الكِبَارِ عَنِ الأَشْكَالِ فِي أَشْيَاءِ البَيْتِ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَضَعُ حَجَرَ النَّبْعِ الأَوَّلَ فِي مَكَانِهِ."
  ],
  "ts.win1": "{أَنْتَ صَيَّادٌ مَاهِرٌ|أَنْتِ صَيَّادَةٌ مَاهِرَةٌ}!",
  "ts.win2": "جَرَى المَاءُ فِي جَدْوَلِ «سَاحَةِ الأَشْكَالِ»، وَاخْضَرَّتِ النَّخْلَةُ!",
  "wrap.01": "صَارَ فِي الوَاحَةِ جَدْوَلُ مَاءٍ، وَرُوبُوتٌ مِنَ الأَشْكَالِ يَحْرُسُهُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {رَتِّبْ|رَتِّبِي} مَعَ الكِبَارِ ثَمَانِيَةَ أَشْيَاءَ مُسَطَّحَةٍ عَلَى صِينِيَّةٍ فِي أَرْبَعِ مَجْمُوعَاتٍ، وَ{الْمِسْ|الْمِسِي} رُؤُوسَ كُلِّ شَيْءٍ {وَعُدَّهَا|وَعُدِّيهَا}."
  ]
 },
