 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مَشَابِكُ وَقَلَمٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "قَارَنْتُ وَقِسْتُ {مَعَكَ|مَعَكِ}! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَضَعُ أَنَا الحَجَرَ الرَّابِعَ فِي مَكَانِهِ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "rv.01": "نُقَارِنُ الأَطْوَالَ مِنْ خَطٍّ وَاحِدٍ، وَالمِيزَانُ يُخْبِرُنَا بِالأَثْقَلِ، وَالأَكْبَرُ لَيْسَ دَائِمًا الأَثْقَلَ.",
  "rv.02": "وَنَقِيسُ بِوَحْدَةٍ وَاحِدَةٍ بِلَا فَرَاغٍ، وَالعَمُودُ الأَطْوَلُ فِي اللَّوْحَةِ فِيهِ أَشْيَاءُ أَكْثَرُ.",
  "rv.03": "وَالعَدَدُ بَعْدَ العَشَرَةِ عَشَرَةٌ وَآحَادٌ، وَلِكُلِّ عَدَدٍ صَدِيقٌ يُكَمِّلُهُ إِلَى عَشَرَةٍ.",
  "mat.01": "{قِسْ|قِيسِي} مَعَ الكِبَارِ شَيْئَيْنِ بِالمَشَابِكِ، مِنْ بِدَايَةِ كُلٍّ مِنْهُمَا بِلَا فَرَاغٍ، وَ{قُلْ|قُولِي} أَيُّهُمَا أَطْوَلُ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "us.01": "{اِصْنَعْ|اِصْنَعِي} شَرِيطَ وَحَدَاتٍ مِنْ مُرَبَّعَاتٍ مُتَسَاوِيَةٍ: {اِلْمَسْ|اِلْمَسِي} «مُرَبَّعٌ» مَرَّاتٍ، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "us.02": "وَالآنَ نَقِيسُ القَلَمَ {بِشَرِيطِكَ|بِشَرِيطِكِ}، مِنْ بِدَايَتِهِ.",
  "us.03": "كَمْ مُرَبَّعًا طُولُ القَلَمِ؟",
  "us.04": "{شَرِيطُكَ|شَرِيطُكِ} مُرَبَّعَاتُهُ مُتَسَاوِيَةٌ، فَيَصْلُحُ لِلْقِيَاسِ، وَلَوْ بِلَا أَرْقَامٍ! {وَتَسْتَطِيعُ|وَتَسْتَطِيعِينَ} أَنْ {تُلَوِّنَهُ|تُلَوِّنِيهِ} كَمَا {تُحِبُّ|تُحِبِّينَ}.",
  "gm.intro": "سِبَاقُ القِيَاسِ: نُقَارِنُ، ثُمَّ نُرَتِّبُ، ثُمَّ نَقِيسُ!",
  "gm.1": "أَيُّ الشَّرِيطَيْنِ أَطْوَلُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "gm.2": "رَتِّبِ العِيدَانَ الثَّلَاثَةَ مِنَ الأَقْصَرِ إِلَى الأَطْوَلِ، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "gm.3": "{اِلْمَسِ|اِلْمَسِي} المُكَعَّبَاتِ تَحْتَ المِلْعَقَةِ وَ{عُدَّهَا|عُدِّيهَا}.",
  "pr.intro": "تَمْرِينٌ قَبْلَ أَسْئِلَةِ الوَاحَةِ.",
  "pr.1": "أَيُّ الكُرَاتِ أَصْغَرُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "pr.2": "أَيُّهُمَا أَثْقَلُ: البِطِّيخَةُ أَمِ الكِتَابُ؟ {اُنْظُرْ|اُنْظُرِي} إِلَى المِيزَانِ، وَ{الْمَسْهُ|الْمَسِيهِ}.",
  "pr.3": "كَمْ مُكَعَّبًا؟",
  "pr.c1": "{اِسْحَبِ|اِسْحَبِي} الشِّبْرَ إِلَى بِدَايَةِ الشَّيْءِ، أَوِ {اِلْمَسْهُ|اِلْمَسِيهِ}، ثُمَّ {اِخْتَرْ|اِخْتَارِي} سَلَّتَهُ.",
  "pr.c4": "أَيُّ القِيَاسَيْنِ صَحِيحٌ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "ts.2": "أَيُّ الأَقْلَامِ أَقْصَرُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "ts.3": "الوِسَادَةُ كَبِيرَةٌ، وَالسَّيَّارَةُ صَغِيرَةٌ: أَيُّهُمَا أَثْقَلُ؟ {اُنْظُرْ|اُنْظُرِي} إِلَى المِيزَانِ، وَ{الْمَسْهُ|الْمَسِيهِ}.",
  "ts.4": "رَتِّبِ العِيدَانَ الأَرْبَعَةَ مِنَ الأَقْصَرِ إِلَى الأَطْوَلِ، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "ts.5": "رَتِّبِ الكُرَاتِ مِنَ الأَصْغَرِ إِلَى الأَكْبَرِ، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "ts.6": "{اِلْمَسِ|اِلْمَسِي} المُكَعَّبَاتِ تَحْتَ الكِتَابِ وَ{عُدَّهَا|عُدِّيهَا}.",
  "ts.7": "{قِسِ|قِيسِي} الجَزَرَةَ بِالمَشَابِكِ: {اِلْمَسْ|اِلْمَسِي} «{أَضِفْ|أَضِيفِي}» حَتَّى نِهَايَتِهَا، ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "ts.8": "لِمَاذَا يَجِبُ أَنْ تَكُونَ كُلُّ المَشَابِكِ بِالحَجْمِ نَفْسِهِ؟",
  "ts.8a": "لِيَكُونَ كُلُّ مِشْبَكٍ بِالطُّولِ نَفْسِهِ، فَيَصِحَّ العَدَدُ.",
  "ts.8b": "لِأَنَّ المَشَابِكَ الكَبِيرَةَ أَجْمَلُ فِي القِيَاسِ.",
  "ts.8c": "لِكَيْ نَعُدَّ أَسْرَعَ، وَلَا يَهُمُّ حَجْمُهَا.",
  "ts.9": "كَمْ زَادَتِ الوُرُودُ عَلَى أَوْرَاقِ الشَّجَرِ؟",
  "ts.10": "{اِلْمَسِ|اِلْمَسِي} بِطَاقَةَ هَذَا البِنَاءِ.",
  "ts.st": "عَلَى السِّلْكِ سَبْعَةُ عَصَافِيرَ، وَحَطَّتْ سَبْعَةٌ أُخْرَى. كَمْ صَارَتْ؟",
  "ts.rem": "نَقِيسُ مَعَ الكِبَارِ أَشْيَاءَ حَقِيقِيَّةً بِالمَشَابِكِ وَالمُكَعَّبَاتِ، وَنُقَارِنُ وَنَزِنُ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَضَعُ الحَجَرَ الرَّابِعَ فِي مَكَانِهِ."
  ],
  "ts.win1": "{أَنْتَ القَيَّاسُ الصَّغِيرُ|أَنْتِ القَيَّاسَةُ الصَّغِيرَةُ}!",
  "ts.win2": "جَرَى المَاءُ فِي جَدْوَلِ «سُوقِ القِيَاسِ»، وَاخْضَرَّتْ نَخْلَتَانِ!",
  "wrap.01": "جَرَى المَاءُ فِي أَرْبَعَةِ جَدَاوِلَ مِنْ جَدَاوِلِ الوَاحَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {رَتِّبْ|رَتِّبِي} مَعَ {أَهْلِكَ|أَهْلِكِ} ثَلَاثَةَ أَشْيَاءَ مِنَ الأَقْصَرِ إِلَى الأَطْوَلِ، ثُمَّ {قِسْهَا|قِيسِيهَا} بِالمَشَابِكِ، وَ{قُلْ|قُولِي}: هَلْ صَدَقَ {تَرْتِيبُكَ|تَرْتِيبُكِ}؟"
  ],
  "tw.wt": "أَيُّهُمَا أَثْقَلُ؟ {اُنْظُرْ|اُنْظُرِي} إِلَى المِيزَانِ، وَ{الْمَسْهُ|الْمَسِيهِ}."
 },
