  ],
  "ask": "bag.ask",
  "adult": "ورقة تُطوى مرتين (ركن الورقة). الكبير لا يحكم على الركن بالنظر.",
  "screenPath": "على الشاشة تُطوى الورقة مرتين فيظهر ركنها، ويوضع على مستقيمين ليُعرف هل هما متعامدان، ويدير الطفل شارعاً حتى يتعامد مع آخر؛ وطيّ الورقة الحقيقية في مسار «معي»."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ نَطْوِيهَا؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذِهِ قُصَاصَةُ وَرَقٍ أَرْكَانُهَا لَيْسَتْ مِثْلَ رُكْنِ الكِتَابِ. {اِلْمِسْهَا|اِلْمِسِيهَا} لِنَطْوِيَهَا.",
  "sym.01": "القِطْعَتَانِ أَلِف بَاء وَبَاء جِيم تَلْتَقِيَانِ فِي رُكْنٍ مِثْلِ رُكْنِ الوَرَقَةِ.",
  "sym.02": "نَكْتُبُ التَّعَامُدَ بِرَمْزٍ يُشْبِهُ الرُّكْنَ: خَطٌّ وَاقِفٌ عَلَى خَطٍّ.",
  "sym.03": "وَنَقْرَؤُهُ: أَلِف بَاء يُعَامِدُ بَاء جِيم.",
  "pr.sym": "أَيُّ رَسْمٍ يُطَابِقُ هَذَا الرَّمْزَ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "hook.02": "صَارَ لَهَا حَافَّةٌ مُسْتَقِيمَةٌ. {اِلْمِسْهَا|اِلْمِسِيهَا} لِنَطْوِيَهَا مَرَّةً ثَانِيَةً، حَافَّةً عَلَى حَافَّةٍ.",
  "hook.03": "هَذَا الرُّكْنُ نُسَمِّيهِ: رُكْنَ الوَرَقَةِ. بِهِ نَفْحَصُ الأَرْكَانَ: رُكْنَ الكِتَابِ، وَرُكْنَ البَابِ، وَرُكْنَ النَّافِذَةِ.",
  "mat.01": "{اِطْوِ|اِطْوِي} الوَرَقَةَ مَرَّةً، ثُمَّ {اِطْوِهَا|اِطْوِيهَا} مِنْ جَدِيدٍ حَافَّةً عَلَى حَافَّةٍ. ثُمَّ {ضَعْ|ضَعِي} رُكْنَهَا عَلَى رُكْنِ كِتَابٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "pp.01": "هَذَانِ مُسْتَقِيمَانِ مُتَقَاطِعَانِ. {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ رُكْنَ الوَرَقَةِ عِنْدَ نُقْطَةِ التَّقَاطُعِ.",
  "pp.02": "اِنْطَبَقَ ضِلْعَا الرُّكْنِ عَلَى المُسْتَقِيمَيْنِ. نَقُولُ: مُسْتَقِيمَانِ مُتَعَامِدَانِ. وَعَلَامَتُهُمَا مُرَبَّعٌ صَغِيرٌ عِنْدَ نُقْطَةِ التَّقَاطُعِ.",
  "pp.03": "أَدَرْنَا الرَّسْمَ كُلَّهُ، وَمَا زَالَ الرُّكْنُ يَنْطَبِقُ: المُتَعَامِدَانِ لَيْسَا دَائِمًا أُفُقِيًّا وَرَأْسِيًّا.",
  "wk.intro": "{اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "wk.1": "مُتَعَامِدَانِ: أُفُقِيٌّ وَرَأْسِيٌّ.",
  "wk.2": "وَمُتَعَامِدَانِ مَائِلَانِ.",
  "wk.3": "وَالمُرَبَّعُ الصَّغِيرُ عَلَامَةُ التَّعَامُدِ.",
  "game.01": "لُعْبَةُ: مُهَنْدِسُ التَّقَاطُعَاتِ!",
  "gm.q": "{أَدِرِ|أَدِيرِي} الشَّارِعَ البُرْتُقَالِيَّ بِالزِّرَّيْنِ حَتَّى يَتَعَامَدَ مَعَ الشَّارِعِ الأَزْرَقِ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُتَعَامِدَاتِ.",
  "pr.1": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ رُكْنَ الوَرَقَةِ. هَلِ المُسْتَقِيمَانِ مُتَعَامِدَانِ؟",
  "pr.2": "فِي أَيِّ رَسْمٍ عَلَامَةُ التَّعَامُدِ؟",
  "pr.3": "فِي أَيِّ رَسْمٍ مُسْتَقِيمَانِ مُتَعَامِدَانِ؟",
  "pr.4": "مَا عَلَاقَةُ هَذَيْنِ المُسْتَقِيمَيْنِ؟",
  "ch.find": "تَقُولُ فَوْضَى: هُمَا مُتَعَامِدَانِ بِالنَّظَرِ! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ رُكْنَ الوَرَقَةِ. هَلْ هُمَا مُتَعَامِدَانِ؟",
  "ch.after": [
   "chaos",
   "آه! أَتَأَكَّدُ بِرُكْنِ الوَرَقَةِ، لَا بِالنَّظَرِ."
  ],
  "ch.right": "نَتَأَكَّدُ مِنَ التَّعَامُدِ بِرُكْنِ الوَرَقَةِ.",
  "ch.wrong": [
   "chaos",
   "نَعْرِفُ المُتَعَامِدَيْنِ بِالنَّظَرِ وَحْدَهُ."
  ],
  "ms.3": "لِمَاذَا نَطْوِي الوَرَقَةَ مَرَّتَيْنِ؟",
  "ms.3a": "لِنَصْنَعَ رُكْنًا نَفْحَصُ بِهِ الأَرْكَانَ.",
  "ms.3b": "لِتَصِيرَ الوَرَقَةُ أَصْغَرَ فَنَحْمِلَهَا.",
  "ms.3c": "لِنَعُدَّ طَيَّاتِ الوَرَقَةِ.",
  "ms.4": "مَاذَا يَقُولُ المُرَبَّعُ الصَّغِيرُ عِنْدَ نُقْطَةِ التَّقَاطُعِ؟",
  "ms.4a": "أَنَّ المُسْتَقِيمَيْنِ مُتَعَامِدَانِ.",
  "ms.4b": "أَنَّ المُسْتَقِيمَيْنِ مُتَوَازِيَانِ.",
  "ms.4c": "أَنَّ الرَّسْمَ مُرَبَّعٌ.",
  "ms.recall": "رُكْنُ الوَرَقَةِ المَطْوِيَّةِ مَرَّتَيْنِ نَفْحَصُ بِهِ الأَرْكَانَ.",
  "ms.recall2": "المُتَعَامِدَانِ مُتَقَاطِعَانِ يَنْطَبِقُ رُكْنُ الوَرَقَةِ عَلَى رُكْنِهِمَا، أُفُقِيًّا وَرَأْسِيًّا كَانَا أَوْ مَائِلَيْنِ.",
  "ms.recall3": "عَلَامَةُ التَّعَامُدِ: مُرَبَّعٌ صَغِيرٌ عِنْدَ نُقْطَةِ التَّقَاطُعِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُتَعَامِدَيْنِ وَ{تَتَأَكَّدُ|تَتَأَكَّدِينَ} بِرُكْنِ الوَرَقَةِ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَنَعْنَا فِي حَيِّ التَّقَاطُعَاتِ رُكْنَ الوَرَقَةِ، وَبِهِ نَتَأَكَّدُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِفْحَصْ|اِفْحَصِي} بِرُكْنِ الوَرَقَةِ رُكْنَ البَابِ وَرُكْنَ الطَّاوِلَةِ وَرُكْنَ كِتَابٍ، وَ{قُلْ|قُولِي}: أَتَأَكَّدُ!"
  ]
 },
