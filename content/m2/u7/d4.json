  "ask": "bag.ask",
  "adult": "ورق مربعات ومسطرة وقلم.",
  "screenPath": "على الشاشة يعدّ الطفل الصفوف والأعمدة ويضرب، ويجد الضلع المجهول، ويقارن الأراضي، ويرسم مستطيلاً بمساحة معلومة؛ والرسم الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "rc.01": "مُسْتَطِيلٌ مُغَطًّى بِالمُرَبَّعَاتِ. بَدَلَ أَنْ نَعُدَّهَا وَاحِدًا وَاحِدًا: فِي كُلِّ صَفٍّ أَرْبَعَةٌ.",
  "rc.02": "وَعِنْدَنَا خَمْسَةُ صُفُوفٍ: خَمْسَةٌ فِي أَرْبَعَةٍ، عِشْرُونَ سَنْتِيمِتْرًا مُرَبَّعًا.",
  "rc.03": "مَسَاحَةُ المُسْتَطِيلِ: الطُّولُ فِي العَرْضِ. وَالمُرَبَّعُ: الضِّلْعُ فِي الضِّلْعِ.",
  "rq.01": "المُحِيطُ يَجْمَعُ الأَطْوَالَ حَوْلَ الشَّكْلِ، وَوَحْدَتُهُ السَّنْتِيمِتْرُ.",
  "rq.02": "وَالمَسَاحَةُ تَعُدُّ المُرَبَّعَاتِ دَاخِلَهُ بِالضَّرْبِ، وَوَحْدَتُهَا السَّنْتِيمِتْرُ المُرَبَّعُ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} مُسْتَطِيلًا، {وَعُدَّ|وَعُدِّي} صُفُوفَهُ وَأَعْمِدَتَهُ، {وَاضْرِبْ|وَاضْرِبِي}، ثُمَّ {تَحَقَّقْ|تَحَقَّقِي} بِالعَدِّ وَبِالمِسْطَرَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: مُهَنْدِسُ الأَرَاضِي!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى مَسَاحَةِ المُسْتَطِيلِ.",
  "pr.areaR": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَتُهُ؟",
  "pr.areaSq": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ هَذَا المُرَبَّعِ؟",
  "pr.sideA": "مَسَاحَةُ هَذَا المُسْتَطِيلِ وَطُولُهُ مَكْتُوبَانِ. كَمْ سَنْتِيمِتْرًا عَرْضُهُ؟",
  "pr.sameA": "أَيُّ الأَرْضَيْنِ أَكْبَرُ مَسَاحَةً؟",
  "pr.drawA": "{اُرْسُمْ|اُرْسُمِي} مُسْتَطِيلًا عَلَى الشَّبَكَةِ: {اِلْمِسْ|اِلْمِسِي} رُكْنَهُ المُقَابِلَ لِلنُّقْطَةِ. مَسَاحَتُهُ:",
  "ch.find": "جَمَعَتْ فَوْضَى الطُّولَ وَالعَرْضَ: ثَمَانِيَةٌ وَثَلَاثَةٌ، أَحَدَ عَشَرَ! كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَتُهُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! نَضْرِبُ الصُّفُوفَ فِي الأَعْمِدَةِ، وَلَا نَجْمَعُ."
  ],
  "ch.right": "ثَلَاثَةُ صُفُوفٍ فِي كُلٍّ مِنْهَا ثَمَانِيَةٌ: أَرْبَعَةٌ وَعِشْرُونَ.",
  "ch.wrong": [
   "chaos",
   "نَجْمَعُ الطُّولَ وَالعَرْضَ كَالمُحِيطِ."
  ],
  "ms.2": "لِمَاذَا نَقْسِمُ المَسَاحَةَ عَلَى الطُّولِ لِنَجِدَ العَرْضَ؟",
  "ms.2a": "لِأَنَّ المَسَاحَةَ الطُّولُ فِي العَرْضِ.",
  "ms.2b": "لِأَنَّ المَسَاحَةَ الطُّولُ زَائِدَ العَرْضِ.",
  "ms.2c": "لِأَنَّ العَرْضَ نِصْفُ الطُّولِ دَائِمًا.",
  "ms.recall": "مَسَاحَةُ المُسْتَطِيلِ: عَدَدُ الصُّفُوفِ فِي عَدَدِ الأَعْمِدَةِ، أَيِ الطُّولُ فِي العَرْضِ.",
  "ms.recall2": "العَرْضُ: المَسَاحَةُ مَقْسُومَةً عَلَى الطُّولِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَحْسُبُ|صِرْتِ تَحْسُبِينَ} المَسَاحَةَ بِالضَّرْبِ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "رَتَّبْنَا أَرَاضِيَ المَدِينَةِ مِنَ الأَصْغَرِ مَسَاحَةً إِلَى الأَكْبَرِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} عَلَى وَرَقِ المُرَبَّعَاتِ مُسْتَطِيلَيْنِ مَسَاحَتُهُمَا وَاحِدَةٌ وَشَكْلُهُمَا مُخْتَلِفٌ."
  ]
 },
