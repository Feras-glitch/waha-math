 ],
 "concepts": {
  "C176": "إكمال شكل بالنسبة لمحور رأسي ثم أفقي ثم قطري (بتدوير الورقة)، بعدّ المربعات عمودياً على المحور"
 },
 "bag": {
  "items": [
   {
    "icon": "gridPaper",
    "label": "bagGrid"
   },
   {
    "icon": "mirror",
    "label": "bagMirror"
   }
  ],
  "ask": "bag.ask",
  "adult": "ورق مربعات، ومرآة صغيرة غير زجاجية، وقلم رصاص ومسطرة.",
  "screenPath": "على الشاشة يكمل الطفل الأشكال بعدّ المربعات بمحور رأسي ثم أفقي ثم قطري، وتتحقق المرآة؛ والرسم الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagMirror": "مِرْآةٌ صَغِيرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِرْآةٌ صَغِيرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "gw.01": "نِصْفُ نَافِذَةِ القَصْرِ مَفْقُودٌ. نُرَمِّمُهُ: لِكُلِّ نُقْطَةٍ نَعُدُّ مُرَبَّعَاتِهَا إِلَى المِحْوَرِ.",
  "gw.02": "وَنَعُدُّ مِثْلَهَا فِي الجِهَةِ الأُخْرَى، ثُمَّ نَصِلُ النِّقَاطَ.",
  "gw.03": "المِرْآةُ تَتَحَقَّقُ: انْطَبَقَ نِصْفُ النَّافِذَةِ عَلَى صُورَتِهِ.",
  "gh.01": "وَالمِحْوَرُ هُنَا أُفُقِيٌّ. نَعُدُّ مِنَ النُّقْطَةِ إِلَى المِحْوَرِ نُزُولًا.",
  "gh.02": "وَنَعُدُّ مِثْلَهَا تَحْتَ المِحْوَرِ.",
  "gh.03": "صَارَ الشَّكْلُ وَصُورَتُهُ فَوْقَ المِحْوَرِ وَتَحْتَهُ.",
  "tp.01": "وَهَذَا المِحْوَرُ قُطْرِيٌّ: مَائِلٌ. نُدِيرُ الوَرَقَةَ حَتَّى يَصِيرَ رَأْسِيًّا.",
  "tp.02": "صَارَ المِحْوَرُ رَأْسِيًّا، فَنَعُدُّ المُرَبَّعَاتِ كَمَا {تَعَوَّدْتَ|تَعَوَّدْتِ}.",
  "tp.03": "ثُمَّ نُعِيدُ الوَرَقَةَ، وَالصُّورَةُ فِي مَكَانِهَا.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ: {اُرْسُمْ|اُرْسُمِي} مِحْوَرًا وَنِصْفَ شَكْلٍ، ثُمَّ {أَكْمِلْهُ|أَكْمِلِيهِ} بِعَدِّ المُرَبَّعَاتِ، {وَضَعِ|وَضَعِي} المِرْآةَ عَلَى المِحْوَرِ لِتَتَحَقَّقَ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: تَرْمِيمُ القَصْرِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى إِكْمَالِ الصُّورَةِ.",
  "pr.img": "{أَكْمِلِ|أَكْمِلِي} الصُّورَةَ: {اِلْمِسْ|اِلْمِسِي} صُورَةَ كُلِّ نُقْطَةٍ مُحَاطَةٍ بِالنِّسْبَةِ لِلْمِحْوَرِ الأَحْمَرِ.",
  "pr.err": "رُسِمَتْ صُورَةُ الشَّكْلِ، وَفِيهَا نُقْطَةٌ فِي غَيْرِ مَكَانِهَا. {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.check": "فِي أَيِّ لَوْحَةٍ الصُّورَةُ الزَّرْقَاءُ صَحِيحَةٌ؟",
  "ch.find": "رَسَمَتْ فَوْضَى صُورَةَ الشَّكْلِ بِنَقْلِهِ كَمَا هُوَ إِلَى الجِهَةِ الأُخْرَى. فِي أَيِّ لَوْحَةٍ الصُّورَةُ الصَّحِيحَةُ؟",
  "ch.after": [
   "chaos",
   "آه! المِرْآةُ تَقْلِبُ الشَّكْلَ، وَلَا تَنْقُلُهُ."
  ],
  "ch.right": "الصُّورَةُ مَقْلُوبَةٌ: الأَقْرَبُ إِلَى المِحْوَرِ يَبْقَى الأَقْرَبَ.",
  "ch.wrong": [
   "chaos",
   "نَنْقُلُ الشَّكْلَ كَمَا هُوَ."
  ],
  "ms.1": "لِمَاذَا نَعُدُّ المُرَبَّعَاتِ مِنَ المِحْوَرِ؟",
  "ms.1a": "لِأَنَّ الصُّورَةَ عَلَى بُعْدِ النُّقْطَةِ عَنْهُ.",
  "ms.1b": "لِأَنَّ الصُّورَةَ تَبْدَأُ مِنْ حَافَّةِ الوَرَقَةِ.",
  "ms.1c": "لِأَنَّ الشَّكْلَ يَنْتَقِلُ كَمَا هُوَ.",
  "ms.recall": "نَعُدُّ مِنَ النُّقْطَةِ إِلَى المِحْوَرِ عَلَى خَطٍّ عَمُودِيٍّ عَلَيْهِ، ثُمَّ نَعُدُّ مِثْلَهَا فِي الجِهَةِ الأُخْرَى.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُكْمِلُ|صِرْتِ تُكْمِلِينَ} الصُّورَةَ بِأَيِّ مِحْوَرٍ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "رَمَّمْنَا نَوَافِذَ القَصْرِ كُلَّهَا بِالعَدِّ وَالمِرْآةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} نِصْفَ فَرَاشَةٍ، ثُمَّ {أَكْمِلْهَا|أَكْمِلِيهَا}، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِالمِرْآةِ."
  ]
 },
