  "ask": "bag.ask",
  "adult": "خيط ومسطرة وورقة عليها نقطة. الكبير يثبّت طرف الخيط.",
  "screenPath": "على الشاشة يرسم الطفل مستقيمات تمرّ بنقطة ثم بنقطتين، ويضع حافة المسطرة على ثلاث نقاط؛ والخيطان الحقيقيان في مسار «معي»."
 },
 "labels": {
  "bagThread": "خَيْطٌ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذِهِ قِطْعَةٌ مِنْ سِكَّةِ الحَدِيدِ. هَلْ تَنْتَهِي هُنَا؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "hook.02": "السِّكَّةُ تَمْتَدُّ مِنَ الجِهَتَيْنِ. خَطٌّ مُسْتَقِيمٌ يَمْتَدُّ مِنَ الجِهَتَيْنِ بِلَا بِدَايَةٍ وَلَا نِهَايَةٍ نُسَمِّيهِ: مُسْتَقِيمًا.",
  "mat.01": "{ثَبِّتْ|ثَبِّتِي} طَرَفَ الخَيْطِ عِنْدَ نُقْطَةٍ عَلَى الوَرَقَةِ، وَ{شُدَّهُ|شُدِّيهِ} فِي اتِّجَاهَاتٍ كَثِيرَةٍ، وَ{ضَعِ|ضَعِي} المِسْطَرَةَ بِجَانِبِهِ كُلَّ مَرَّةٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "lt.01": "كَمْ مُسْتَقِيمًا يَمُرُّ بِنُقْطَةٍ وَاحِدَةٍ؟ {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَرْسُمَ مُسْتَقِيمًا بَعْدَ مُسْتَقِيمٍ.",
  "lt.02": "مِنْ نُقْطَةٍ وَاحِدَةٍ تَمُرُّ مُسْتَقِيمَاتٌ كَثِيرَةٌ.",
  "lt.03": "وَالآنَ نُقْطَتَانِ. {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَرْسُمَ مُسْتَقِيمًا يَمُرُّ بِهِمَا.",
  "lt.04": "هَلْ نَسْتَطِيعُ أَنْ نَرْسُمَ مُسْتَقِيمًا آخَرَ يَمُرُّ بِهِمَا؟ {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ.",
  "lt.05": "وَقَعَ المُسْتَقِيمُ الثَّانِي عَلَى الأَوَّلِ تَمَامًا. مِنْ نُقْطَتَيْنِ يَمُرُّ مُسْتَقِيمٌ وَاحِدٌ فَقَطْ، وَنُسَمِّيهِ بِهِمَا: المُسْتَقِيمُ أَلِف بَاء.",
  "wk.intro": "قِطْعَةٌ وَشُعَاعٌ وَمُسْتَقِيمٌ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "wk.1": "القِطْعَةُ: لَهَا بِدَايَةٌ وَنِهَايَةٌ، وَطُولُهَا يُقَاسُ.",
  "wk.2": "الشُّعَاعُ: لَهُ بِدَايَةٌ وَلَيْسَ لَهُ نِهَايَةٌ، فَلَا يُقَاسُ طُولُهُ.",
  "wk.3": "المُسْتَقِيمُ: لَيْسَ لَهُ بِدَايَةٌ وَلَا نِهَايَةٌ، وَفِي رَسْمِهِ سَهْمَانِ.",
  "game.01": "لُعْبَةُ: عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُسْتَقِيمِ.",
  "pr.1": "أَيُّ رَسْمٍ مُسْتَقِيمٌ؟",
  "pr.2": "مَا اسْمُ هَذَا الرَّسْمِ؟",
  "pr.3": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ حَافَّةَ المِسْطَرَةِ. هَلِ النُّقَطُ الثَّلَاثُ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "pr.4": "فِي أَيِّ رَسْمٍ ثَلَاثُ نُقَطٍ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "pr.5": "فِي أَيِّ رَسْمٍ ثَلَاثُ نُقَطٍ لَيْسَتْ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "pq.start": "هَلْ لِهَذَا الرَّسْمِ بِدَايَةٌ؟",
  "pq.end": "هَلْ لِهَذَا الرَّسْمِ نِهَايَةٌ؟",
  "pq.len": "هَلْ نَقِيسُ طُولَ هَذَا الرَّسْمِ بِالمِسْطَرَةِ؟",
  "ch.find": "تَقُولُ فَوْضَى: النُّقَطُ الثَّلَاثُ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ بِالنَّظَرِ! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ المِسْطَرَةَ. هَلْ هِيَ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "ch.after": [
   "chaos",
   "آه! النُّقْطَةُ الوُسْطَى لَيْسَتْ عَلَى حَافَّةِ المِسْطَرَةِ."
  ],
  "ch.right": "نَتَأَكَّدُ مِنَ الاِسْتِقَامَةِ بِحَافَّةِ المِسْطَرَةِ.",
  "ch.wrong": [
   "chaos",
   "نَتَأَكَّدُ مِنَ الاِسْتِقَامَةِ بِالنَّظَرِ وَحْدَهُ."
  ],
  "ms.3": "لِي بِدَايَةٌ، وَلَيْسَ لِي نِهَايَةٌ. مَنْ أَنَا؟",
  "ms.3a": "الشُّعَاعُ.",
  "ms.3b": "القِطْعَةُ المُسْتَقِيمَةُ.",
  "ms.3c": "المُسْتَقِيمُ.",
  "ms.4": "كَمْ مُسْتَقِيمًا يَمُرُّ بِالنُّقْطَتَيْنِ مَعًا؟",
  "ms.4a": "مُسْتَقِيمٌ وَاحِدٌ فَقَطْ.",
  "ms.4b": "مُسْتَقِيمَانِ مُخْتَلِفَانِ.",
  "ms.4c": "مُسْتَقِيمَاتٌ كَثِيرَةٌ.",
  "ms.5": "كَمْ مُسْتَقِيمًا يَمُرُّ بِنُقْطَةٍ وَاحِدَةٍ؟",
  "ms.5a": "مُسْتَقِيمَاتٌ كَثِيرَةٌ.",
  "ms.5b": "مُسْتَقِيمٌ وَاحِدٌ فَقَطْ.",
  "ms.5c": "لَا يَمُرُّ بِهَا مُسْتَقِيمٌ.",
  "ms.6": "رَسَمَ سَامِي مُسْتَقِيمًا يَمُرُّ بِالنُّقْطَتَيْنِ، وَرَسَمَتْ لَيْلَى مُسْتَقِيمًا يَمُرُّ بِهِمَا أَيْضًا. مَاذَا نَعْرِفُ؟",
  "ms.6a": "رَسَمَا المُسْتَقِيمَ نَفْسَهُ.",
  "ms.6b": "رَسَمَا مُسْتَقِيمَيْنِ مُتَقَاطِعَيْنِ عِنْدَ نُقْطَةٍ.",
  "ms.6c": "لَا نَعْرِفُ شَيْئًا عَنِ الرَّسْمَيْنِ.",
  "ms.7": "كَيْفَ نَتَأَكَّدُ أَنَّ ثَلَاثَ نُقَطٍ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ؟",
  "ms.7a": "نَضَعُ حَافَّةَ المِسْطَرَةِ عَلَيْهَا.",
  "ms.7b": "نَعُدُّ النُّقَطَ: إِنْ كَانَتْ ثَلَاثًا فَهِيَ كَذَلِكَ.",
  "ms.7c": "نَنْظُرُ إِلَيْهَا مِنْ بَعِيدٍ فَقَطْ.",
  "ms.recall": "المُسْتَقِيمُ يَمْتَدُّ مِنَ الجِهَتَيْنِ بِلَا بِدَايَةٍ وَلَا نِهَايَةٍ، وَنُسَمِّيهِ بِنُقْطَتَيْنِ عَلَيْهِ.",
  "ms.recall2": "مِنْ نُقْطَةٍ وَاحِدَةٍ تَمُرُّ مُسْتَقِيمَاتٌ كَثِيرَةٌ، وَمِنْ نُقْطَتَيْنِ يَمُرُّ مُسْتَقِيمٌ وَاحِدٌ.",
  "ms.recall3": "النُّقَطُ عَلَى اسْتِقَامَةٍ وَاحِدَةٍ إِذَا مَرَّتْ بِهَا كُلِّهَا حَافَّةُ المِسْطَرَةِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُسْتَقِيمَ وَالنُّقَطَ الَّتِي عَلَى اسْتِقَامَةٍ وَاحِدَةٍ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "مَدَدْنَا فِي حَيِّ الطُّرُقِ سِكَّةَ حَدِيدٍ تَمْتَدُّ مِنَ الجِهَتَيْنِ!",
