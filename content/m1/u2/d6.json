 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} نَرْدٌ، وَعُلْبَةٌ صَغِيرَةٌ، وَقُصَاصَاتٌ لَاصِقَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "تَعَلَّمْتُ {مَعَكَ|مَعَكِ} المُجَسَّمَاتِ! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَضَعُ أَنَا الحَجَرَ الثَّانِيَ فِي مَكَانِهِ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "rv.cube": "المُكَعَّبُ: وُجُوهُهُ مُسَطَّحَةٌ، وَيَقِفُ ثَابِتًا.",
  "rv.sphere": "الكُرَةُ: سَطْحُهَا مُنْحَنٍ، وَتَتَدَحْرَجُ فِي كُلِّ اتِّجَاهٍ.",
  "rv.cylinder": "الأُسْطُوَانَةُ: وَجْهَانِ دَائِرِيَّانِ، تَقِفُ وَتَتَدَحْرَجُ فِي خَطٍّ مُسْتَقِيمٍ.",
  "rv.cone": "المَخْرُوطُ: رَأْسٌ مُدَبَّبٌ، وَقَاعِدَةٌ دَائِرِيَّةٌ.",
  "rv.flat": "وَالمُسَطَّحُ نَرْسُمُهُ وَنَقُصُّهُ، أَمَّا المُجَسَّمُ فَيَمْلَأُ الكَفَّ.",
  "mat.01": "{أَلْصِقْ|أَلْصِقِي} قُصَاصَةً عَلَى كُلِّ وَجْهٍ مِنْ وُجُوهِ النَّرْدِ وَأَنْتَ {تُدِيرُهُ|تُدِيرِينَهُ}، ثُمَّ {عُدَّ|عُدِّي} القُصَاصَاتِ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "هَيَّا نَعُدُّ عَلَى الشَّاشَةِ أَيْضًا.",
  "fc.cube": "{اِلْمَسْ|اِلْمَسِي} كُلَّ وَجْهٍ مِنْ وُجُوهِ المُكَعَّبِ، فَتُلْصَقُ عَلَيْهِ قُصَاصَةٌ. وَ{أَدِرْهُ|أَدِيرِيهِ} {لِتَرَى|لِتَرَيْ} الوُجُوهَ الأُخْرَى.",
  "fc.count": "نَعُدُّ القُصَاصَاتِ:",
  "fc.cube.after": "سِتَّةُ وُجُوهٍ لِلْمُكَعَّبِ، وَكُلُّهَا مُرَبَّعَاتٌ.",
  "fc.box": "وَعُلْبَةُ الشَّايِ؟ {اِلْمَسْ|اِلْمَسِي} كُلَّ وَجْهٍ مِنْ وُجُوهِهَا.",
  "fc.box.after": "لِلْعُلْبَةِ سِتَّةُ وُجُوهٍ أَيْضًا، لَكِنَّ وُجُوهَهَا لَيْسَتْ كُلُّهَا مُرَبَّعَاتٍ.",
  "rh.intro": "صَائِدُ المُجَسَّمَاتِ: {جِدْ|جِدِي} مَا أَطْلُبُهُ فِي الغُرْفَةِ. {خُذْ وَقْتَكَ|خُذِي وَقْتَكِ}، فَنَحْنُ نَفُوزُ بِالجَوَابِ الصَّحِيحِ.",
  "pr.intro": "أَرْبَعُ سِلَالٍ: لِلْمُكَعَّبَاتِ، وَلِلْكُرَاتِ، وَلِلْأُسْطُوَانَاتِ، وَلِلْمَخَارِيطِ. هَيَّا نَتَمَرَّنُ.",
  "rh.cyl": "أَيْنَ الأُسْطُوَانَةُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "rh.cone": "أَيْنَ المَخْرُوطُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
