 "labels": {
  "bagThread": "خَيْطٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "رَسَمْتُ طَرِيقًا جَدِيدًا، وَكُلُّهُ خَطٌّ مُسْتَقِيمٌ وَاحِدٌ!"
  ],
  "hook.02": "هَلْ هُوَ خَطٌّ مُسْتَقِيمٌ وَاحِدٌ؟ {اِلْمِسِ|اِلْمِسِي} الطَّرِيقَ لِنُلَوِّنَ أَجْزَاءَهُ.",
  "hook.03": "أَرْبَعَةُ أَجْزَاءٍ مُسْتَقِيمَةٍ، وَالطَّرِيقُ يَنْكَسِرُ بَيْنَ كُلِّ جُزْأَيْنِ. لِلْخُطُوطِ أَنْوَاعٌ، وَلِكُلِّ نَوْعٍ اسْمٌ.",
  "mat.01": "{شُدَّ|شُدِّي} الخَيْطَ بَيْنَ {يَدَيْكَ|يَدَيْكِ}، ثُمَّ {ضَعْهُ|ضَعِيهِ} مُتَمَوِّجًا عَلَى الطَّاوِلَةِ، ثُمَّ {اِثْنِهِ|اِثْنِيهِ} بِزَوَايَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "sx.intro": "ثَلَاثَةُ خُطُوطٍ مُغْلَقَةٍ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "sx.1": "خَطٌّ مُغْلَقٌ لَا يَقْطَعُ نَفْسَهُ: نُسَمِّيهِ مُغْلَقًا بَسِيطًا.",
  "sx.2": "وَهَذَا الخَطُّ يَقْطَعُ نَفْسَهُ: هُوَ مُغْلَقٌ، لَكِنَّهُ لَيْسَ بَسِيطًا.",
  "sx.3": "وَهَذَا مُغْلَقٌ بَسِيطٌ أَيْضًا، وَأَجْزَاؤُهُ مُسْتَقِيمَةٌ.",
  "k.intro": "هَذَا خَيْطٌ بِثَلَاثِ هَيْئَاتٍ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "k.1": "الخَيْطُ مَشْدُودٌ: هَذَا خَطٌّ مُسْتَقِيمٌ.",
  "k.2": "الخَيْطُ مُتَمَوِّجٌ: هَذَا خَطٌّ مُنْحَنٍ.",
  "k.3": "الخَيْطُ مَثْنِيٌّ بِزَوَايَا: هَذَا خَطٌّ مُنْكَسِرٌ، أَجْزَاؤُهُ مُسْتَقِيمَةٌ مُتَّصِلَةٌ.",
  "ant.01": "فِي كُلِّ رَسْمٍ نَمْلَةٌ تُرِيدُ الخُرُوجَ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "ant.02": "لَا تَجِدُ النَّمْلَةُ فَتْحَةً: هَذَا خَطٌّ مُغْلَقٌ، بِدَايَتُهُ تَلْتَقِي بِنِهَايَتِهِ.",
  "ant.03": "خَرَجَتِ النَّمْلَةُ مِنَ الفَتْحَةِ: هَذَا خَطٌّ مَفْتُوحٌ.",
  "ant.04": "وَالمُغْلَقُ لَيْسَ دَائِرِيًّا دَائِمًا: المُرَبَّعُ وَالمُثَلَّثُ خُطُوطٌ مُغْلَقَةٌ أَيْضًا.",
  "dr.intro": "وَهَذِهِ ثَلَاثَةُ خُطُوطٍ مُسْتَقِيمَةٍ بِأَوْضَاعٍ مُخْتَلِفَةٍ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "dr.1": "هَذَا خَطٌّ أُفُقِيٌّ، كَسَطْحِ المَاءِ السَّاكِنِ.",
  "dr.2": "هَذَا خَطٌّ رَأْسِيٌّ، كَخَيْطٍ يَتَدَلَّى مِنْهُ ثِقْلٌ.",
  "dr.3": "هَذَا خَطٌّ مَائِلٌ. وَالثَّلَاثَةُ كُلُّهَا خُطُوطٌ مُسْتَقِيمَةٌ.",
  "game.01": "لُعْبَةُ: سِيَاجُ فَوْضَى!",
  "gm.q": "أَيُّ سِيَاجٍ مُغْلَقٌ يَمْنَعُ الأَغْنَامَ مِنَ الهَرَبِ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى أَنْوَاعِ الخُطُوطِ.",
  "pr.1": "أَيُّ خَطٍّ مُسْتَقِيمٌ؟",
  "pr.2": "أَيُّ خَطٍّ مُنْحَنٍ؟",
  "pr.3": "أَيُّ خَطٍّ مُنْكَسِرٌ؟",
  "pr.4": "أَيُّ خَطٍّ مَفْتُوحٌ؟",
  "pr.5": "أَيُّ خَطٍّ أُفُقِيٌّ؟",
  "pr.6": "أَيُّ خَطٍّ رَأْسِيٌّ؟",
  "pr.7": "أَيُّ خَطٍّ مَائِلٌ؟",
  "ch.find": "اخْتَارَتْ فَوْضَى هَذَا الرَّسْمَ وَقَالَتْ: هَذَا خَطٌّ مُنْحَنٍ. أَيُّ خَطٍّ مُنْحَنٍ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! خَطِّي أَجْزَاؤُهُ مُسْتَقِيمَةٌ، فَهُوَ مُنْكَسِرٌ لَا مُنْحَنٍ."
  ],
  "ch.right": "الخَطُّ المُنْكَسِرُ أَجْزَاؤُهُ مُسْتَقِيمَةٌ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ خَطٍّ غَيْرِ مُسْتَقِيمٍ مُنْحَنٍ."
  ],
  "ms.3": "لِمَاذَا الخَطُّ الأَوَّلُ مُنْكَسِرٌ وَلَيْسَ مُنْحَنِيًا؟",
  "ms.3a": "لِأَنَّ أَجْزَاءَهُ مُسْتَقِيمَةٌ تَلْتَقِي عِنْدَ زَوَايَا.",
  "ms.3b": "لِأَنَّهُ أَطْوَلُ مِنَ الخَطِّ الثَّانِي بِقَلِيلٍ.",
  "ms.3c": "لِأَنَّهُ مَرْسُومٌ بِقَلَمٍ آخَرَ.",
  "ms.4": "لِمَاذَا الخَطُّ الأَوَّلُ مَفْتُوحٌ؟",
  "ms.4a": "لِأَنَّ فِيهِ فَتْحَةً صَغِيرَةً.",
  "ms.4b": "لِأَنَّهُ لَيْسَ دَائِرِيًّا كَالخَطِّ الثَّانِي.",
  "ms.4c": "لِأَنَّ لَهُ زَوَايَا كَثِيرَةً.",
  "ms.5": "هَلِ الخَطُّ المَائِلُ خَطٌّ مُسْتَقِيمٌ؟",
  "ms.5a": "نَعَمْ: هُوَ مُسْتَقِيمٌ بِوَضْعٍ مَائِلٍ.",
  "ms.5b": "لَا: المُسْتَقِيمُ هُوَ الأُفُقِيُّ وَالرَّأْسِيُّ فَقَطْ.",
  "ms.5c": "لَا: المَائِلُ خَطٌّ مُنْكَسِرٌ.",
  "ms.recall": "المَشْدُودُ مُسْتَقِيمٌ، وَالمُتَمَوِّجُ مُنْحَنٍ، وَالمَثْنِيُّ بِزَوَايَا مُنْكَسِرٌ.",
  "ms.recall2": "المُغْلَقُ تَلْتَقِي بِدَايَتُهُ بِنِهَايَتِهِ، وَالمَفْتُوحُ لَا تَلْتَقِي بِدَايَتُهُ بِنِهَايَتِهِ.",
  "ms.recall3": "الأُفُقِيُّ كَسَطْحِ المَاءِ، وَالرَّأْسِيُّ كَخَيْطٍ يَتَدَلَّى، وَالمَائِلُ بَيْنَهُمَا.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} أَنْوَاعَ الخُطُوطِ وَأَوْضَاعَهَا. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "مَدَدْنَا فِي حَيِّ الطُّرُقِ ثَلَاثَةَ طُرُقٍ: مُسْتَقِيمًا وَمُنْحَنِيًا وَمُنْكَسِرًا!",
  "wrap.home": [
