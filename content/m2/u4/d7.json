  "ask": "bag.ask",
  "adult": "ورقة مستطيلة ومقص آمن، وتانغرام ورقي إن أمكن.",
  "screenPath": "على الشاشة يعيد الطفل المستطيل المقصوص، ويركّب من مثلثين أشكالاً ويسمّيها، ويعدّ القطع، ويختار من مدينة المضلعات أشياء يسمّيها؛ والقصّ الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ",
  "bagScissors": "مِقَصٌّ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ وَمِقَصٌّ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "cr.01": [
   "chaos",
   "قَصَصْتُ المُسْتَطِيلَ بِقُطْرِهِ، فَضَاعَ المُسْتَطِيلُ!"
  ],
  "cr.02": "هَلْ ضَاعَ؟ {اِلْمِسِ|اِلْمِسِي} المُثَلَّثَيْنِ لِنُعِيدَهُمَا.",
  "cr.03": "عَادَ المُسْتَطِيلُ: المُثَلَّثَانِ بِلَا فَرَاغٍ وَلَا تَرَاكُبٍ يَصْنَعَانِهِ.",
  "mat.01": "{قُصَّ|قُصِّي} الوَرَقَةَ بِالمِقَصِّ عَلَى قُطْرِهَا، ثُمَّ {ضَعْ|ضَعِي} قِطْعَةً عَلَى قِطْعَةٍ: هَلْ تَتَطَابَقُ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "cs.01": "نُرَكِّبُ مِنَ المُثَلَّثَيْنِ أَشْكَالًا: نُلْصِقُ ضِلْعَيْنِ مُتَسَاوِيَيْنِ فَقَطْ. {اِلْمِسْ|اِلْمِسِي} كُلَّ شَكْلٍ.",
  "cs.02": "مِنَ المُثَلَّثَيْنِ نَفْسَيْهِمَا صَنَعْنَا أَشْكَالًا مُخْتَلِفَةً!",
  "tm.01": "مُرَبَّعَانِ مُتَجَاوِرَانِ. أَيْنَ نُلْصِقُ مُرَبَّعًا ثَالِثًا، ضِلْعًا بِضِلْعٍ؟ {اِلْمِسْ|اِلْمِسِي} كُلَّ مَوْضِعٍ.",
  "tm.02": "المَقْلُوبُ وَالمُدَوَّرُ شَكْلٌ وَاحِدٌ: فَالأَشْكَالُ اثْنَانِ فَقَطْ، مُسْتَقِيمٌ وَزَاوِيَةٌ.",
  "pc.00": "هَذِهِ مَدِينَةُ المُضَلَّعَاتِ.",
  "pc.01": "{اِخْتَرْ|اِخْتَارِي} شَيْئًا مِنَ المَدِينَةِ: {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pc.02": "سَمَّيْنَاهُ، وَعَرَفْنَا: مُنْتَظِمٌ أَمْ لَا.",
  "pc.03": "صَارَ لِأَشْيَاءِ المَدِينَةِ أَسْمَاؤُهَا!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى التَّفْكِيكِ وَالتَّرْكِيبِ.",
  "pr.parts": "قَصَصْنَا الشَّكْلَ عَلَى الخُطُوطِ المُتَقَطِّعَةِ. كَمْ قِطْعَةً صَارَ؟",
  "pr.comp": "لَصَقْنَا مُثَلَّثَيْنِ قَائِمَيْنِ مُتَطَابِقَيْنِ. مَا اسْمُ الشَّكْلِ الجَدِيدِ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "pr.mino4": "تَحَدٍّ: بِأَرْبَعَةِ مُرَبَّعَاتٍ مُتَجَاوِرَةٍ ضِلْعًا بِضِلْعٍ: كَمْ شَكْلًا مُخْتَلِفًا نَصْنَعُ؟",
  "pr.reg": "هَلْ هَذَا المُضَلَّعُ مُنْتَظِمٌ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "ch.find": "تَقُولُ فَوْضَى: لَصَقْتُ مُثَلَّثَيْنِ فَصَارَا مُثَلَّثًا كَبِيرًا! {قِسْ|قِيسِي}: مَا اسْمُ الشَّكْلِ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! صَارَ لَهُ أَرْبَعَةُ أَضْلَاعٍ."
  ],
  "ch.right": "نَعُدُّ أَضْلَاعَ الشَّكْلِ الجَدِيدِ، ثُمَّ نَفْحَصُهُ.",
  "ch.wrong": [
   "chaos",
   "المُثَلَّثَانِ يَصْنَعَانِ مُثَلَّثًا دَائِمًا."
  ],
  "ms.2": "قَصَصْنَا المُسْتَطِيلَ بِقُطْرِهِ. هَلْ ضَاعَ المُسْتَطِيلُ؟",
  "ms.2a": "لَا: نُعِيدُ المُثَلَّثَيْنِ بِلَا فَرَاغٍ فَيَعُودُ.",
  "ms.2b": "نَعَمْ: صَارَ مُثَلَّثَيْنِ، وَلَنْ يَعُودَ مُسْتَطِيلًا أَبَدًا.",
  "ms.2c": "نَعَمْ: لِأَنَّ القُطْرَ أَطْوَلُ مِنْ كُلِّ أَضْلَاعِ المُسْتَطِيلِ.",
  "ms.recall": "نُفَكِّكُ الشَّكْلَ إِلَى قِطَعٍ، وَنُرَكِّبُ القِطَعَ شَكْلًا بِلَا فَرَاغٍ وَلَا تَرَاكُبٍ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُفَكِّكُ|صِرْتِ تُفَكِّكِينَ} الأَشْكَالَ وَ{تُرَكِّبُهَا|تُرَكِّبِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "بَنَيْنَا مَدِينَةَ المُضَلَّعَاتِ قِطْعَةً قِطْعَةً!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} مُسْتَطِيلًا عَلَى وَرَقَةٍ، وَ{قُصَّهُ|قُصِّيهِ} بِقُطْرِهِ، ثُمَّ {رَكِّبْ|رَكِّبِي} مِنَ المُثَلَّثَيْنِ ثَلَاثَةَ أَشْكَالٍ مُخْتَلِفَةٍ، وَ{سَمِّهَا|سَمِّيهَا}."
  ]
 },
