 "concepts": {
  "C212": "المتر المربع وحدةً لمساحة الأراضي (دون تحويل بين السنتيمتر المربع والمتر المربع)، منقول من د6؛ ومشروع «خطّط أرضك»"
 },
 "bag": {
  "items": [
