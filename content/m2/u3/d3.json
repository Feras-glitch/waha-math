  "ask": "bag.ask",
  "adult": "ساعة حائط أو ساعة ورقية بعقربين يدوران.",
  "screenPath": "على الشاشة يفتح الطفل الباب حتى الخط المستقيم، ويلوّن أرباع القرص بدرجاتها، ويرى عقرباً يدور دورة كاملة؛ وعقربا الساعة الحقيقية في مسار «معي»."
 },
 "labels": {
  "bagClock": "سَاعَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} سَاعَةُ حَائِطٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "{اِلْمِسِ|اِلْمِسِي} البَابَ لِيَنْفَتِحَ أَكْثَرَ وَأَكْثَرَ.",
  "hook.02": "صَارَ البَابُ وَالجِدَارُ عَلَى خَطٍّ وَاحِدٍ: نِصْفُ دَوْرَةٍ. وَهَذِهِ زَاوِيَةٌ أَيْضًا، لَهَا رَأْسٌ وَضِلْعَانِ.",
  "mat.01": "{أَدِرْ|أَدِيرِي} عَقْرَبَ السَّاعَةِ نِصْفَ دَوْرَةٍ، ثُمَّ دَوْرَةً كَامِلَةً حَتَّى يَعُودَ إِلَى مَكَانِهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "dd.01": "نَقِيسُ الزَّاوِيَةَ بِالدَّرَجَةِ: الدَّوْرَةُ الكَامِلَةُ ثَلَاثُمِئَةٍ وَسِتُّونَ دَرَجَةً صَغِيرَةً. {اِلْمِسِ|اِلْمِسِي} القُرْصَ.",
  "dd.02": "رُبْعُ الدَّوْرَةِ تِسْعُونَ دَرَجَةً، وَنِصْفُهَا مِئَةٌ وَثَمَانُونَ، وَالدَّوْرَةُ الكَامِلَةُ ثَلَاثُمِئَةٍ وَسِتُّونَ.",
  "ck.01": "سَاعَتَانِ: {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ وَ{اُنْظُرْ|اُنْظُرِي} إِلَى عَقْرَبِ السَّاعَةِ الأُولَى.",
  "ck.02": "لَمْ يَتَحَرَّكْ عَقْرَبُ السَّاعَةِ الأُولَى. {اِلْمِسْ|اِلْمِسِي} مِنْ جَدِيدٍ.",
  "ck.03": "وَعَقْرَبُ السَّاعَةِ الثَّانِيَةِ دَارَ دَوْرَةً كَامِلَةً وَعَادَ إِلَى مَكَانِهِ.",
  "ck.04": "الشَّكْلُ وَاحِدٌ فِي السَّاعَتَيْنِ! الزَّاوِيَةُ تَقِيسُ الدَّوَرَانَ: الأُولَى صِفْرِيَّةٌ، وَالثَّانِيَةُ كَامِلَةٌ. وَالصِّفْرِيَّةُ لِلْفُضُولِ فَقَطْ.",
  "game.01": "لُعْبَةُ: كَمْ دَارَ القُرْصُ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الدَّرَجَاتِ وَأَنْوَاعِ الزَّوَايَا.",
  "pr.deg": "كَمْ دَرَجَةً هَذَا الجُزْءُ المُلَوَّنُ مِنَ الدَّوْرَةِ؟",
  "pr.kind": "مَا نَوْعُ هَذِهِ الزَّاوِيَةِ؟",
  "pk.straight": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ مُسْتَقِيمَةٌ؟",
  "ch.find": "تَقُولُ فَوْضَى: هَذِهِ لَيْسَتْ زَاوِيَةً، هَذَا خَطٌّ! مَا نَوْعُ هَذِهِ الزَّاوِيَةِ؟",
  "ch.after": [
   "chaos",
   "آه! لَهَا رَأْسٌ وَضِلْعَانِ، فَهِيَ زَاوِيَةٌ مُسْتَقِيمَةٌ."
  ],
  "ch.right": "المُسْتَقِيمَةُ زَاوِيَةٌ: نِصْفُ دَوْرَةٍ، وَلَهَا رَأْسٌ وَضِلْعَانِ.",
  "ch.wrong": [
   "chaos",
   "الخَطُّ المُسْتَقِيمُ لَا يَكُونُ زَاوِيَةً أَبَدًا."
  ],
  "ms.3": "لِمَاذَا المُسْتَقِيمَةُ زَاوِيَةٌ مَعَ أَنَّ شَكْلَهَا خَطٌّ؟",
  "ms.3a": "لِأَنَّ لَهَا رَأْسًا وَضِلْعَيْنِ.",
  "ms.3b": "لِأَنَّ كُلَّ خَطٍّ مُسْتَقِيمٍ زَاوِيَةٌ وَإِنْ لَمْ يَكُنْ لَهُ رَأْسٌ.",
  "ms.3c": "لِأَنَّهَا أَقْصَرُ مِنْ سَائِرِ الزَّوَايَا.",
  "ms.recall": "نِصْفُ الدَّوْرَةِ زَاوِيَةٌ مُسْتَقِيمَةٌ، وَالدَّوْرَةُ كُلُّهَا زَاوِيَةٌ كَامِلَةٌ.",
  "ms.recall2": "رُبْعُ الدَّوْرَةِ تِسْعُونَ دَرَجَةً، وَنِصْفُهَا مِئَةٌ وَثَمَانُونَ، وَكُلُّهَا ثَلَاثُمِئَةٍ وَسِتُّونَ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} الدَّرَجَةَ وَالمُسْتَقِيمَةَ وَالكَامِلَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "دَارَ فِي حَيِّ الزَّوَايَا عَقْرَبُ السَّاعَةِ دَوْرَةً كَامِلَةً!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَدِرْ|أَدِيرِي} عَقْرَبَ السَّاعَةِ نِصْفَ دَوْرَةٍ، ثُمَّ دَوْرَةً كَامِلَةً، وَ{قُلْ|قُولِي} كَمْ دَرَجَةً دَارَ."
  ]
 },
