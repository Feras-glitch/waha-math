  "ask": "bag.ask",
  "adult": "شريط قياس وورقة وقلم لجدول القياسات ومخطط الغرفة.",
  "screenPath": "على الشاشة يتعرّف الطفل مراجعه الشخصية، ويقدّر ثم يقيس، ويرتّب، ويقرأ مخطط غرفة، ويصمّم مضمار كيلومتر؛ والقياس الحقيقي والمخطط في مسار «معي»."
 },
 "labels": {
  "bagTape": "شَرِيطُ قِيَاسٍ",
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ وَوَرَقَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "rf.01": "قَبْلَ أَنْ نَقِيسَ نُقَدِّرُ. وَلِلتَّقْدِيرِ مَرَاجِعُ مِنَ الجِسْمِ وَالبَيْتِ:",
  "rf.02": "نُقَارِنُ الشَّيْءَ بِمَرْجِعٍ نَعْرِفُ طُولَهُ، فَيَقْرُبُ تَقْدِيرُنَا مِنَ القِيَاسِ.",
  "rp.01": "هَذَا مُخَطَّطُ غُرْفَةٍ مِنَ الأَعْلَى. نَكْتُبُ طُولَ كُلِّ جِدَارٍ عَلَيْهِ.",
  "rp.02": "الجِدَارَانِ المُتَقَابِلَانِ لَهُمَا الطُّولُ نَفْسُهُ.",
  "rp.03": "مُخَطَّطٌ بِلَا مِقْيَاسِ رَسْمٍ: الأَطْوَالُ مَكْتُوبَةٌ، لَا مَرْسُومَةٌ بِحَجْمِهَا.",
  "mat.01": "{قَدِّرْ|قَدِّرِي} ثُمَّ {قِسْ|قِيسِي} بِشَرِيطِ القِيَاسِ أَشْيَاءَ فِي البَيْتِ، {وَاكْتُبْ|وَاكْتُبِي} فِي جَدْوَلٍ عَلَى الوَرَقَةِ: الشَّيْءُ، وَالتَّقْدِيرُ، وَالقِيَاسُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: قِيَاسُ مَدِينَتِي! نُقَدِّرُ أَوَّلًا، ثُمَّ نَقِيسُ.",
  "trk.01": "الإِبْدَاعُ: مِضْمَارُ سِبَاقٍ طُولُهُ كِيلُومِتْرٌ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى التَّقْدِيرِ وَالقِيَاسِ.",
  "pr.est": "{قَدِّرْ|قَدِّرِي} قَبْلَ القِيَاسِ:",
  "pr.tape": "وَالآنَ القِيَاسُ: كَمْ طُولُهُ؟ {اِقْرَأْ|اِقْرَئِي} شَرِيطَ القِيَاسِ.",
  "pr.order": "{رَتِّبْ|رَتِّبِي} أَشْيَاءَ المَدِينَةِ: {اِلْمِسِ|اِلْمِسِي} الأَقْصَرَ أَوَّلًا، ثُمَّ الأَطْوَلَ فَالأَطْوَلَ.",
  "pr.track": "{صَمِّمْ|صَمِّمِي} مِضْمَارًا مِنْ أَرْبَعَةِ مَقَاطِعَ مُخْتَلِفَةِ الطُّولِ، مَجْمُوعُهَا أَلْفُ مِتْرٍ، ثُمَّ «تَمَّ».",
  "pr.track3": "وَالآنَ مِضْمَارٌ مِنْ ثَلَاثَةِ مَقَاطِعَ مُخْتَلِفَةِ الطُّولِ، مَجْمُوعُهَا أَلْفُ مِتْرٍ. ثُمَّ «تَمَّ».",
  "ch.find": "قَدَّرَتْ فَوْضَى ارْتِفَاعَ البَابِ بِعِشْرِينَ سَنْتِيمِتْرًا! {قَدِّرْ|قَدِّرِي} {أَنْتَ|أَنْتِ}:",
  "ch.after": [
   "chaos",
   "آه! البَابُ أَطْوَلُ مِنِّي، وَأَنَا أَطْوَلُ مِنْ عِشْرِينَ سَنْتِيمِتْرًا."
  ],
  "ch.right": "نُقَارِنُ بِمَرْجِعٍ: البَابُ مِتْرَانِ تَقْرِيبًا.",
  "ch.wrong": [
   "chaos",
   "التَّقْدِيرُ ظَنٌّ، فَأَيُّ عَدَدٍ يَصْلُحُ."
  ],
  "ms.1": "لِمَاذَا نُقَدِّرُ قَبْلَ أَنْ نَقِيسَ؟",
  "ms.1a": "لِنَعْرِفَ هَلْ قِيَاسُنَا مَعْقُولٌ.",
  "ms.1b": "لِأَنَّ التَّقْدِيرَ أَدَقُّ مِنَ القِيَاسِ.",
  "ms.1c": "لِنَسْتَغْنِيَ عَنِ المِسْطَرَةِ تَمَامًا.",
  "ms.recall": "نُقَارِنُ بِمَرْجِعٍ نَعْرِفُ طُولَهُ: عَرْضُ الإِصْبَعِ سَنْتِيمِتْرٌ تَقْرِيبًا، وَالبَابُ مِتْرَانِ تَقْرِيبًا.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُقَدِّرُ|صِرْتِ تُقَدِّرِينَ} ثُمَّ {تَقِيسُ|تَقِيسِينَ}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "قِسْنَا مَدِينَتَنَا: قَدَّرْنَا، ثُمَّ قِسْنَا، ثُمَّ رَتَّبْنَا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} مُخَطَّطَ {غُرْفَتِكَ|غُرْفَتِكِ}، {وَاكْتُبْ|وَاكْتُبِي} عَلَى كُلِّ جِدَارٍ طُولَهُ بَعْدَ أَنْ {تُقَدِّرَهُ|تُقَدِّرِيهِ} {وَتَقِيسَهُ|وَتَقِيسِيهِ}."
  ]
 },
