 "adultCard": {
  "title": "تصنيف أشياء البيت",
  "how": "ضعوا على الصينية ثمانية أشياء مسطّحة، واطلبوا منه أن يضعها في أربع مجموعات حسب شكلها، ثم أجيبوا:",
  "qs": [
   "هل وضع كل شيء في مجموعة شكله، لا لونه ولا اسمه؟",
   "هل عدّ الرؤوس أو قارن الأضلاع بإصبعه حين تردّد؟",
   "هل قال لماذا وضع الشيء في مجموعته؟"
  ],
  "concept": "C005"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} صِينِيَّةٌ وَأَشْيَاءُ مُسَطَّحَةٌ مِنَ البَيْتِ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "هِيهِي!"
  ],
  "hook.02": "فَوْضَى بَعْثَرَتْ أَشْيَاءَ البَيْتِ! نَحْنُ صَيَّادُو الأَشْكَالِ: نَنْظُرُ إِلَى شَكْلِ كُلِّ شَيْءٍ، لَا إِلَى لَوْنِهِ وَلَا إِلَى اسْمِهِ.",
  "mat.01": "{ضَعْ|ضَعِي} أَشْيَاءَ البَيْتِ عَلَى الصِّينِيَّةِ فِي أَرْبَعِ مَجْمُوعَاتٍ: دَوَائِرُ، وَمُرَبَّعَاتٌ، وَمُثَلَّثَاتٌ، وَمُسْتَطِيلَاتٌ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "وَالآنَ نَصْطَادُ عَلَى الشَّاشَةِ.",
  "hunt.01": "{اِلْمَسْ|اِلْمَسِي} شَيْئًا، ثُمَّ {اِلْمَسْ|اِلْمَسِي} سَلَّةَ شَكْلِهِ.",
  "hunt.02": "صَيْدٌ رَائِعٌ! كُلُّ شَيْءٍ فِي سَلَّةِ شَكْلِهِ.",
  "sp.01": "{عُدَّ|عُدِّي} الدَّوَائِرَ: {اِلْمَسْ|اِلْمَسِي} كُلَّ وَاحِدَةٍ مَرَّةً.",
  "sp.02": "خَمْسُ دَوَائِرَ.",
  "sp.03": "هَلْ صَارَتْ أَكْثَرَ؟ هَيَّا نَعُدُّ مِنْ جَدِيدٍ.",
  "sp.04": "مَا زَالَتْ خَمْسًا!",
  "sp.05": "صَفٌّ، أَوْ دَائِرَةٌ، أَوْ مُبَعْثَرَةٌ: العَدَدُ لَا يَتَغَيَّرُ إِذَا تَغَيَّرَ التَّرْتِيبُ.",
  "pd.01": "وَالآنَ: أَعْطِنِي خَمْسَةَ مُثَلَّثَاتٍ مِنَ الكَوْمَةِ.",
  "pr.intro": "أَرْبَعُ سِلَالٍ: لِلدَّوَائِرِ، وَلِلْمُرَبَّعَاتِ، وَلِلْمُثَلَّثَاتِ، وَلِلْمُسْتَطِيلَاتِ. هَيَّا نَتَمَرَّنُ.",
  "acc.sq": "نَعَمْ، هُوَ مُسْتَطِيلٌ. وَلَهُ اسْمٌ أَخَصُّ: مُرَبَّعٌ.",
  "why.c": "حَافَّتُهُ مُنْحَنِيَةٌ، وَلَا رُؤُوسَ لَهُ.",
  "why.sq": "أَرْبَعَةُ أَضْلَاعٍ مُتَسَاوِيَةٍ.",
  "why.t": "ثَلَاثَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ.",
  "why.r": "ضِلْعَانِ طَوِيلَانِ وَضِلْعَانِ قَصِيرَانِ.",
  "ch.after": "ضِلْعَانِ أَطْوَلُ مِنَ الآخَرَيْنِ: مَكَانُهُ سَلَّةُ المُسْتَطِيلَاتِ.",
  "ch.right": "الظَّرْفُ مُسْتَطِيلٌ: ضِلْعَانِ طَوِيلَانِ وَضِلْعَانِ قَصِيرَانِ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ شَيْءٍ بِأَرْبَعَةِ أَضْلَاعٍ مُرَبَّعٌ."
  ],
  "ms.basket": "أَيُّ هَذِهِ الأَشْيَاءِ مُثَلَّثَةُ الشَّكْلِ؟ {اِلْمَسْهَا|اِلْمَسِيهَا} كُلَّهَا، ثُمَّ «تَمَّ».",
  "ms.recallC": "نَنْظُرُ إِلَى الشَّكْلِ: الدَّائِرَةُ بِلَا رُؤُوسٍ، وَالمُثَلَّثُ ثَلَاثَةُ أَضْلَاعٍ، وَالمُرَبَّعُ أَضْلَاعُهُ مُتَسَاوِيَةٌ، وَالمُسْتَطِيلُ طَوِيلَانِ وَقَصِيرَانِ.",
  "ms.recallN": "إِذَا تَحَرَّكَتِ الأَشْيَاءُ فَقَطْ، بَقِيَ العَدَدُ كَمَا هُوَ. وَإِذَا جَاءَ شَيْءٌ جَدِيدٌ، تَغَيَّرَ.",
  "ms.ok": "رَائِعٌ! {أَنْتَ صَيَّادٌ|أَنْتِ صَيَّادَةٌ} لِلْأَشْكَالِ، {وَتَعُدُّ|وَتَعُدِّينَ} بِدِقَّةٍ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَارَ فِي الوَاحَةِ حَدِيقَةٌ مِنَ الأَشْكَالِ الأَرْبَعَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِصْطَدْ|اِصْطَادِي} مَعَ الكِبَارِ ثَلَاثَةَ أَشْيَاءَ مُسَطَّحَةٍ لِكُلِّ شَكْلٍ، وَ{عُدَّ|عُدِّي} مَا فِي كُلِّ مَجْمُوعَةٍ."
  ]
 },
