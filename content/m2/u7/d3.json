  "ask": "bag.ask",
  "adult": "ورق مربعات (مربعات 1 سم) ومقص آمن.",
  "screenPath": "على الشاشة يغطّي الطفل الأشكال بالبلاط ويعدّه، ويقدّر بأنصاف المربعات، ويرسم مستطيلاً بمساحة معلومة؛ والقصّ والتغطية الحقيقيان في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagCut": "مِقَصٌّ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِقَصٌّ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "tc.01": "نُغَطِّي هَذِهِ الأَرْضَ بِبَلَاطٍ مُرَبَّعٍ، ضِلْعُ كُلِّ بَلَاطَةٍ سَنْتِيمِتْرٌ، بِلَا فَرَاغٍ وَلَا تَرَاكُبٍ.",
  "tc.02": "عَدَدُ البَلَاطَاتِ هُوَ المَسَاحَةُ. وَوَحْدَتُهَا: السَّنْتِيمِتْرُ المُرَبَّعُ.",
  "tc.03": "الخَيْطُ لِلْمُحِيطِ حَوْلَ الشَّكْلِ، وَالبَلَاطُ لِلْمَسَاحَةِ دَاخِلَهُ.",
  "hs.01": "وَفِي هَذَا الشَّكْلِ أَنْصَافُ مُرَبَّعَاتٍ مَائِلَةٌ.",
  "hs.02": "كُلُّ نِصْفَيْنِ مُرَبَّعٌ كَامِلٌ. نَعُدُّ الكَامِلَةَ، ثُمَّ نَضُمُّ الأَنْصَافَ.",
  "mat.01": "{قُصَّ|قُصِّي} بِالمِقَصِّ مُرَبَّعَاتٍ صَغِيرَةً مِنْ وَرَقِ المُرَبَّعَاتِ، {وَغَطِّ|وَغَطِّي} بِهَا شَكْلًا بِلَا فَرَاغٍ، {وَعُدَّهَا|وَعُدِّيهَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: مُبَلِّطُ الأَرْضِيَّاتِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المَسَاحَةِ.",
  "pr.area": "ضِلْعُ كُلِّ مُرَبَّعٍ سَنْتِيمِتْرٌ. كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ الشَّكْلِ؟",
  "pr.est": "{قَدِّرْ|قَدِّرِي}: كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ الشَّكْلِ تَقْرِيبًا؟",
  "pr.unitPA": "بِأَيِّ وَحْدَةٍ نَكْتُبُ:",
  "pr.drawA": "{اُرْسُمْ|اُرْسُمِي} مُسْتَطِيلًا عَلَى الشَّبَكَةِ: {اِلْمِسْ|اِلْمِسِي} رُكْنَهُ المُقَابِلَ لِلنُّقْطَةِ. مَسَاحَتُهُ:",
  "ch.find": "قَالَتْ فَوْضَى: مَسَاحَةُ الشَّكْلِ هِيَ مُحِيطُهُ! كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَتُهُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! المَسَاحَةُ نَعُدُّ فِيهَا المُرَبَّعَاتِ دَاخِلَ الشَّكْلِ."
  ],
  "ch.right": "المُحِيطُ بِالخَيْطِ حَوْلَ الشَّكْلِ، وَالمَسَاحَةُ بِالبَلَاطِ دَاخِلَهُ.",
  "ch.wrong": [
   "chaos",
   "المُحِيطُ وَالمَسَاحَةُ شَيْءٌ وَاحِدٌ."
  ],
  "ms.1": "لِمَاذَا وَحْدَةُ المَسَاحَةِ سَنْتِيمِتْرٌ مُرَبَّعٌ، لَا سَنْتِيمِتْرٌ؟",
  "ms.1a": "لِأَنَّنَا نَعُدُّ مُرَبَّعَاتٍ ضِلْعُ كُلٍّ مِنْهَا سَنْتِيمِتْرٌ.",
  "ms.1b": "لِأَنَّ المَسَاحَةَ أَطْوَلُ مِنَ المُحِيطِ دَائِمًا.",
  "ms.1c": "لِأَنَّ الشَّكْلَ يَجِبُ أَنْ يَكُونَ مُرَبَّعًا.",
  "ms.2": "كَيْفَ نُقَدِّرُ مَسَاحَةَ شَكْلٍ فِيهِ أَنْصَافُ مُرَبَّعَاتٍ؟",
  "ms.2a": "نَعُدُّ الكَامِلَةَ، وَكُلُّ نِصْفَيْنِ مُرَبَّعٌ.",
  "ms.2b": "نَعُدُّ الأَنْصَافَ مُرَبَّعَاتٍ كَامِلَةً.",
  "ms.2c": "نَتْرُكُ الأَنْصَافَ، فَهِيَ لَا تُعَدُّ.",
  "ms.recall": "المَسَاحَةُ عَدَدُ المُرَبَّعَاتِ الَّتِي تُغَطِّي الشَّكْلَ بِلَا فَرَاغٍ وَلَا تَرَاكُبٍ.",
  "ms.recall2": "نَعُدُّ مُرَبَّعَاتٍ، فَالوَحْدَةُ مُرَبَّعَةٌ: سَنْتِيمِتْرٌ مُرَبَّعٌ.",
  "ms.recall3": "نَعُدُّ المُرَبَّعَاتِ الكَامِلَةَ، وَكُلُّ نِصْفَيْنِ مُرَبَّعٌ وَاحِدٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعُدُّ|صِرْتِ تَعُدِّينَ} المَسَاحَةَ {وَتُقَدِّرُهَا|وَتُقَدِّرِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "بَلَّطْنَا الأَرْضِيَّاتِ: لَا فَرَاغَ وَلَا تَرَاكُبَ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {عُدَّ|عُدِّي} بَلَاطَ أَرْضِ المَطْبَخِ أَوْ جُزْءٍ مِنْهَا، {وَقُلْ|وَقُولِي} {لِأَهْلِكَ|لِأَهْلِكِ}: كَمْ بَلَاطَةً؟"
  ]
 },
