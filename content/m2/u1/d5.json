{
 "id": "m2.u1.d5",
 "title": "الشُّعَاعُ",
 "icon": [
  "georay"
 ],
 "concepts": {
  "C110": "الشعاع: له بداية ولا نهاية له، وتسميته المرتّبة (البداية أولاً)"
 },
 "bag": {
  "items": [
   {
    "icon": "torch",
    "label": "bagTorch"
   }
  ],
  "ask": "bag.ask",
  "adult": "مصباح يدوي ومكان معتم قليلاً.",
  "screenPath": "على الشاشة يضيء الطفل مصباحاً فيمتدّ شعاعه، ويرسم الشعاع بلمس بدايته أولاً، ويضيء النجوم التي على امتداده؛ والمصباح الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagTorch": "مِصْبَاحٌ يَدَوِيٌّ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِصْبَاحٌ يَدَوِيٌّ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "الغُرْفَةُ مُعْتِمَةٌ. {اِلْمِسِ|اِلْمِسِي} المِصْبَاحَ لِنُضِيئَهُ.",
  "hook.02": "لِلضَّوْءِ بِدَايَةٌ عِنْدَ المِصْبَاحِ، ثُمَّ يَمْتَدُّ وَلَا يَتَوَقَّفُ. خَطٌّ لَهُ بِدَايَةٌ وَلَيْسَ لَهُ نِهَايَةٌ نُسَمِّيهِ: شُعَاعًا.",
  "mat.01": "{أَضِئِ|أَضِيئِي} المِصْبَاحَ فِي مَكَانٍ مُعْتِمٍ، وَ{اُنْظُرْ|اُنْظُرِي}: أَيْنَ يَبْدَأُ الضَّوْءُ؟ وَهَلْ يَتَوَقَّفُ قَبْلَ الجِدَارِ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "ro.01": "نُسَمِّي الشُّعَاعَ بِحَرْفَيْنِ: البِدَايَةُ أَوَّلًا. {اِلْمِسِ|اِلْمِسِي} النُّقْطَةَ أَلِف ثُمَّ النُّقْطَةَ بَاء.",
  "ro.02": "هَذَا هُوَ الشُّعَاعُ أَلِف بَاء: يَبْدَأُ مِنْ أَلِف، وَيَمُرُّ بِالنُّقْطَةِ بَاء، وَيَمْتَدُّ بَعْدَهَا.",
  "ro.03": "وَالآنَ بِالعَكْسِ: {اِلْمِسِ|اِلْمِسِي} النُّقْطَةَ بَاء ثُمَّ النُّقْطَةَ أَلِف.",
  "ro.04": "هَذَا هُوَ الشُّعَاعُ بَاء أَلِف: يَبْدَأُ مِنْ بَاء وَيَذْهَبُ فِي الجِهَةِ الأُخْرَى. فَالشُّعَاعُ أَلِف بَاء غَيْرُ الشُّعَاعِ بَاء أَلِف.",
  "wk.intro": "قِطْعَةٌ وَشُعَاعٌ. {اِلْمِسْ|اِلْمِسِي} كُلَّ رَسْمٍ.",
  "wk.1": "لِلْقِطْعَةِ المُسْتَقِيمَةِ طَرَفَانِ: بِدَايَةٌ وَنِهَايَةٌ، وَطُولُهَا يُقَاسُ.",
  "wk.2": "لِلشُّعَاعِ بِدَايَةٌ وَسَهْمٌ: السَّهْمُ يَقُولُ إِنَّهُ يَمْتَدُّ بِلَا نِهَايَةٍ، فَلَا يُقَاسُ طُولُهُ.",
  "game.01": "لُعْبَةُ: شُعَاعُ المِصْبَاحِ!",
  "gm.q": "المِصْبَاحُ عِنْدَ النُّقْطَةِ أَلِف، وَالشُّعَاعُ يَمُرُّ بِالنُّقْطَةِ بَاء. أَيَّ نَجْمَةٍ يُضِيءُ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الشُّعَاعِ.",
  "pr.1": "أَيُّ رَسْمٍ شُعَاعٌ؟",
  "pr.2": "مَا اسْمُ هَذَا الرَّسْمِ؟",
  "pr.3": "أَيُّ رَسْمٍ قِطْعَةٌ مُسْتَقِيمَةٌ؟",
  "ch.find": "رَسَمَتْ فَوْضَى شُعَاعًا يَبْدَأُ مِنْ أَلِف وَقَالَتْ: هَذَا هُوَ الشُّعَاعُ بَاء أَلِف! {اِلْمِسِ|اِلْمِسِي} النُّقْطَتَيْنِ بِالتَّرْتِيبِ لِنَرْسُمَ الشُّعَاعَ:",
  "ch.after": [
   "chaos",
   "آه! البِدَايَةُ أَوَّلًا فِي الاِسْمِ."
  ],
  "ch.right": "فِي اسْمِ الشُّعَاعِ نَبْدَأُ بِنُقْطَةِ بِدَايَتِهِ.",
  "ch.wrong": [
   "chaos",
   "فِي اسْمِ الشُّعَاعِ نَبْدَأُ بِأَيِّ حَرْفٍ نَشَاءُ."
  ],
  "ms.3": "لِمَاذَا الشُّعَاعُ أَلِف بَاء غَيْرُ الشُّعَاعِ بَاء أَلِف؟",
  "ms.3a": "لِأَنَّ بِدَايَتَيْهِمَا مُخْتَلِفَتَانِ.",
  "ms.3b": "لِأَنَّ أَحَدَهُمَا أَطْوَلُ مِنَ الآخَرِ بِسَنْتِيمِتْرٍ.",
  "ms.3c": "هُمَا شُعَاعٌ وَاحِدٌ بِاسْمَيْنِ.",
  "ms.recall": "لِلشُّعَاعِ بِدَايَةٌ وَلَيْسَ لَهُ نِهَايَةٌ، وَنَبْدَأُ اسْمَهُ بِنُقْطَةِ بِدَايَتِهِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} الشُّعَاعَ وَ{تُسَمِّيهِ|تُسَمِّينَهُ} بِالتَّرْتِيبِ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "أَضَأْنَا فِي حَيِّ الطُّرُقِ مِصْبَاحًا، وَشُعَاعُهُ يَمْتَدُّ وَلَا يَنْتَهِي!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَضِئْ|أَضِيئِي} مِصْبَاحًا فِي غُرْفَةٍ مُعْتِمَةٍ، وَ{قُلْ|قُولِي} لِ{أَهْلِكَ|أَهْلِكِ}: أَيْنَ بِدَايَةُ الشُّعَاعِ؟"
  ]
 },
