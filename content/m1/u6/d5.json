  "ask": "bag.ask",
  "adult": "ورقة تُطوى، ليتحقق الطفل بيديه مما يراه.",
  "screenPath": "لعبة «متحف التماثل» على الشاشة: طيّ ومرآة وإكمال؛ وطيّ الورقة الحقيقية في مسار «معي»."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ نَطْوِيهَا؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "طَوَيْتُ وَقَصَصْتُ {مَعَكَ|مَعَكِ}! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَضَعُ أَنَا الحَجَرَ السَّادِسَ فِي مَكَانِهِ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "mat.01": "{اِطْوِ|اِطْوِي} الوَرَقَةَ مِنْ وَسَطِهَا، وَ{اُنْظُرْ|اُنْظُرِي}: هَلْ غَطَّى جُزْءٌ مِنْهَا الجُزْءَ الآخَرَ تَمَامًا؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "الشَّكْلُ المُتَمَاثِلُ يَنْطَبِقُ نِصْفَاهُ بِالطَّيِّ، وَخَطُّ الطَّيِّ خَطُّ تَمَاثُلِهِ.",
  "rv.02": "وَعَلَى الشَّبَكَةِ نُكْمِلُ النِّصْفَ المُقَابِلَ بِالبُعْدِ نَفْسِهِ عَنِ الخَطِّ.",
  "rv.03": "وَالنِّصْفَانِ قِطْعَتَانِ مُتَطَابِقَتَانِ، وَالضِّعْفُ: العَدَدُ وَمِثْلُهُ.",
  "gm.intro": "مُتْحَفُ التَّمَاثُلِ! {اُنْظُرْ|اُنْظُرِي} إِلَى المَعْرُوضَاتِ.",
  "gm.1": "أَيُّ المَعْرُوضَاتِ مُتَمَاثِلٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "gm.2": "أَيُّ خَطٍّ خَطُّ تَمَاثُلٍ لِهَذَا الشَّكْلِ؟ {اِلْمِسْ|اِلْمِسِي} رَأْسَهُ.",
  "gm.3": "{لَوِّنِ|لَوِّنِي} النِّصْفَ المُقَابِلَ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ أَسْئِلَةِ الوَاحَةِ.",
  "pr.1": "أَيُّ المَعْرُوضَاتِ لَيْسَ مُتَمَاثِلًا؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.2": "{حَرِّكِ|حَرِّكِي} المِرْآةَ حَتَّى يَظْهَرَ الشَّكْلُ كَامِلًا، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.3": "أَيُّ الصُّورَتَيْنِ قُسِمَتْ نِصْفَيْنِ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.4": "عَلَى يَسَارِ الخَطِّ مُرَبَّعَاتٌ مُلَوَّنَةٌ. كَمْ مُرَبَّعًا فِي الشَّكْلِ كُلِّهِ بَعْدَ إِكْمَالِهِ؟",
  "ts.rem": "نَطْوِي مَعَ الكِبَارِ وَرَقًا وَنَقُصُّ أَشْكَالًا، وَنَبْحَثُ عَنْ خَطِّ تَمَاثُلِهَا؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَضَعُ الحَجَرَ السَّادِسَ فِي مَكَانِهِ."
  ],
  "ts.win1": "{أَنْتَ سَيِّدُ المِرْآةِ|أَنْتِ سَيِّدَةُ المِرْآةِ}!",
  "ts.win2": "جَرَى المَاءُ فِي جَدْوَلِ «حَدِيقَةِ المَرَايَا»، وَاخْضَرَّتْ نَخْلَتَانِ!",
  "wrap.01": "جَرَى المَاءُ فِي سِتَّةِ جَدَاوِلَ، وَعَادَ النَّبْعُ إِلَى الوَاحَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِصْنَعْ|اِصْنَعِي} مَعَ {أَهْلِكَ|أَهْلِكِ} مُتْحَفًا صَغِيرًا مِنْ أَشْيَاءَ مُتَمَاثِلَةٍ فِي البَيْتِ."
  ]
 },
