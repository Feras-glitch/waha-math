 "labels": {
  "bagPaper": "رُكْنُ الوَرَقَةِ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} رُكْنُ الوَرَقَةِ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "نَصْنَعُ رُكْنَ الوَرَقَةِ مِنْ جَدِيدٍ. {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَطْوِيَهَا.",
  "hook.02": "{اِلْمِسْهَا|اِلْمِسِيهَا} لِنَطْوِيَهَا مِنْ جَدِيدٍ، حَافَّةً عَلَى حَافَّةٍ.",
  "hook.03": "هَذَا رُكْنُ الوَرَقَةِ: زَاوِيَةٌ قَائِمَةٌ، رُبْعُ دَوْرَةٍ. بِهِ نُقَارِنُ كُلَّ زَاوِيَةٍ.",
  "mat.01": "{ضَعْ|ضَعِي} رُكْنَ الوَرَقَةِ عَلَى رُكْنِ كِتَابٍ، ثُمَّ عَلَى رَأْسِ قَلَمٍ مَبْرِيٍّ، ثُمَّ عَلَى مِقَصٍّ مَفْتُوحٍ كَثِيرًا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "cc.01": "{اِلْمِسْ|اِلْمِسِي} كُلَّ زَاوِيَةٍ لِنَضَعَ عَلَيْهَا رُكْنَ الوَرَقَةِ.",
  "cc.02": "أَصْغَرُ مِنْ رُكْنِ الوَرَقَةِ: حَادَّةٌ. مِثْلُهُ: قَائِمَةٌ. أَكْبَرُ مِنْهُ وَأَصْغَرُ مِنْ نِصْفِ دَوْرَةٍ: مُنْفَرِجَةٌ.",
  "wk.01": "رَأْسُ القَلَمِ المَبْرِيِّ حَادٌّ، وَرُكْنُ الكِتَابِ قَائِمٌ، وَمَسْنَدُ الكُرْسِيِّ المَائِلِ مُنْفَرِجٌ.",
  "game.01": "لُعْبَةُ: صَائِدُ الزَّوَايَا!",
  "pk.acute": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ حَادَّةٌ؟",
  "pk.right": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ قَائِمَةٌ؟",
  "pk.obtuse": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ مُنْفَرِجَةٌ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى أَنْوَاعِ الزَّوَايَا.",
  "pr.corner": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ رُكْنَ الوَرَقَةِ. مَا نَوْعُ هَذِهِ الزَّاوِيَةِ؟",
  "ch.find": "تَقُولُ فَوْضَى: هَذِهِ لَيْسَتْ قَائِمَةً، لِأَنَّهَا مَائِلَةٌ! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَضَعَ رُكْنَ الوَرَقَةِ. مَا نَوْعُهَا؟",
  "ch.after": [
   "chaos",
   "آه! القَائِمَةُ تَبْقَى قَائِمَةً وَإِنْ مَالَتْ."
  ],
  "ch.right": "نَحْكُمُ عَلَى الزَّاوِيَةِ بِرُكْنِ الوَرَقَةِ، فِي أَيِّ اتِّجَاهٍ كَانَتْ.",
  "ch.wrong": [
   "chaos",
   "القَائِمَةُ يَكُونُ ضِلْعَاهَا أُفُقِيًّا وَرَأْسِيًّا دَائِمًا."
  ],
  "ms.3": "لِمَاذَا هَذِهِ الزَّاوِيَةُ قَائِمَةٌ مَعَ أَنَّهَا مَائِلَةٌ؟",
  "ms.3a": "لِأَنَّ رُكْنَ الوَرَقَةِ يَنْطَبِقُ عَلَيْهَا.",
  "ms.3b": "لِأَنَّ كُلَّ زَاوِيَةٍ مَائِلَةٍ تَكُونُ قَائِمَةً دَائِمًا.",
  "ms.3c": "لِأَنَّ ضِلْعَيْهَا طَوِيلَانِ وَمُتَسَاوِيَانِ فِي الطُّولِ.",
  "ms.4": "مَتَى تَكُونُ الزَّاوِيَةُ حَادَّةً؟",
  "ms.4a": "حِينَ تَكُونُ أَصْغَرَ مِنْ رُكْنِ الوَرَقَةِ.",
  "ms.4b": "حِينَ يَكُونُ ضِلْعَاهَا قَصِيرَيْنِ.",
  "ms.4c": "حِينَ تَكُونُ أَكْبَرَ مِنْ رُكْنِ الوَرَقَةِ.",
  "ms.recall": "رُكْنُ الوَرَقَةِ زَاوِيَةٌ قَائِمَةٌ، رُبْعُ دَوْرَةٍ، وَبِهِ نُقَارِنُ.",
  "ms.recall2": "أَصْغَرُ مِنْ رُكْنِ الوَرَقَةِ: حَادَّةٌ؛ وَأَكْبَرُ مِنْهُ: مُنْفَرِجَةٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُمَيِّزُ|صِرْتِ تُمَيِّزِينَ} الحَادَّةَ وَالقَائِمَةَ وَالمُنْفَرِجَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صِدْنَا فِي حَيِّ الزَّوَايَا زَوَايَا حَادَّةً وَقَائِمَةً وَمُنْفَرِجَةً!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} بِرُكْنِ الوَرَقَةِ عَنْ زَاوِيَةٍ حَادَّةٍ وَقَائِمَةٍ وَمُنْفَرِجَةٍ فِي البَيْتِ."
  ]
 },
