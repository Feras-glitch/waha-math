  "ask": "bag.ask",
  "adult": "ورق مربعات ومسطرة وقلم.",
  "screenPath": "أسئلة الوحدة على الشاشة: المحيط بالجمع وعلى الشبكة، ومحيط المربع والمستطيل والضلع المجهول، والمساحة بالعدّ والتقدير والضرب، والشكل المركّب، وسور أم بلاط، واكتشاف الخطأ، والتعليل؛ والرسم الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقُ مُرَبَّعَاتٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي مُغَامَرَةِ الأَرْضِ تَحْسُبُ فَوْضَى خَطَأً: تَجْمَعُ بَدَلَ أَنْ تَضْرِبَ، وَتَنْسَى الوَحْدَةَ المُرَبَّعَةَ.",
  "hook.02": "مَنْ يَكْشِفُ أَخْطَاءَهَا يَأْخُذُ شَارَةَ السُّورِ وَالحَجَرَ السَّابِعَ.",
  "mat.01": "عَلَى وَرَقِ المُرَبَّعَاتِ {اُرْسُمْ|اُرْسُمِي} أَرْضًا، {وَاحْسُبْ|وَاحْسُبِي} مُحِيطَهَا وَمَسَاحَتَهَا، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِالمِسْطَرَةِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: المُحِيطُ نَجْمَعُ فِيهِ الأَطْوَالَ حَوْلَ الشَّكْلِ، وَوَحْدَتُهُ السَّنْتِيمِتْرُ أَوِ المِتْرُ.",
  "rv.02": "وَالمَسَاحَةُ نَعُدُّ فِيهَا المُرَبَّعَاتِ دَاخِلَهُ، وَوَحْدَتُهَا مُرَبَّعَةٌ.",
  "rv.03": "وَالشَّكْلُ المُرَكَّبُ نُقَسِّمُهُ أَوْ نُتِمُّهُ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ الأَرْضِ! {صَحِّحْ|صَحِّحِي} حِسَابَ فَوْضَى.",
  "gm.area": "جَمَعَتْ فَوْضَى بَدَلَ أَنْ تَضْرِبَ. كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَتُهُ حَقًّا؟",
  "gm.perim": "جَمَعَتْ فَوْضَى ضِلْعَيْنِ فَقَطْ. كَمْ سَنْتِيمِتْرًا مُحِيطُهُ حَقًّا؟",
  "gm.unit": "كَتَبَتْ فَوْضَى وَحْدَةً خَطَأً. بِأَيِّ وَحْدَةٍ نَكْتُبُ:",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "q.perim": "كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذَا الشَّكْلِ؟",
  "q.perimG": "ضِلْعُ كُلِّ مُرَبَّعٍ سَنْتِيمِتْرٌ. كَمْ سَنْتِيمِتْرًا مُحِيطُ الشَّكْلِ؟",
  "q.perimSq": "كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذَا المُرَبَّعِ؟",
  "q.sideR": "مُحِيطُ هَذَا المُسْتَطِيلِ وَطُولُهُ مَكْتُوبَانِ. كَمْ سَنْتِيمِتْرًا عَرْضُهُ؟",
  "q.area": "ضِلْعُ كُلِّ مُرَبَّعٍ سَنْتِيمِتْرٌ. كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ الشَّكْلِ؟",
  "q.est": "{قَدِّرْ|قَدِّرِي}: كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ الشَّكْلِ تَقْرِيبًا؟",
  "q.areaR": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَتُهُ؟",
  "q.sideA": "مَسَاحَةُ هَذَا المُسْتَطِيلِ وَطُولُهُ مَكْتُوبَانِ. كَمْ سَنْتِيمِتْرًا عَرْضُهُ؟",
  "q.comp": "كَمْ سَنْتِيمِتْرًا مُرَبَّعًا مَسَاحَةُ هَذِهِ الأَرْضِ؟",
  "q.compP": "بَعْضُ الأَطْوَالِ غَيْرُ مَكْتُوبٍ. كَمْ سَنْتِيمِتْرًا مُحِيطُ هَذِهِ الأَرْضِ؟",
  "q.pa": "مُحِيطٌ أَمْ مَسَاحَةٌ؟",
  "ts.13": "كَتَبَ طَالِبٌ: مُحِيطُ مُسْتَطِيلٍ طُولُهُ سِتَّةٌ وَعَرْضُهُ أَرْبَعَةٌ عَشَرَةُ سَنْتِيمِتْرَاتٍ. مَا خَطَؤُهُ؟",
  "ts.13a": "جَمَعَ الطُّولَ وَالعَرْضَ مَرَّةً وَاحِدَةً فَقَطْ.",
  "ts.13b": "ضَرَبَ الطُّولَ فِي العَرْضِ بَدَلَ الجَمْعِ.",
  "ts.13c": "نَسِيَ أَنْ يَكْتُبَ الوَحْدَةَ المُرَبَّعَةَ.",
  "ts.14": "مُسْتَطِيلَانِ مُحِيطُهُمَا وَاحِدٌ: هَلْ مَسَاحَتُهُمَا وَاحِدَةٌ؟",
  "ts.14a": "لَا: خَمْسَةٌ فِي خَمْسَةٍ أَكْبَرُ مِنْ تِسْعَةٍ فِي وَاحِدٍ.",
  "ts.14b": "نَعَمْ: المُحِيطُ نَفْسُهُ يَعْنِي المَسَاحَةَ نَفْسَهَا.",
  "ts.14c": "نَعَمْ، إِذَا كَانَ الطُّولُ أَكْبَرَ مِنَ العَرْضِ.",
  "ts.rem": "نَقِيسُ مَعَ الكِبَارِ أَرْضًا فِي البَيْتِ بِالخَيْطِ وَالبَلَاطِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": "هَذَا الحَجَرُ السَّابِعُ لِلْوَاحَةِ!",
  "ts.win1": "{أَنْتَ حَارِسُ|أَنْتِ حَارِسَةُ} السُّورِ!",
  "ts.win2": "{عَرَفْتَ|عَرَفْتِ} المُحِيطَ وَالمَسَاحَةَ، وَالفَرْقَ بَيْنَهُمَا.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ السُّورِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} طُولَ سَجَّادَةٍ صَغِيرَةٍ وَعَرْضَهَا {وَاحْسُبْ|وَاحْسُبِي} مُحِيطَهَا، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِخَيْطٍ، ثُمَّ {اِرْفَعْهَا|اِرْفَعِيهَا} {وَعُدَّ|وَعُدِّي} البَلَاطَ تَحْتَهَا."
  ]
 },
