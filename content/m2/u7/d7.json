  ],
  "ask": "bag.ask",
  "adult": "شريط لاصق أو ورق جرائد، وشريط قياس، لتحديد مربع ضلعه متر على الأرض.",
  "screenPath": "على الشاشة يرى الطفل المتر المربع، ويحسب سور الحديقة وعشبها بالمتر والمتر المربع، ويبحث عن أفضل مزرعة بسور واحد؛ والمربع الحقيقي على الأرض في مسار «معي»."
 },
 "labels": {
  "bagTape": "شَرِيطٌ لَاصِقٌ",
  "bagTapeM": "شَرِيطُ قِيَاسٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطٌ لَاصِقٌ وَشَرِيطُ قِيَاسٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "m2.01": "مُرَبَّعٌ عَلَى الأَرْضِ ضِلْعُهُ مِتْرٌ: مَسَاحَتُهُ مِتْرٌ مُرَبَّعٌ.",
  "m2.02": "حَدِيقَةٌ ثَلَاثَةُ أَمْتَارٍ فِي مِتْرَيْنِ: فِيهَا سِتَّةُ أَمْتَارٍ مُرَبَّعَةٍ مِنَ العُشْبِ.",
  "m2.03": "وَسُورُهَا بِالمِتْرِ، وَعُشْبُهَا بِالمِتْرِ المُرَبَّعِ.",
  "mat.01": "{حَدِّدْ|حَدِّدِي} بِالشَّرِيطِ اللَّاصِقِ عَلَى الأَرْضِ مُرَبَّعًا ضِلْعُهُ مِتْرٌ بِشَرِيطِ القِيَاسِ، {وَقِفْ|وَقِفِي} فِيهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: خَطِّطْ أَرْضَ الوَاحَةِ! السُّورُ بِالمِتْرِ، وَالعُشْبُ بِالمِتْرِ المُرَبَّعِ.",
  "best.01": "الإِبْدَاعُ: أَفْضَلُ مَزْرَعَةٍ بِسُورٍ وَاحِدٍ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى تَخْطِيطِ الأَرْضِ.",
  "pr.areaM": "كَمْ مِتْرًا مُرَبَّعًا مِنَ العُشْبِ فِي هَذِهِ الحَدِيقَةِ؟",
  "pr.perimM": "كَمْ مِتْرًا سُورُ هَذِهِ الحَدِيقَةِ؟",
  "pr.unitPA": "بِأَيِّ وَحْدَةٍ نَكْتُبُ:",
  "pr.sameA": "أَيُّ الأَرْضَيْنِ أَكْبَرُ مَسَاحَةً؟",
  "hk.01": "مَشْرُوعُ اليَوْمِ: نُخَطِّطُ أَرْضَ الوَاحَةِ، سُورَهَا وَعُشْبَهَا.",
  "pr.max": "{غَيِّرْ|غَيِّرِي} عَرْضَ المَزْرَعَةِ بِالزِّرَّيْنِ حَتَّى تَصِيرَ مَسَاحَتُهَا أَكْبَرَ مَا يُمْكِنُ، ثُمَّ «تَمَّ».",
  "ch.find": "كَتَبَتْ فَوْضَى مَسَاحَةَ العُشْبِ بِالمِتْرِ! بِأَيِّ وَحْدَةٍ نَكْتُبُ:",
  "ch.after": [
   "chaos",
   "آه! نَعُدُّ مُرَبَّعَاتٍ كَبِيرَةً، فَالوَحْدَةُ مِتْرٌ مُرَبَّعٌ."
  ],
  "ch.right": "السُّورُ بِالمِتْرِ، وَالعُشْبُ بِالمِتْرِ المُرَبَّعِ.",
  "ch.wrong": [
   "chaos",
   "المِتْرُ يَصْلُحُ لِلسُّورِ وَلِلْعُشْبِ."
  ],
  "ms.1": "لِمَاذَا نَكْتُبُ مَسَاحَةَ العُشْبِ بِالمِتْرِ المُرَبَّعِ؟",
  "ms.1a": "لِأَنَّنَا نَعُدُّ مُرَبَّعَاتٍ ضِلْعُ كُلٍّ مِنْهَا مِتْرٌ.",
  "ms.1b": "لِأَنَّ العُشْبَ أَطْوَلُ مِنَ السُّورِ.",
  "ms.1c": "لِأَنَّ المِتْرَ المُرَبَّعَ أَصْغَرُ مِنَ السَّنْتِيمِتْرِ.",
  "ms.recall": "المِتْرُ المُرَبَّعُ مُرَبَّعٌ ضِلْعُهُ مِتْرٌ؛ بِهِ نَعُدُّ مَسَاحَةَ الأَرَاضِي الكَبِيرَةِ.",
  "ms.ok": "رَائِعٌ! {خَطَّطْتَ أَرْضَكَ|خَطَّطْتِ أَرْضَكِ} بِالمِتْرِ وَالمِتْرِ المُرَبَّعِ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "خَطَّطْنَا أَرْضَ الوَاحَةِ: سُورُهَا وَعُشْبُهَا وَمَلْعَبُهَا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} أَرْضًا عَلَى وَرَقِ المُرَبَّعَاتِ، كُلُّ مُرَبَّعٍ مِتْرٌ، {وَاحْسُبْ|وَاحْسُبِي} سُورَهَا وَعُشْبَهَا."
  ]
 },
