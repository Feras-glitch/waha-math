{
 "id": "m2.u6.d3",
 "title": "أَجْمَعُ وَأَطْرَحُ الأَطْوَالَ",
 "icon": [
  "lencalc"
 ],
 "concepts": {
  "C190": "جمع الأطوال المركّبة بإعادة التجميع، والطرح بالتحويل إلى السنتيمتر، والتحقق بالتقريب لأقرب متر"
 },
 "bag": {
  "items": [
   {
    "icon": "tapeM",
    "label": "bagTape"
   },
   {
    "icon": "thread",
    "label": "bagThread"
   }
  ],
  "ask": "bag.ask",
  "adult": "شريط قياس وخيطان (أو شريطا زينة) وورقة وقلم.",
  "screenPath": "على الشاشة يجمع الطفل الأطوال المركّبة ويطرحها في جدول الأمتار والسنتيمترات، ويقرّب لأقرب متر، ويبني سوراً بالطول المضبوط؛ والقياس الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagTape": "شَرِيطُ قِيَاسٍ",
  "bagThread": "خَيْطٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ وَخَيْطٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "aw.01": "نَجْمَعُ: مِتْرَانِ وَأَرْبَعُونَ سَنْتِيمِتْرًا، وَمِتْرٌ وَثَمَانُونَ سَنْتِيمِتْرًا. نَجْمَعُ السَّنْتِيمِتْرَاتِ أَوَّلًا، ثُمَّ الأَمْتَارَ.",
  "aw.02": "السَّنْتِيمِتْرَاتُ: مِئَةٌ وَعِشْرُونَ. وَالمِئَةُ مِنْهَا مِتْرٌ!",
  "aw.03": "نَنْقُلُ المِتْرَ إِلَى عَمُودِ الأَمْتَارِ: أَرْبَعَةُ أَمْتَارٍ وَعِشْرُونَ سَنْتِيمِتْرًا.",
  "sw.01": "وَنَطْرَحُ: ثَلَاثَةُ أَمْتَارٍ وَعِشْرُونَ سَنْتِيمِتْرًا، نَاقِصَ مِتْرٍ وَخَمْسِينَ سَنْتِيمِتْرًا.",
  "sw.02": "نُحَوِّلُ الطُّولَيْنِ إِلَى السَّنْتِيمِتْرِ، ثُمَّ نَطْرَحُ.",
  "sw.03": "البَاقِي: مِئَةٌ وَسَبْعُونَ سَنْتِيمِتْرًا، أَيْ مِتْرٌ وَسَبْعُونَ سَنْتِيمِتْرًا.",
  "rs.01": "نَتَحَقَّقُ بِالتَّقْرِيبِ: إِلَى أَيِّ مِتْرٍ هَذَا الطُّولُ أَقْرَبُ؟",
  "rs.02": "أَقَلُّ مِنْ خَمْسِينَ سَنْتِيمِتْرًا: نَبْقَى عِنْدَ المِتْرِ نَفْسِهِ. وَمِنْ خَمْسِينَ فَأَكْثَرَ: نَنْتَقِلُ إِلَى المِتْرِ التَّالِي.",
  "mat.01": "{قِسْ|قِيسِي} بِشَرِيطِ القِيَاسِ قِطَعًا مِنَ الخَيْطِ، {وَاجْمَعْ|وَاجْمَعِي} أَطْوَالَهَا، ثُمَّ {ضَعْهَا|ضَعِيهَا} طَرَفًا بِطَرَفٍ {وَقِسْ|وَقِيسِي} {لِتَتَحَقَّقَ|لِتَتَحَقَّقِي}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: بَنَّاءُ السُّورِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى جَمْعِ الأَطْوَالِ وَطَرْحِهَا.",
  "pr.add": "كَمْ يَكُونُ المَجْمُوعُ؟",
  "pr.sub": "كَمْ يَبْقَى؟",
  "pr.round": "إِلَى أَيِّ مِتْرٍ هَذَا الطُّولُ أَقْرَبُ؟",
  "pr.fence": "{اِخْتَرْ|اِخْتَارِي} قِطَعًا يَكُونُ مَجْمُوعُهَا طُولَ السُّورِ تَمَامًا، ثُمَّ «تَمَّ».",
  "pr.ribbon": "شَرِيطُ زِينَةٍ طُولُهُ ثَلَاثَةُ أَمْتَارٍ، قَصَصْنَا مِنْهُ خَمْسَةً وَثَمَانِينَ سَنْتِيمِتْرًا. كَمْ بَقِيَ؟",
  "pr.wires": "سِلْكَانِ: مِتْرَانِ وَخَمْسُونَ سَنْتِيمِتْرًا، وَمِتْرٌ وَخَمْسَةٌ وَسَبْعُونَ سَنْتِيمِتْرًا. كَمْ طُولُهُمَا مَعًا؟",
  "ch.find": "جَمَعَتْ فَوْضَى الطُّولَيْنِ فَكَتَبَتْ: ثَلَاثَةُ أَمْتَارٍ وَمِئَةٌ وَعِشْرُونَ سَنْتِيمِتْرًا. كَمْ يَكُونُ المَجْمُوعُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! المِئَةُ سَنْتِيمِتْرٍ مِتْرٌ، فَأَنْقُلُهَا إِلَى الأَمْتَارِ."
  ],
  "ch.right": "نُعِيدُ التَّجْمِيعَ: كُلُّ مِئَةِ سَنْتِيمِتْرٍ مِتْرٌ.",
  "ch.wrong": [
   "chaos",
   "تَبْقَى السَّنْتِيمِتْرَاتُ كَمَا هِيَ، مَهْمَا كَثُرَتْ."
  ],
  "ms.1": "لِمَاذَا لَا نَكْتُبُ: مِتْرَانِ وَمِئَةٌ وَعِشْرُونَ سَنْتِيمِتْرًا؟",
  "ms.1a": "لِأَنَّ مِئَةَ سَنْتِيمِتْرٍ مِتْرٌ، فَنَنْقُلُهَا إِلَى الأَمْتَارِ.",
  "ms.1b": "لِأَنَّ السَّنْتِيمِتْرَاتِ لَا تُجْمَعُ أَبَدًا مَعَ الأَمْتَارِ.",
  "ms.1c": "لِأَنَّ الطُّولَ يَجِبُ أَنْ يَكُونَ أَقَلَّ مِنْ مِتْرَيْنِ.",
  "ms.recall": "نَجْمَعُ السَّنْتِيمِتْرَاتِ ثُمَّ الأَمْتَارَ، وَكُلُّ مِئَةِ سَنْتِيمِتْرٍ نَنْقُلُهَا مِتْرًا.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَجْمَعُ|صِرْتِ تَجْمَعِينَ} الأَطْوَالَ {وَتَطْرَحُهَا|وَتَطْرَحِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "بَنَيْنَا كُلَّ سُورٍ بِالطُّولِ المَضْبُوطِ تَمَامًا!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} طُولَ السَّرِيرِ وَعَرْضَهُ، {وَاجْمَعْهُمَا|وَاجْمَعِيهِمَا}، {وَتَحَقَّقْ|وَتَحَقَّقِي} بِالتَّقْرِيبِ لِأَقْرَبِ مِتْرٍ."
  ]
 },
