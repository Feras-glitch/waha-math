 "concepts": {
  "C203": "المساحة عدد المربعات الوحدة التي تغطي الشكل بلا فراغ ولا تراكب",
  "C204": "السنتيمتر المربع وحدةً للمساحة",
  "C205": "تقدير مساحة شكل غير منتظم بعدّ الكاملة وكل نصفين مربعاً"
 },
 "bag": {
