{
 "id": "m2.u6.d1",
 "title": "المِتْرُ وَالكِيلُومِتْرُ",
 "icon": [
  "lentape"
 ],
 "concepts": {
  "C186": "المتر والكيلومتر، وشريط القياس أداةً (1 م = 100 سم، 1 كم = 1000 م)",
  "C187": "اختيار الوحدة المناسبة (ملم، سم، م، كم)؛ والتقدير ومراجعه الشخصية في د4"
 },
 "bag": {
  "items": [
   {
    "icon": "tapeM",
    "label": "bagTape"
   }
  ],
  "ask": "bag.ask",
  "adult": "شريط قياس، وباب وطاولة في البيت.",
  "screenPath": "على الشاشة يمدّ الطفل شريط القياس ويرى المتر عند مئة سنتيمتر، ويمشي كيلومتراً بمئات الأمتار، ويختار الوحدة الأنسب؛ والقياس الحقيقي بالشريط في مسار «معي»."
 },
 "labels": {
  "bagTape": "شَرِيطُ قِيَاسٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "home.back": "{طَوَيْتَ|طَوَيْتِ} أَغْطِيَةً وَمَنَادِيلَ {فَوَجَدْتَ|فَوَجَدْتِ} مَحَاوِرَهَا، وَكَانَ كُلُّ شَيْءٍ مِنْهَا يَسَعُ المِسْطَرَةَ. اليَوْمَ نَسْأَلُ عَنِ البَابِ كُلِّهِ: كَمْ سَنْتِيمِتْرًا فِيهِ؟ وَهَلْ تَكْفِيهِ مِسْطَرَةٌ؟",
  "tp.01": "هَذِهِ أَدَاةٌ جَدِيدَةٌ: شَرِيطُ القِيَاسِ. نَقْرَؤُهُ كَالمِسْطَرَةِ، وَنَمُدُّهُ.",
  "tp.02": "عِنْدَ العَلَامَةِ الحَمْرَاءِ: مِئَةُ سَنْتِيمِتْرٍ. هَذَا هُوَ المِتْرُ.",
  "tp.03": "نُحَاذِي الصِّفْرَ بِطَرَفِ البَابِ، وَنَقْرَأُ عِنْدَ طَرَفِهِ الآخَرِ.",
  "mat.01": "{مُدَّ|مُدِّي} شَرِيطَ القِيَاسِ مِنَ الصِّفْرِ عَلَى عَرْضِ البَابِ، وَعَلَى الطَّاوِلَةِ، {وَاقْرَأْ|وَاقْرَئِي} كُلَّ قِيَاسٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "km.01": "وَالمَسَافَاتُ الطَّوِيلَةُ؟ مِنْ بَيْتِنَا إِلَى البَوَّابَةِ البَعِيدَةِ نَمْشِي مِئَةَ مِتْرٍ بَعْدَ مِئَةٍ.",
  "km.02": "عَشْرُ مَرَّاتٍ مِئَةُ مِتْرٍ: أَلْفُ مِتْرٍ. هَذَا هُوَ الكِيلُومِتْرُ.",
  "km.03": "نَمْشِي الكِيلُومِتْرَ فِي رُبْعِ سَاعَةٍ تَقْرِيبًا.",
  "ut.01": "لِكُلِّ شَيْءٍ وَحْدَةٌ أَنْسَبُ: الصَّغِيرُ جِدًّا بِالمِلِّيمِتْرِ، ثُمَّ السَّنْتِيمِتْرُ، ثُمَّ المِتْرُ، ثُمَّ الكِيلُومِتْرُ لِلطُّرُقِ.",
  "ut.02": "نَخْتَارُ الوَحْدَةَ الَّتِي تُعْطِي عَدَدًا مُرِيحًا: لَا صَغِيرًا جِدًّا وَلَا ضَخْمًا.",
  "game.01": "لُعْبَةُ: اخْتِيَارُ الأَدَاةِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المِتْرِ وَالوَحَدَاتِ.",
  "pr.unit": "أَيُّ وَحْدَةٍ أَنْسَبُ لِقِيَاسِ:",
  "pr.tape": "كَمْ طُولُهُ؟ {اِقْرَأْ|اِقْرَئِي} شَرِيطَ القِيَاسِ.",
  "pr.conv": "كَمْ يُسَاوِي:",
  "ch.find": "قَاسَتْ فَوْضَى قَلَمَهَا بِالكِيلُومِتْرِ! أَيُّ وَحْدَةٍ أَنْسَبُ لِقِيَاسِ:",
  "ch.after": [
   "chaos",
   "آه! الكِيلُومِتْرُ لِلطُّرُقِ، لَا لِلْأَقْلَامِ."
  ],
  "ch.right": "نَخْتَارُ وَحْدَةً تُنَاسِبُ حَجْمَ الشَّيْءِ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ الوَحَدَاتِ تَصْلُحُ لِكُلِّ شَيْءٍ."
  ],
  "ms.1": "لِمَاذَا نَقُولُ: المِتْرُ مِئَةُ سَنْتِيمِتْرٍ؟",
  "ms.1a": "لِأَنَّ الشَّرِيطَ يَبْلُغُ مِئَةً عِنْدَ عَلَامَةِ المِتْرِ.",
  "ms.1b": "لِأَنَّ المِتْرَ أَقْصَرُ مِنَ السَّنْتِيمِتْرِ بِكَثِيرٍ دَائِمًا.",
  "ms.1c": "لِأَنَّ فِي المِتْرِ عَشَرَةَ سَنْتِيمِتْرَاتٍ فَقَطْ لَا أَكْثَرَ.",
  "ms.2": "قَاسَ وَلَدٌ طُولَ بَيْتِهِ بِالسَّنْتِيمِتْرِ، فَحَصَلَ عَلَى عَدَدٍ ضَخْمٍ. مَا المُشْكِلَةُ؟",
  "ms.2a": "الوَحْدَةُ صَغِيرَةٌ جِدًّا؛ المِتْرُ أَنْسَبُ.",
  "ms.2b": "أَخْطَأَ فِي العَدِّ، وَالوَحْدَةُ مُنَاسِبَةٌ تَمَامًا.",
  "ms.2c": "البُيُوتُ لَا تُقَاسُ أَبَدًا بِأَيِّ وَحْدَةٍ.",
  "ms.recall": "فِي المِتْرِ مِئَةُ سَنْتِيمِتْرٍ، وَفِي الكِيلُومِتْرِ أَلْفُ مِتْرٍ.",
  "ms.recall2": "المِلِّيمِتْرُ لِلصَّغِيرِ جِدًّا، وَالسَّنْتِيمِتْرُ لِلْقَلَمِ، وَالمِتْرُ لِلْبَابِ، وَالكِيلُومِتْرُ لِلطُّرُقِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المِتْرَ وَالكِيلُومِتْرَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "دَخَلْنَا حَيَّ المَسَافَاتِ: بِالشَّرِيطِ نَقِيسُ المِتْرَ، وَبِالخُطُوَاتِ نَتَخَيَّلُ الكِيلُومِتْرَ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} بِشَرِيطِ القِيَاسِ طُولَ {سَرِيرِكَ|سَرِيرِكِ}، {وَقُلْ|وَقُولِي} {لِأَهْلِكَ|لِأَهْلِكِ}: كَمْ مِتْرًا وَكَمْ سَنْتِيمِتْرًا؟"
  ]
 },
