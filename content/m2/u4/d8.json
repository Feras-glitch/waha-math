 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِسْطَرَةٌ وَرُكْنُ الوَرَقَةِ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "صَنَعْتُ المُضَلَّعَاتِ {مَعَكَ|مَعَكِ}! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَشُقُّ أَنَا القَنَاةَ الخَامِسَةَ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ أَضْلَاعَ قُصَاصَةِ رُبَاعِيٍّ، وَ{ضَعْ|ضَعِي} رُكْنَ الوَرَقَةِ عَلَى زَوَايَاهُ، وَ{سَمِّهِ|سَمِّيهِ}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "المُضَلَّعُ مُغْلَقٌ، وَأَضْلَاعُهُ قِطَعٌ مُسْتَقِيمَةٌ لَا تَتَقَاطَعُ، وَاسْمُهُ مِنْ عَدَدِ أَضْلَاعِهِ.",
  "rv.02": "لِلمُثَلَّثِ اسْمٌ بِأَضْلَاعِهِ وَاسْمٌ بِزَوَايَاهُ، وَلِلرُّبَاعِيَّاتِ عَائِلَةٌ نَفْحَصُهَا بِالأَسْئِلَةِ الثَّلَاثَةِ.",
  "rv.03": "المُنْتَظِمُ أَضْلَاعُهُ مُتَسَاوِيَةٌ وَزَوَايَاهُ مُتَسَاوِيَةٌ، وَنُفَكِّكُ الأَشْكَالَ وَنُرَكِّبُهَا بِلَا فَرَاغٍ.",
  "gm.intro": "لُعْبَةُ: رِحْلَةُ فَوْضَى! وَضَعَتْ فَوْضَى أَشْكَالًا فِي غَيْرِ أَمَاكِنِهَا.",
  "gm.fam": "وَضَعَتْ فَوْضَى هَذَا الشَّكْلَ فِي غَيْرِ مَكَانِهِ. أَيْنَ مَكَانُهُ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "gm.tri": "سَمَّتْ فَوْضَى هَذَا المُثَلَّثَ خَطَأً. مَا اسْمَاهُ حَقًّا؟ {قِسْ|قِيسِي} أَوَّلًا.",
  "gm.reg": "قَالَتْ فَوْضَى: هَذَا مُنْتَظِمٌ. هَلْ هُوَ مُنْتَظِمٌ حَقًّا؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ أَسْئِلَةِ الوَاحَةِ.",
  "q.is": "هَلْ هَذَا الشَّكْلُ مُضَلَّعٌ؟",
  "q.pname": "مَا اسْمُ هَذَا المُضَلَّعِ؟ {عُدَّ|عُدِّي} أَضْلَاعَهُ.",
  "q.side": "مَا اسْمُ هَذَا المُثَلَّثِ بِأَضْلَاعِهِ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.ang": "مَا اسْمُ هَذَا المُثَلَّثِ بِزَوَايَاهُ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.name": "مَا اسْمُ هَذَا الرُّبَاعِيِّ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.opp": "{اِلْمِسِ|اِلْمِسِي} الضِّلْعَ المُقَابِلَ لِلضِّلْعِ المُلَوَّنِ.",
  "q.diag": "{اُرْسُمْ|اُرْسُمِي} قُطْرًا: {اِلْمِسْ|اِلْمِسِي} رَأْسًا.",
  "q.reg": "هَلْ هَذَا المُضَلَّعُ مُنْتَظِمٌ؟ {قِسْ|قِيسِي} ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "q.parts": "قَصَصْنَا الشَّكْلَ عَلَى الخُطُوطِ المُتَقَطِّعَةِ. كَمْ قِطْعَةً صَارَ؟",
  "q.rd": "مَنْ أَنَا؟ فِيَّ زَوْجٌ مِنَ الأَضْلَاعِ المُتَوَازِيَةِ. {اِلْمِسْنِي|اِلْمِسِينِي}.",
  "q.diagN": "كَمْ قُطْرًا لِهَذَا المُضَلَّعِ؟",
  "ts.2": "لِمَاذَا هَذَا الشَّكْلُ لَيْسَ مُضَلَّعًا؟",
  "ts.2a": "لِأَنَّ ضِلْعَيْنِ مِنْ أَضْلَاعِهِ يَتَقَاطَعَانِ.",
  "ts.2b": "لِأَنَّهُ مَفْتُوحٌ وَلَا يَلْتَقِي طَرَفَاهُ.",
  "ts.2c": "لِأَنَّ فِيهِ ضِلْعًا مُنْحَنِيًا.",
  "ts.13": "هَلِ المُرَبَّعُ مُسْتَطِيلٌ؟ {بَرِّرْ إِجَابَتَكَ|بَرِّرِي إِجَابَتَكِ}.",
  "ts.13a": "نَعَمْ: لَهُ كُلُّ خَصَائِصِ المُسْتَطِيلِ.",
  "ts.13b": "لَا: لِأَنَّ اسْمَهُ مُرَبَّعٌ، وَلِكُلِّ شَكْلٍ اسْمٌ وَاحِدٌ.",
  "ts.13c": "لَا: لِأَنَّ زَوَايَا المُرَبَّعِ لَيْسَتْ قَائِمَةً كُلُّهَا.",
  "ts.rem": "نَبْحَثُ مَعَ الكِبَارِ عَنْ مُضَلَّعَاتٍ فِي البَيْتِ، وَنَعُدُّ أَضْلَاعَهَا، وَنَفْحَصُهَا بِالأَسْئِلَةِ الثَّلَاثَةِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَشُقُّ القَنَاةَ الخَامِسَةَ."
  ],
  "ts.win1": "{أَنْتَ سَيِّدُ المُضَلَّعَاتِ|أَنْتِ سَيِّدَةُ المُضَلَّعَاتِ}!",
  "ts.win2": "جَرَى المَاءُ فِي القَنَاةِ الخَامِسَةِ مِنْ قَنَوَاتِ الأَدَوَاتِ!",
  "wrap.01": "صَارَتْ عَائِلَةُ المُضَلَّعَاتِ كُلُّهَا فِي دَفْتَرِ المُهَنْدِسِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُرْسُمْ|اُرْسُمِي} مُسْتَطِيلًا عَلَى وَرَقَةٍ، وَ{قُصَّهُ|قُصِّيهِ} بِقُطْرِهِ، وَ{رَكِّبْ|رَكِّبِي} مِنَ المُثَلَّثَيْنِ ثَلَاثَةَ أَشْكَالٍ مُخْتَلِفَةٍ، وَ{سَمِّ|سَمِّي} كُلَّ شَكْلٍ."
  ]
