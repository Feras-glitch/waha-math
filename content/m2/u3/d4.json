  "ask": "bag.ask",
  "adult": "قرص من ورق مقسّم كالكعكة، ومقصّ.",
  "screenPath": "على الشاشة تُقطع من الكعكة شريحة، فيرى الطفل الشريحة والباقي ومجموعهما؛ والقرص الورقي في مسار «معي»."
 },
 "labels": {
  "bagCake": "قُرْصٌ مِنْ وَرَقٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} قُرْصٌ مِنْ وَرَقٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذِهِ كَعْكَةٌ مُسْتَدِيرَةٌ. {اِلْمِسْهَا|اِلْمِسِيهَا} لِنَقْطَعَ مِنْهَا شَرِيحَةً.",
  "hook.02": "الشَّرِيحَةُ زَاوِيَةٌ حَادَّةٌ، قَوْسُهَا أَخْضَرُ.",
  "hook.03": "وَالبَاقِي مِنَ الكَعْكَةِ زَاوِيَةٌ أَيْضًا، أَكْبَرُ مِنْ نِصْفِ دَوْرَةٍ، وَقَوْسُهَا بَنَفْسَجِيٌّ: اسْمُهَا الزَّاوِيَةُ المُنْعَكِسَةُ.",
  "hook.04": "الشَّرِيحَةُ وَالبَاقِي مَعًا الكَعْكَةُ كُلُّهَا: دَوْرَةٌ كَامِلَةٌ.",
  "mat.01": "{اِقْطَعْ|اِقْطَعِي} مِنَ القُرْصِ شَرِيحَةً صَغِيرَةً، وَ{ضَعْ|ضَعِي} إِصْبَعًا عَلَى الجُزْءِ البَاقِي. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rx.01": "لِكُلِّ زَاوِيَةٍ جِهَتَانِ: الجِهَةُ الصُّغْرَى قَوْسُهَا أَخْضَرُ، وَالجِهَةُ الكُبْرَى قَوْسُهَا بَنَفْسَجِيٌّ، وَهِيَ المُنْعَكِسَةُ.",
  "game.01": "لُعْبَةُ: التِهَامُ الكَعْكَةِ!",
  "gm.q": "قِيَاسُ الشَّرِيحَةِ مَكْتُوبٌ. كَمْ دَرَجَةً البَاقِي مِنَ الكَعْكَةِ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الزَّاوِيَةِ المُنْعَكِسَةِ.",
  "pr.kind": "مَا نَوْعُ الزَّاوِيَةِ الَّتِي قَوْسُهَا بَنَفْسَجِيٌّ؟",
  "pr.rfx": "قِيَاسُ الزَّاوِيَةِ الصُّغْرَى مَكْتُوبٌ. كَمْ دَرَجَةً الزَّاوِيَةُ المُنْعَكِسَةُ؟",
  "pk.reflex": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ مُنْعَكِسَةٌ؟",
  "ch.find": "تَقُولُ فَوْضَى: هَذِهِ زَاوِيَةٌ مُنْفَرِجَةٌ، لِأَنَّهَا كَبِيرَةٌ! مَا نَوْعُ الزَّاوِيَةِ الَّتِي قَوْسُهَا بَنَفْسَجِيٌّ؟",
  "ch.after": [
   "chaos",
   "آه! أَكْبَرُ مِنْ نِصْفِ دَوْرَةٍ، فَهِيَ مُنْعَكِسَةٌ."
  ],
  "ch.right": "المُنْعَكِسَةُ أَكْبَرُ مِنْ نِصْفِ دَوْرَةٍ، وَالمُنْفَرِجَةُ أَصْغَرُ مِنْهُ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ زَاوِيَةٍ كَبِيرَةٍ مُنْفَرِجَةٌ."
  ],
  "ms.3": "لِمَاذَا الزَّاوِيَةُ وَالمُنْعَكِسَةُ المُقَابِلَةُ لَهَا مَعًا ثَلَاثُمِئَةٍ وَسِتُّونَ دَرَجَةً؟",
  "ms.3a": "لِأَنَّهُمَا مَعًا دَوْرَةٌ كَامِلَةٌ حَوْلَ الرَّأْسِ.",
  "ms.3b": "لِأَنَّ كُلَّ زَاوِيَةٍ تَكُونُ نِصْفَ دَوْرَةٍ مَهْمَا كَانَتْ.",
  "ms.3c": "لِأَنَّ المُنْعَكِسَةَ ضِعْفُ الزَّاوِيَةِ دَائِمًا.",
  "ms.recall": "المُنْعَكِسَةُ أَكْبَرُ مِنْ نِصْفِ دَوْرَةٍ، وَأَصْغَرُ مِنْ دَوْرَةٍ كَامِلَةٍ.",
  "ms.recall2": "الزَّاوِيَةُ وَمُنْعَكِسَتُهَا مَعًا دَوْرَةٌ كَامِلَةٌ، فَنَطْرَحُ الزَّاوِيَةَ مِنَ الدَّوْرَةِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُنْعَكِسَةَ وَ{تَحْسُبُهَا|تَحْسُبِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "قَطَعْنَا فِي حَيِّ الزَّوَايَا شَرِيحَةً، وَعَرَفْنَا البَاقِيَ: زَاوِيَةً مُنْعَكِسَةً!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِفْتَحِ|اِفْتَحِي} المِقَصَّ قَلِيلًا، وَ{أَرِ|أَرِي} {أَهْلَكَ|أَهْلَكِ} الجِهَتَيْنِ: الصُّغْرَى وَالكُبْرَى."
  ]
 },
