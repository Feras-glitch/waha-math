  "rh.after": "صَيْدٌ رَائِعٌ!",
  "ts.cube": "أَيْنَ المُكَعَّبُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "ts.cyl": "أَيْنَ الأُسْطُوَانَةُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "ts.cone": "أَيْنَ المَخْرُوطُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "ts.standRoll": "أَيُّ هَذِهِ يَقِفُ وَيَتَدَحْرَجُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "ts.why": "كَيْفَ عَرَفْنَا أَنَّهَا أُسْطُوَانَةٌ؟ {اِسْمَعِ|اِسْمَعِي} الأَسْبَابَ الثَّلَاثَةَ، ثُمَّ {اِخْتَرْ|اِخْتَارِي}.",
  "ts.r1": "لِأَنَّ لَهَا وَجْهَيْنِ دَائِرِيَّيْنِ وَسَطْحًا مُنْحَنِيًا.",
  "ts.r2": "لِأَنَّ لَوْنَهَا أَخْضَرُ مِثْلُ وَرَقِ الشَّجَرِ.",
  "ts.r3": "لِأَنَّهَا طَوِيلَةٌ، وَتَقِفُ عَلَى الطَّاوِلَةِ وَحْدَهَا.",
  "ts.story": "فِي البُرْجِ أَرْبَعَةُ مُكَعَّبَاتٍ، وَبَنَيْنَا فَوْقَهَا أَرْبَعَةً.",
  "ts.rem": "نَلْعَبُ بِكِيسِ اللَّمْسِ، وَنُصَنِّفُ أَشْيَاءَ البَيْتِ: يَتَدَحْرَجُ أَمْ يَقِفُ، ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
