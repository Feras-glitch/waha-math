 "labels": {
  "bagStrips": "شَرِيطُ وَرَقٍ",
  "bagPens": "أَقْلَامُ تَلْوِينٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ وَرَقٍ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "fe.01": "شَرِيطٌ نِصْفُهُ مُلَوَّنٌ. نَطْوِيهِ مَرَّةً أُخْرَى فَيَصِيرُ أَرْبَعَةً، ثُمَّ ثَمَانِيَةً.",
  "fe.02": "الجُزْءُ المُلَوَّنُ نَفْسُهُ: نِصْفٌ، وَرُبْعَانِ، وَأَرْبَعَةُ أَثْمَانٍ. كُسُورٌ مُتَكَافِئَةٌ.",
  "fe.03": "وَعَلَى القِطْعَةِ تَقَعُ كُلُّهَا فِي المَوْضِعِ نَفْسِهِ.",
  "ge.01": "ثُلُثَانِ مِنْ مُسْتَطِيلٍ.",
  "ge.02": "نَقْسِمُهُ أُفُقِيًّا أَيْضًا: صَارَ المُلَوَّنُ أَرْبَعَةَ أَسْدَاسٍ. المَقْدَارُ نَفْسُهُ.",
  "mat.01": "{لَوِّنْ|لَوِّنِي} بِأَقْلَامِ التَّلْوِينِ نِصْفَ شَرِيطِ وَرَقٍ، ثُمَّ {اِطْوِهِ|اِطْوِيهِ} مَرَّةً بَعْدَ مَرَّةٍ، {وَعُدَّ|وَعُدِّي} الأَجْزَاءَ المُلَوَّنَةَ فِي كُلِّ مَرَّةٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: ثُنَائِيَّاتُ الأَشْرِطَةِ! {اِبْحَثْ|اِبْحَثِي} عَنِ الشَّرِيطِ المُكَافِئِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الكُسُورِ المُتَكَافِئَةِ.",
  "pr.eqvF": "كَمْ جُزْءًا نُلَوِّنُ فِي الشَّرِيطِ الثَّانِي لِيَكُونَ المَقْدَارُ نَفْسَهُ؟ الأَوَّلُ:",
  "pr.eqvP": "أَيُّ هَذِهِ الكُسُورِ يُسَاوِي:",
  "ch.find": "قَالَتْ فَوْضَى: نَزِيدُ عَلَى البَسْطِ وَالمَقَامِ اثْنَيْنِ، فَيَبْقَى الكَسْرُ كَمَا هُوَ! أَيُّ هَذِهِ الكُسُورِ يُسَاوِي حَقًّا:",
  "ch.after": [
   "chaos",
   "آه! الزِّيَادَةُ تُغَيِّرُ المِقْدَارَ. الطَّيُّ يُضَاعِفُ الأَجْزَاءَ."
  ],
  "ch.right": "{تَحَقَّقْ|تَحَقَّقِي} بِالرَّسْمِ: هَلِ المُلَوَّنُ بِالمِقْدَارِ نَفْسِهِ؟",
  "ch.wrong": [
   "chaos",
   "نِصْفٌ وَثَلَاثَةُ أَرْبَاعٍ مُتَسَاوِيَانِ: زِدْنَا اثْنَيْنِ."
  ],
  "ms.1": "لِمَاذَا النِّصْفُ وَأَرْبَعَةُ الأَثْمَانِ كَسْرَانِ مُتَكَافِئَانِ؟",
  "ms.1a": "لِأَنَّ الجُزْءَ المُلَوَّنَ بِالمِقْدَارِ نَفْسِهِ.",
  "ms.1b": "لِأَنَّ المَقَامَ ثَمَانِيَةٌ فِي الكَسْرَيْنِ.",
  "ms.1c": "لِأَنَّ فِي كُلٍّ مِنْهُمَا أَرْبَعَةَ أَجْزَاءٍ.",
  "ms.recall": "الكُسُورُ المُتَكَافِئَةُ مِقْدَارٌ وَاحِدٌ بِأَجْزَاءٍ مُخْتَلِفَةٍ: نِصْفٌ وَرُبْعَانِ وَأَرْبَعَةُ أَثْمَانٍ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَجِدُ|صِرْتِ تَجِدِينَ} الكُسُورَ المُتَكَافِئَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "جَمَعْنَا كُلَّ شَرِيطٍ بِمُكَافِئِهِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِطْوِ|اِطْوِي} مِنْدِيلًا نِصْفَيْنِ ثُمَّ أَرْبَعَةً، ثُمَّ {قُلْ|قُولِي} {لِأَهْلِكَ|لِأَهْلِكِ}: النِّصْفُ رُبْعَانِ."
  ]
 },
