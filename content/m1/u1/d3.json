 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةُ دَفْتَرٍ، وَمِنْدِيلٌ مُرَبَّعٌ، وَشَرِيطٌ مِنْ وَرَقٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "بَنَيْتُ لِلْوَاحَةِ بَابًا جَمِيلًا!"
  ],
  "hook.02": "جَاءَتِ الزَّرَافَةُ تَزُورُنَا. مِنْ أَيِّ بَابٍ تَدْخُلُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "hook.03": "رَأْسُهَا لَا يَمُرُّ! هَذَا البَابُ قَصِيرٌ. وَالآخَرُ؟",
  "hook.04": "دَخَلَتْ مِنَ البَابِ الطَّوِيلِ! لَهُ ضِلْعَانِ طَوِيلَانِ، وَضِلْعَانِ قَصِيرَانِ.",
  "hook.05": [
   "chaos",
   "وَكَيْفَ نَعْرِفُ الطَّوِيلَ مِنَ القَصِيرِ؟"
  ],
  "mat.01": "{خُذْ|خُذِي} وَرَقَةَ الدَّفْتَرِ، وَ{اِطْوِهَا|اِطْوِيهَا} فَيَقَعَ ضِلْعٌ عَلَى ضِلْعٍ. أَيُّهُمَا أَطْوَلُ؟ ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "هَيَّا نُقَارِنُ عَلَى الشَّاشَةِ أَيْضًا.",
  "c.01": "أَيُّ العُودَيْنِ أَطْوَلُ؟ قَبْلَ أَنْ نُقَارِنَ، {اِسْحَبِ|اِسْحَبِي} العُودَ الأَسْفَلَ حَتَّى يَبْدَأَ مِنَ الخَطِّ نَفْسِهِ.",
  "c.02": "هَكَذَا: نَضَعُ بِدَايَتَهُ عَلَى الخَطِّ.",
  "c.03": "الآنَ البِدَايَتَانِ مَعًا. أَيُّهُمَا أَطْوَلُ؟ {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "c.04": "لِنُفَكِّرْ مَعًا: {اُنْظُرْ|اُنْظُرِي} إِلَى النِّهَايَتَيْنِ. أَيُّهُمَا يَصِلُ أَبْعَدَ؟",
  "c.05": "العُودُ الأَعْلَى أَطْوَلُ. لَوْ لَمْ نَبْدَأْ مِنَ الخَطِّ نَفْسِهِ لَخُدِعْنَا!",
  "exp.01": "{مَرِّرْ إِصْبَعَكَ|مَرِّرِي إِصْبَعَكِ} عَلَى حَافَّةِ هَذَا الشَّكْلِ، وَ{عُدَّ|عُدِّي} الرُّؤُوسَ.",
  "exp.sides": "أَرْبَعَةُ رُؤُوسٍ! {اِلْمَسْ|اِلْمَسِي} كُلَّ ضِلْعٍ، وَ{لَاحِظِ|لَاحِظِي} الطَّوِيلَ وَالقَصِيرَ.",
  "exp.03": "هَذَا مُسْتَطِيلٌ: أَرْبَعَةُ أَضْلَاعٍ مُسْتَقِيمَةٍ، كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَكُلُّ رُكْنٍ فِيهِ مِثْلُ رُكْنِ الوَرَقَةِ. وَفِي هَذَا المُسْتَطِيلِ ضِلْعَانِ طَوِيلَانِ وَضِلْعَانِ قَصِيرَانِ.",
  "sq.01": "وَالمُرَبَّعُ؟ أَضْلَاعُهُ الأَرْبَعَةُ كُلُّهَا مُتَسَاوِيَةٌ، وَأَرْكَانُهُ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "sq.02": "فَالمُرَبَّعُ فِيهِ كُلُّ مَا فِي المُسْتَطِيلِ، وَزِيَادَةٌ: أَضْلَاعُهُ كُلُّهَا مُتَسَاوِيَةٌ. فَلَهُ اسْمٌ أَخَصُّ: مُرَبَّعٌ.",
  "wk.01": "نُقَارِنُ الضِّلْعَيْنِ الطَّوِيلَيْنِ: نَضَعُ أَحَدَهُمَا عَلَى الآخَرِ بِشَرِيطٍ.",
  "wk.02": "مُتَسَاوِيَانِ! وَالقَصِيرَانِ مُتَسَاوِيَانِ أَيْضًا.",
  "wk.03": "هَلْ مَا زَالَ مُسْتَطِيلًا؟",
  "wk.04": "مَا زَالَ كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَيْنِ: مُسْتَطِيلٌ وَاقِفٌ، مِثْلُ البَابِ!",
  "wk.05": "وَرُكْنُ الوَرَقَةِ يَنْطَبِقُ عَلَى كُلِّ رُكْنٍ فِيهِ.",
  "pr.intro": "هَلْ هَذَا مُسْتَطِيلٌ؟ سِلَالُنَا: لِلْمُسْتَطِيلَاتِ، وَلِلْمُرَبَّعَاتِ، وَ«غَيْرُ ذَلِكَ».",
  "acc.sq": "نَعَمْ، هُوَ مُسْتَطِيلٌ. وَلَهُ اسْمٌ أَخَصُّ: مُرَبَّعٌ.",
  "why.r": "أَرْبَعَةُ أَضْلَاعٍ، كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَكُلُّ رُكْنٍ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "why.rRot": "كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَأَرْكَانُهُ مِثْلُ رُكْنِ الوَرَقَةِ، حَتَّى وَهُوَ مَائِلٌ.",
  "why.sq": "أَضْلَاعُهُ الأَرْبَعَةُ مُتَسَاوِيَةٌ، وَأَرْكَانُهُ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "why.quad": "أَحَدُ أَرْكَانِهِ لَيْسَ مِثْلَ رُكْنِ الوَرَقَةِ.",
  "why.open": "يَنْقُصُهُ ضِلْعٌ: فِيهِ فَتْحَةٌ.",
  "why.other": "لَيْسَ لَهُ أَرْبَعَةُ أَضْلَاعٍ.",
  "g.intro": "لُعْبَةُ «خَمِّنِ الشَّكْلَ»: {اِسْمَعِ|اِسْمَعِي} التَّلْمِيحَاتِ، وَ{اِلْمَسِ|اِلْمَسِي} الشَّكْلَ حِينَ {تَعْرِفُهُ|تَعْرِفِينَهُ}.",
  "g.why": "فِي هَذَا المُسْتَطِيلِ ضِلْعَانِ أَطْوَلُ مِنَ الآخَرَيْنِ، وَكُلُّ رُكْنٍ فِيهِ مِثْلُ رُكْنِ الوَرَقَةِ.",
  "g.r1": "لِي أَرْبَعَةُ أَضْلَاعٍ…",
  "g.r2": "اثْنَانِ مِنْهَا أَطْوَلُ مِنَ الآخَرَيْنِ…",
  "g.r3": "وَكُلُّ رُكْنٍ فِيَّ مِثْلُ رُكْنِ الوَرَقَةِ. مَنْ أَنَا؟",
  "g.t1": "حَوَافِّي كُلُّهَا مُسْتَقِيمَةٌ…",
  "g.t2": "وَلِي ثَلَاثَةُ رُؤُوسٍ. مَنْ أَنَا؟",
  "g.c1": "لَيْسَ لِي رُؤُوسٌ…",
  "g.c2": "وَحَافَّتِي مُنْحَنِيَةٌ كُلُّهَا. مَنْ أَنَا؟",
  "ch.after": "كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ: مُسْتَطِيلٌ وَاقِفٌ. مَكَانُهُ سَلَّةُ المُسْتَطِيلَاتِ.",
  "ch.right": "المُسْتَطِيلُ الوَاقِفُ مَا زَالَ مُسْتَطِيلًا.",
  "ch.wrong": [
   "chaos",
   "الوَاقِفُ عَمُودٌ، لَا مُسْتَطِيلٌ."
  ],
  "ms.recall": "المُسْتَطِيلُ: أَرْبَعَةُ أَضْلَاعٍ، كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَسَاوِيَانِ، وَكُلُّ رُكْنٍ مِثْلُ رُكْنِ الوَرَقَةِ، وَاقِفًا أَوْ نَائِمًا أَوْ مَائِلًا.",
  "ms.ok": "رَائِعٌ! {أَتْقَنْتَ|أَتْقَنْتِ} المُسْتَطِيلَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَارَ لِلْوَاحَةِ بَوَّابَةٌ طَوِيلَةٌ، تَدْخُلُ مِنْهَا الزَّرَافَةُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} عَنْ بَابٍ وَنَافِذَةٍ، وَ{قَارِنْ|قَارِنِي} أَضْلَاعَهُمَا بِشَرِيطٍ مِنْ وَرَقٍ، مِنْ بِدَايَةٍ وَاحِدَةٍ."
  ]
 },
