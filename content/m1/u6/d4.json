  "ask": "bag.ask",
  "adult": "ورقة يرسم عليها الطفل شيئاً متماثلاً من البيت ويطويها. والطلاء القابل للغسل بإشراف الكبار إن أرادوا لوحة مطوية حقيقية.",
  "screenPath": "على الشاشة يطوي الطفل صور الأشياء ويصنع لوحة طلاء مطوية؛ ورسمه وطيّه بيديه في مسار «معي»."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ نَطْوِيهَا؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "هَذِهِ السَّيَّارَةُ مُتَمَاثِلَةٌ!"
  ],
  "hook.02": "هَلْ هَذَا صَحِيحٌ؟ {اِلْمِسِ|اِلْمِسِي} السَّيَّارَةَ لِنَطْوِيَ صُورَتَهَا.",
  "hook.03": "مِنَ الجَانِبِ لَا يَنْطَبِقُ الجُزْءَانِ. فَمَاذَا لَوْ نَظَرْنَا إِلَيْهَا مِنَ الأَمَامِ؟",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى الوَرَقَةِ شَيْئًا مُتَمَاثِلًا مِنَ البَيْتِ، ثُمَّ {اِطْوِهَا|اِطْوِيهَا} عِنْدَ خَطِّ تَمَاثُلِهِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "exp.01": "{اِلْمِسْ|اِلْمِسِي} كُلَّ صُورَةٍ لِنَطْوِيَهَا.",
  "exp.02": "السَّيَّارَةُ مِنَ الأَمَامِ مُتَمَاثِلَةٌ.",
  "exp.03": "الوَجْهُ فِي الصُّورَةِ نِصْفَاهُ يَنْطَبِقَانِ.",
  "exp.04": "الفَرَاشَةُ مُتَمَاثِلَةٌ: جَنَاحٌ يُقَابِلُ جَنَاحًا.",
  "exp.05": "وَرَقَةُ الشَّجَرِ جُزْءَاهَا مُتَشَابِهَانِ وَلَا يَنْطَبِقَانِ تَمَامًا.",
  "exp.06": "التَّمَاثُلُ حَوْلَنَا فِي أَشْيَاءَ كَثِيرَةٍ، وَفِي الطَّبِيعَةِ يَكُونُ تَقْرِيبِيًّا.",
  "lt.01": "وَهَذِهِ حُرُوفٌ. {اِلْمِسْ|اِلْمِسِي} كُلَّ حَرْفٍ لِنَطْوِيَهُ، وَ{اُنْظُرْ|اُنْظُرِي}: هَلِ انْطَبَقَ جُزْءَاهُ؟",
  "lt.02": "الحَرْفُ نَحْكُمُ عَلَيْهِ بِالطَّيِّ كَمَا نَرَاهُ مَكْتُوبًا أَمَامَنَا.",
  "pt.01": "فَنَّانُ الطِّلَاءِ المَطْوِيِّ! {اِلْمِسِ|اِلْمِسِي} النِّصْفَ الأَيْسَرَ مِنَ الوَرَقَةِ لِنَضَعَ بُقَعَ الطِّلَاءِ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ» لِنَطْوِيَهَا.",
  "pt.02": "اِنْطَبَعَ الطِّلَاءُ فِي النِّصْفِ الآخَرِ: لَوْحَةٌ مُتَمَاثِلَةٌ، وَخَطُّ الطَّيِّ خَطُّ تَمَاثُلِهَا.",
  "wk.01": "أَيْنَ خَطُّ تَمَاثُلِ الوَجْهِ؟ نَطْوِي عِنْدَ الخَطِّ الأَوَّلِ.",
  "wk.02": "لَمْ يَنْطَبِقِ الجُزْءَانِ. {اِلْمِسْ|اِلْمِسِي} رَأْسَ الخَطِّ الآخَرِ.",
  "wk.03": "اِنْطَبَقَ النِّصْفَانِ: خَطُّ تَمَاثُلِ الوَجْهِ يَمُرُّ بَيْنَ العَيْنَيْنِ.",
  "game.01": "صَيْدُ التَّمَاثُلِ! {اِبْحَثْ|اِبْحَثِي} بَيْنَ الأَشْيَاءِ.",
  "gm.q": "أَيُّ شَيْءٍ مُتَمَاثِلٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "gm.qn": "أَيُّ شَيْءٍ لَيْسَ مُتَمَاثِلًا؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.intro": "هَيَّا نَصْطَادُ التَّمَاثُلَ.",
  "pr.1": "أَيُّ خَطٍّ خَطُّ تَمَاثُلٍ لِهَذَا الشَّكْلِ؟ {اِلْمِسْ|اِلْمِسِي} رَأْسَهُ.",
  "pr.2": "{حَرِّكِ|حَرِّكِي} المِرْآةَ حَتَّى يَظْهَرَ الشَّكْلُ كَامِلًا، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.3": "{اِلْمِسِ|اِلْمِسِي} الصُّورَةَ لِنَطْوِيَهَا: هَلْ يَنْطَبِقُ الجُزْءَانِ؟",
  "ch.find": "فَوْضَى تَقُولُ: وَرَقَةُ الشَّجَرِ نِصْفَاهَا مُتَطَابِقَانِ تَمَامًا! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَطْوِيَ صُورَتَهَا.",
  "ch.ask": "هَلْ يَنْطَبِقُ الجُزْءَانِ تَمَامًا؟",
  "ch.after": "بَقِيَ جُزْءٌ صَغِيرٌ ظَاهِرٌ: تَمَاثُلُ وَرَقَةِ الشَّجَرِ تَقْرِيبِيٌّ.",
  "ch.right": "التَّمَاثُلُ فِي الطَّبِيعَةِ تَقْرِيبِيٌّ.",
  "ch.wrong": [
   "chaos",
   "كُلُّ مَا فِي الطَّبِيعَةِ نِصْفَاهُ مُتَطَابِقَانِ تَمَامًا."
  ],
  "ms.3": "لِمَاذَا السَّيَّارَةُ مِنَ الجَانِبِ لَيْسَتْ مُتَمَاثِلَةً؟",
  "ms.3a": "لِأَنَّ جُزْأَيْهَا لَا يَنْطَبِقَانِ بِالطَّيِّ.",
  "ms.3b": "لِأَنَّ لَوْنَهَا أَحْمَرُ وَنَافِذَتَهَا زَرْقَاءُ.",
  "ms.3c": "لِأَنَّ لَهَا عَجَلَةً فِي كُلِّ طَرَفٍ.",
  "ms.recall": "نَطْوِي صُورَةَ الشَّيْءِ: إِنْ غَابَ نِصْفُهَا تَحْتَ أَخِيهِ فَهُوَ مُتَمَاثِلٌ، وَخَطُّ الطَّيِّ خَطُّ تَمَاثُلِهِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَصْطَادُ|صِرْتِ تَصْطَادِينَ} التَّمَاثُلَ فِي كُلِّ مَكَانٍ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "عَلَّقْنَا فِي الوَاحَةِ لَوْحَةً مِنَ الطِّلَاءِ المَطْوِيِّ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} فِي البَيْتِ عَنْ ثَلَاثَةِ أَشْيَاءَ مُتَمَاثِلَةٍ، وَ{أَرِ|أَرِي} {أَهْلَكَ|أَهْلَكِ} خَطَّ تَمَاثُلِ كُلٍّ مِنْهَا."
  ]
 },
