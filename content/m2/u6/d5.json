 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "حِجَارَةُ الوَاحَةِ تَنْتَظِرُ. فَوْضَى تَقِيسُ بِطُرُقٍ خَاطِئَةٍ، وَنَحْنُ نُصَحِّحُ.",
  "hook.02": "مَنْ يُجِيبُ يَأْخُذُ شَارَةَ المِسْطَرَةِ، وَالحَجَرَ السَّادِسَ.",
  "mat.01": "{قِسْ|قِيسِي} بِشَرِيطِ القِيَاسِ شَيْئًا كَبِيرًا، وَبِالمِسْطَرَةِ شَيْئًا صَغِيرًا، {وَاكْتُبْ|وَاكْتُبِي} كُلَّ طُولٍ بِالمِتْرِ وَالسَّنْتِيمِتْرِ، وَبِالسَّنْتِيمِتْرِ وَحْدَهُ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: فِي المِتْرِ مِئَةُ سَنْتِيمِتْرٍ، وَفِي الكِيلُومِتْرِ أَلْفُ مِتْرٍ.",
  "rv.02": "نَضْرِبُ إِلَى الوَحْدَةِ الأَصْغَرِ، وَنَقْسِمُ إِلَى الأَكْبَرِ، وَنُقَارِنُ بِوَحْدَةٍ وَاحِدَةٍ.",
  "rv.03": "وَفِي الجَمْعِ: كُلُّ مِئَةِ سَنْتِيمِتْرٍ مِتْرٌ.",
  "gm.intro": "لُعْبَةُ: مُغَامَرَةُ فَوْضَى القِيَاسِيَّةُ! {صَحِّحْ|صَحِّحِي} لَهَا مَا تُخْطِئُ فِيهِ.",
  "gm.unit": "قَاسَتْ فَوْضَى بِوَحْدَةٍ لَا تُنَاسِبُ. أَيُّ وَحْدَةٍ أَنْسَبُ لِقِيَاسِ:",
  "gm.conv": "حَوَّلَتْ فَوْضَى خَطَأً. كَمْ يُسَاوِي:",
  "gm.add": "جَمَعَتْ فَوْضَى بِلَا إِعَادَةِ تَجْمِيعٍ. كَمْ يَكُونُ المَجْمُوعُ حَقًّا؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "q.unit": "أَيُّ وَحْدَةٍ أَنْسَبُ لِقِيَاسِ:",
  "q.est": "{قَدِّرْ|قَدِّرِي}:",
  "q.conv": "كَمْ يُسَاوِي:",
  "q.machine": "{اِضْبِطْ|اِضْبِطِي} آلَةَ فِرْجَارٍ: أَيُّ عَمَلِيَّةٍ تُحَوِّلُ هَذَا الطُّولَ؟",
  "q.order": "{رَتِّبِ|رَتِّبِي} الأَطْوَالَ: {اِلْمِسِ|اِلْمِسِي} الأَقْصَرَ أَوَّلًا، ثُمَّ الأَطْوَلَ فَالأَطْوَلَ.",
  "q.add": "كَمْ يَكُونُ المَجْمُوعُ؟",
  "q.sub": "كَمْ يَبْقَى؟",
  "q.tape": "كَمْ طُولُهُ؟ {اِقْرَأْ|اِقْرَئِي} شَرِيطَ القِيَاسِ.",
  "q.ruler": "كَمْ طُولُ القَلَمِ؟",
  "q.fence": "قِطَعُ سِلْكٍ لِسُورٍ طُولُهُ تِسْعَةُ أَمْتَارٍ: {اِخْتَرْ|اِخْتَارِي} قِطَعًا مَجْمُوعُهَا طُولُ السُّورِ تَمَامًا، ثُمَّ «تَمَّ».",
  "q.cmp": "أَيُّهُمَا أَطْوَلُ؟",
  "ts.10": "جَمَعَ طَالِبٌ مِتْرَيْنِ وَأَرْبَعِينَ سَنْتِيمِتْرًا وَمِتْرًا وَثَمَانِينَ، فَكَتَبَ: ثَلَاثَةُ أَمْتَارٍ وَمِئَةٌ وَعِشْرُونَ. مَا خَطَؤُهُ؟",
  "ts.10a": "لَمْ يَنْقُلِ المِئَةَ سَنْتِيمِتْرٍ إِلَى الأَمْتَارِ.",
  "ts.10b": "أَخْطَأَ فِي جَمْعِ الأَمْتَارِ وَحْدَهَا.",
  "ts.10c": "كَانَ عَلَيْهِ أَنْ يَطْرَحَ بَدَلَ أَنْ يَجْمَعَ.",
  "ts.12": "لِمَاذَا لَا يَكْفِي أَنْ نَقُولَ: طُولُهَا خَمْسَةٌ؟",
  "ts.12a": "لِأَنَّ خَمْسَةَ سَنْتِيمِتْرَاتٍ غَيْرُ خَمْسَةِ أَمْتَارٍ.",
  "ts.12b": "لِأَنَّ الخَمْسَةَ عَدَدٌ صَغِيرٌ لَا يُقَالُ فِي القِيَاسِ.",
  "ts.12c": "لِأَنَّنَا نَكْتُبُ الأَطْوَالَ بِالحُرُوفِ لَا بِالأَرْقَامِ.",
  "ts.rem": "نَقِيسُ مَعَ الكِبَارِ أَشْيَاءَ فِي البَيْتِ بِشَرِيطِ القِيَاسِ؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": "هَذَا الحَجَرُ السَّادِسُ لِلْوَاحَةِ!",
  "ts.win1": "{أَنْتَ سَيِّدُ|أَنْتِ سَيِّدَةُ} المِسْطَرَةِ!",
  "ts.win2": "{عَرَفْتَ|عَرَفْتِ} الوَحَدَاتِ وَالتَّحْوِيلَ وَالجَمْعَ وَالطَّرْحَ.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ المِسْطَرَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قَدِّرْ|قَدِّرِي} ثُمَّ {قِسْ|قِيسِي} بِالشَّرِيطِ عَرْضَ البَابِ، وَطُولَ السَّرِيرِ، {وَطُولَكَ|وَطُولَكِ} عِنْدَ إِطَارِ البَابِ، {وَرَتِّبْهَا|وَرَتِّبِيهَا} مِنَ الأَقْصَرِ إِلَى الأَطْوَلِ."
  ]
 },
