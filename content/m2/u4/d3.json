  "ask": "bag.ask",
  "adult": "ورقة وأقلام ملوّنة.",
  "screenPath": "على الشاشة يلوّن الطفل الأضلاع المتجاورة والمتقابلة، ويفحص المربع والمستطيل بالأسئلة الثلاثة ويسمّيهما بالقياس؛ والتلوين الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagRect": "وَرَقَةٌ وَأَقْلَامٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ وَأَقْلَامٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "ao.01": "هَذَا مُسْتَطِيلٌ رُؤُوسُهُ أَلِف بَاء جِيم دَال. {اِلْمِسِ|اِلْمِسِي} الضِّلْعَ أَلِف بَاء.",
  "ao.02": "{اِلْمِسْ|اِلْمِسِي} ضِلْعًا يَلْتَقِي بِهِ عِنْدَ رَأْسٍ.",
  "ao.03": "وَضِلْعٌ آخَرُ يَلْتَقِي بِهِ عِنْدَ رَأْسِهِ الآخَرِ. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ao.04": "هَذَانِ الضِّلْعَانِ مُجَاوِرَانِ لِلضِّلْعِ أَلِف بَاء: يَلْتَقِيَانِ بِهِ.",
  "ao.05": "وَالضِّلْعُ البَاقِي لَا يَلْتَقِي بِهِ أَبَدًا. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ao.06": "هُوَ المُقَابِلُ: جِيم دَال يُقَابِلُ أَلِف بَاء.",
  "ao.07": "وَالزَّوَايَا كَذَلِكَ: المُتَجَاوِرَتَانِ تَشْتَرِكَانِ فِي ضِلْعٍ، وَالمُتَقَابِلَتَانِ لَا تَشْتَرِكَانِ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} عَلَى الوَرَقَةِ مُسْتَطِيلًا، وَ{لَوِّنْ|لَوِّنِي} بِالأَقْلَامِ أَضْلَاعَهُ المُتَقَابِلَةَ بِلَوْنٍ وَاحِدٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "qs.01": "نَفْحَصُ المُرَبَّعَ بِثَلَاثَةِ أَسْئِلَةٍ.",
  "qs.02": "هَلْ فِيهِ أَضْلَاعٌ مُتَوَازِيَةٌ؟ {اِلْمِسِ|اِلْمِسِي} الشَّكْلَ: كُلُّ ضِلْعَيْنِ مُتَقَابِلَيْنِ مُتَوَازِيَانِ.",
  "qs.03": "هَلْ أَضْلَاعُهُ مُتَسَاوِيَةٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}: الأَرْبَعَةُ مُتَسَاوِيَةٌ.",
  "qs.04": "هَلْ زَوَايَاهُ قَائِمَةٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}: الأَرْبَعُ قَائِمَةٌ.",
  "qs.05": "هَذَا هُوَ المُرَبَّعُ.",
  "qr.01": "وَنَفْحَصُ المُسْتَطِيلَ بِالأَسْئِلَةِ نَفْسِهَا.",
  "qr.02": "هَلْ فِيهِ أَضْلَاعٌ مُتَوَازِيَةٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}: المُتَقَابِلَانِ مُتَوَازِيَانِ.",
  "qr.03": "هَلْ أَضْلَاعُهُ مُتَسَاوِيَةٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}: الأَضْلَاعُ المُتَقَابِلَةُ مُتَسَاوِيَةٌ، وَالمُتَجَاوِرَةُ لَا.",
  "qr.04": "هَلْ زَوَايَاهُ قَائِمَةٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}: الأَرْبَعُ قَائِمَةٌ.",
  "qr.05": "هَذَا هُوَ المُسْتَطِيلُ.",
  "st.01": "مُرَبَّعٌ بِعَلَامَاتِهِ. {اِلْمِسْهُ|اِلْمِسِيهِ} لِنُمِيلَهُ.",
  "st.02": "مَالَ، وَبَقِيَتْ أَضْلَاعُهُ مُتَسَاوِيَةً وَزَوَايَاهُ قَائِمَةً: مَا زَالَ مُرَبَّعًا.",
  "game.01": "لُعْبَةُ: أَلْوَانُ الأَضْلَاعِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الرُّبَاعِيَّاتِ.",
  "pr.oppSide0": "{اِلْمِسِ|اِلْمِسِي} الضِّلْعَ المُقَابِلَ لِلضِّلْعِ المُلَوَّنِ.",
