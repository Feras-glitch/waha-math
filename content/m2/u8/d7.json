 ],
 "concepts": {
  "C226": "المقارنة بالتكافؤ بصرياً على شريط الاثني عشر، وترتيب الكسور من الأصغر إلى الأكبر (منقولان من د6 لأنه فوق السقف)"
 },
 "bag": {
  "items": [
   {
    "icon": "strips",
    "label": "bagStrips"
   },
   {
    "icon": "ruler",
    "label": "bagRuler"
