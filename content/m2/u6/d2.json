 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ قِيَاسٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "ct.01": "نَمْلَأُ جَدْوَلَ التَّحْوِيلِ: المِتْرُ، وَالسَّنْتِيمِتْرُ، وَالمِلِّيمِتْرُ.",
  "ct.02": "مِنَ الوَحْدَةِ الكَبِيرَةِ إِلَى الصَّغِيرَةِ نَضْرِبُ: العَدَدُ يَكْبُرُ، لِأَنَّنَا نَعُدُّ قِطَعًا أَصْغَرَ.",
  "ct.03": "وَمِنَ الصَّغِيرَةِ إِلَى الكَبِيرَةِ نَقْسِمُ: العَدَدُ يَصْغُرُ.",
  "mat.01": "{قِسْ|قِيسِي} بِشَرِيطِ القِيَاسِ شَيْئًا أَطْوَلَ مِنَ المِتْرِ، وَبِالمِسْطَرَةِ شَيْئًا قَصِيرًا، {وَاكْتُبْ|وَاكْتُبِي} كُلَّ طُولٍ بِالسَّنْتِيمِتْرِ وَبِالمِتْرِ وَالسَّنْتِيمِتْرِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "mc.01": "هَذَا الشَّرِيطُ طُولُهُ مِئَتَانِ وَخَمْسَةٌ وَثَلَاثُونَ سَنْتِيمِتْرًا. نَقْطَعُ مِنْهُ أَمْتَارًا.",
  "mc.02": "مِتْرَانِ، وَيَبْقَى خَمْسَةٌ وَثَلَاثُونَ سَنْتِيمِتْرًا: هَذَا طُولٌ مُرَكَّبٌ.",
  "cp.01": "أَيُّهُمَا أَطْوَلُ: مِتْرَانِ أَمْ مِئَةٌ وَخَمْسُونَ سَنْتِيمِتْرًا؟",
  "cp.02": "نُحَوِّلُ أَوَّلًا إِلَى وَحْدَةٍ وَاحِدَةٍ: المِتْرَانِ مِئَتَا سَنْتِيمِتْرٍ.",
  "cp.03": "الآنَ نُقَارِنُ: المِتْرَانِ أَطْوَلُ.",
  "game.01": "لُعْبَةُ: مُحَوِّلُ فِرْجَارٍ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى التَّحْوِيلِ وَالمُقَارَنَةِ.",
  "pr.machine": "{اِضْبِطْ|اِضْبِطِي} آلَةَ فِرْجَارٍ: أَيُّ عَمَلِيَّةٍ تُحَوِّلُ هَذَا الطُّولَ إِلَى الوَحْدَةِ الأُخْرَى؟",
  "pr.conv": "كَمْ يُسَاوِي:",
  "pr.toMC": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالمِتْرِ وَالسَّنْتِيمِتْرِ:",
  "pr.toCM": "{اُكْتُبْهُ|اُكْتُبِيهِ} بِالسَّنْتِيمِتْرِ:",
  "pr.cmp": "أَيُّهُمَا أَطْوَلُ؟",
  "pr.order": "{رَتِّبِ|رَتِّبِي} الأَطْوَالَ: {اِلْمِسِ|اِلْمِسِي} الأَقْصَرَ أَوَّلًا، ثُمَّ الأَطْوَلَ فَالأَطْوَلَ.",
  "ch.find": "تَقُولُ فَوْضَى: خَمْسُونَ سَنْتِيمِتْرًا أَطْوَلُ مِنْ مِتْرَيْنِ، لِأَنَّ خَمْسِينَ أَكْبَرُ مِنِ اثْنَيْنِ! أَيُّهُمَا أَطْوَلُ؟",
  "ch.after": [
   "chaos",
   "آه! نُحَوِّلُ إِلَى وَحْدَةٍ وَاحِدَةٍ قَبْلَ أَنْ نُقَارِنَ."
  ],
  "ch.right": "المِتْرَانِ مِئَتَا سَنْتِيمِتْرٍ، وَهُمَا أَطْوَلُ.",
  "ch.wrong": [
   "chaos",
   "العَدَدُ الأَكْبَرُ هُوَ الأَطْوَلُ دَائِمًا."
  ],
  "ms.1": "حِينَ نُحَوِّلُ مِنَ المِتْرِ إِلَى السَّنْتِيمِتْرِ: لِمَاذَا يَكْبُرُ العَدَدُ؟",
  "ms.1a": "السَّنْتِيمِتْرُ أَصْغَرُ، فَنَحْتَاجُ مِنْهُ أَكْثَرَ.",
  "ms.1b": "الطُّولُ نَفْسُهُ يَكْبُرُ حِينَ نُحَوِّلُهُ.",
  "ms.1c": "لِأَنَّنَا نَقْسِمُ عَلَى مِئَةٍ فِي كُلِّ تَحْوِيلٍ.",
  "ms.recall": "مِنَ الوَحْدَةِ الكَبِيرَةِ إِلَى الصَّغِيرَةِ نَضْرِبُ، وَمِنَ الصَّغِيرَةِ إِلَى الكَبِيرَةِ نَقْسِمُ.",
  "ms.recall2": "نُحَوِّلُ إِلَى وَحْدَةٍ وَاحِدَةٍ، ثُمَّ نُقَارِنُ أَوْ نُرَتِّبُ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُحَوِّلُ|صِرْتِ تُحَوِّلِينَ} وَ{تُقَارِنُ|تُقَارِنِينَ} الأَطْوَالَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "آلَةُ فِرْجَارٍ تَعْمَلُ: نَضْرِبُ إِلَى الأَصْغَرِ، وَنَقْسِمُ إِلَى الأَكْبَرِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {قِسْ|قِيسِي} {طُولَكَ|طُولَكِ} عِنْدَ إِطَارِ البَابِ، {وَاكْتُبْهُ|وَاكْتُبِيهِ} بِصِيغَتَيْنِ: بِالمِتْرِ وَالسَّنْتِيمِتْرِ، وَبِالسَّنْتِيمِتْرِ وَحْدَهُ."
  ]
