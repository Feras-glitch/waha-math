  "ask": "bag.ask",
  "adult": "ورقة تُطوى. والقصّ بمقص آمن بيد الكبير أو بإشرافه.",
  "screenPath": "على الشاشة يلمس الطفل الشكل فيُطوى أمامه ويرى هل ينطبق النصفان؛ وطيّ الورقة بيديه في مسار «معي»."
 },
 "labels": {
  "bagPaper": "وَرَقَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةٌ نَطْوِيهَا؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "هَذَا قَلْبٌ مِنْ وَرَقٍ. هَلْ يَنْقَسِمُ إِلَى قِطْعَتَيْنِ مُتَشَابِهَتَيْنِ تَمَامًا؟ {اِلْمِسْهُ|اِلْمِسِيهِ} لِنَطْوِيَهُ.",
  "hook.02": "غَابَتْ قِطْعَةٌ تَحْتَ الأُخْرَى! هَيَّا نَكْتَشِفُ السِّرَّ.",
  "mat.01": "{اِطْوِ|اِطْوِي} الوَرَقَةَ حَتَّى تَقَعَ حَافَّةٌ عَلَى حَافَّةٍ، وَ{اُنْظُرْ|اُنْظُرِي}: هَلْ غَطَّى جُزْءٌ مِنْهَا الجُزْءَ الآخَرَ تَمَامًا؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "exp.01": "{اِلْمِسْ|اِلْمِسِي} كُلَّ شَكْلٍ لِنَطْوِيَهُ.",
  "exp.02": "اِنْطَبَقَ النِّصْفَانِ.",
  "exp.03": "القَلْبُ مَقْلُوبٌ، وَالنِّصْفَانِ يَنْطَبِقَانِ أَيْضًا.",
  "exp.04": "القَلْبُ مَائِلٌ، وَالنِّصْفَانِ يَنْطَبِقَانِ أَيْضًا.",
  "exp.05": "هَذَا المُثَلَّثُ أَضْلَاعُهُ مُخْتَلِفَةٌ: بَقِيَ جُزْءٌ ظَاهِرٌ، فَالقِطْعَتَانِ لَا تَنْطَبِقَانِ.",
  "exp.06": "الشَّكْلُ الَّذِي يَنْطَبِقُ نِصْفَاهُ بِالطَّيِّ نُسَمِّيهِ: شَكْلًا مُتَمَاثِلًا.",
  "hf.01": "{اِلْمِسِ|اِلْمِسِي} الخَطَّ لِنَقُصَّ القَلْبَ عِنْدَ خَطِّ الطَّيِّ.",
  "hf.02": "القِطْعَتَانِ تَنْطَبِقَانِ، فَهُمَا مُتَسَاوِيَتَانِ. كُلُّ قِطْعَةٍ مِنْهُمَا اسْمُهَا: نِصْفٌ.",
  "hf.03": "{اِلْمِسْ|اِلْمِسِي} نِصْفًا لِنَضُمَّ النِّصْفَيْنِ.",
  "hf.04": "نِصْفَانِ مَعًا: عَادَ القَلْبُ كَامِلًا.",
  "wk.01": "هَذَا رَغِيفٌ لِطِفْلَيْنِ. نَطْوِيهِ مِنْ مُنْتَصَفِهِ لِنَقْسِمَهُ بِالعَدْلِ. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "wk.02": "اِنْطَبَقَ النِّصْفَانِ: لِكُلِّ طِفْلٍ نِصْفُ الرَّغِيفِ.",
  "game.01": "قَصَّاصُ الأَشْكَالِ! قَصَصْنَا مِنْ وَرَقَةٍ مَطْوِيَّةٍ. مَا الَّذِي يَظْهَرُ حِينَ نَفْتَحُهَا؟",
  "gm.q": "مَا الشَّكْلُ الَّذِي يَظْهَرُ حِينَ نَفْتَحُ الوَرَقَةَ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الطَّيِّ.",
  "pr.1": "{اِلْمِسِ|اِلْمِسِي} الشَّكْلَ لِنَطْوِيَهُ: هَلْ يَنْطَبِقُ الجُزْءَانِ؟",
  "pr.2": "أَيُّ شَكْلٍ يَنْطَبِقُ نِصْفَاهُ بِالطَّيِّ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.2n": "أَيُّ شَكْلٍ لَا يَنْطَبِقُ نِصْفَاهُ بِالطَّيِّ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.3": "أَيُّ الصُّورَتَيْنِ قُسِمَتْ نِصْفَيْنِ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.3n": "أَيُّ الصُّورَتَيْنِ لَمْ تُقْسَمْ نِصْفَيْنِ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.4": "عِنْدَ أَيِّ خَطٍّ نَقُصُّ لِنَحْصُلَ عَلَى نِصْفَيْنِ؟ {اِلْمِسْ|اِلْمِسِي} رَأْسَ الخَطِّ.",
  "ch.find": "فَوْضَى قَصَّتِ الوَرَقَةَ وَقَالَتْ: هَذَا هُوَ النِّصْفُ! {اِلْمِسْ|اِلْمِسِي} قِطْعَةً لِنَضَعَهَا عَلَى الأُخْرَى.",
  "ch.ask": "هَلِ القِطْعَتَانِ تَنْطَبِقَانِ؟",
  "ch.after": "قِطْعَةٌ كَبِيرَةٌ وَقِطْعَةٌ صَغِيرَةٌ: لَيْسَتَا نِصْفَيْنِ.",
  "ch.right": "النِّصْفَانِ قِطْعَتَانِ مُتَطَابِقَتَانِ.",
  "ch.wrong": [
   "chaos",
   "أَيُّ قِطْعَتَيْنِ مِنَ الوَرَقَةِ نِصْفَانِ."
  ],
  "ms.3": "لِمَاذَا هَذِهِ الشَّجَرَةُ مُتَمَاثِلَةٌ؟",
  "ms.3a": "لِأَنَّ نِصْفَيْهَا يَنْطَبِقَانِ بِالطَّيِّ.",
  "ms.3b": "لِأَنَّهَا خَضْرَاءُ وَلَهَا جِذْعٌ.",
  "ms.3c": "لِأَنَّ رَأْسَهَا إِلَى الأَعْلَى.",
  "ms.recall": "نَطْوِي الشَّكْلَ: إِنْ غَابَ نِصْفُهُ تَحْتَ أَخِيهِ فَهُوَ مُتَمَاثِلٌ.",
  "ms.recall2": "النِّصْفَانِ قِطْعَتَانِ مُتَطَابِقَتَانِ: نَضَعُ قِطْعَةً عَلَى الأُخْرَى فَتَنْطَبِقَانِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} الشَّكْلَ المُتَمَاثِلَ وَالنِّصْفَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "عَلَّقْنَا فِي الوَاحَةِ قُلُوبًا مِنْ وَرَقٍ، نِصْفَاهَا مُتَطَابِقَانِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِطْوِ|اِطْوِي} وَرَقَةً، وَ{اُطْلُبْ|اُطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} أَنْ يَقُصُّوا مِنْهَا نِصْفَ قَلْبٍ، ثُمَّ {اِفْتَحْهَا|اِفْتَحِيهَا}."
  ]
 },
