  ],
  "ts.win1": "{أَنْتَ بَانِي العَالَمِ|أَنْتِ بَانِيَةُ العَالَمِ}!",
  "ts.win2": "جَرَى المَاءُ فِي جَدْوَلِ «وَرْشَةِ المُجَسَّمَاتِ»، وَاخْضَرَّتْ نَخْلَتَانِ!",
