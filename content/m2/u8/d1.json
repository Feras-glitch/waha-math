{
 "id": "m2.u8.d1",
 "title": "كَعْكَةُ فَوْضَى",
 "icon": [
  "frcake"
 ],
 "concepts": {
  "C220": "الكسر جزء من كلّ مقسوم أجزاء متساوية: النصف والثلث والربع، والأجزاء كلها الواحد الصحيح"
 },
 "bag": {
  "items": [
   {
    "icon": "strips",
    "label": "bagStrips"
   },
   {
    "icon": "circles",
    "label": "bagCircles"
   }
  ],
  "ask": "bag.ask",
  "adult": "شرائط ورقية ودوائر ورقية للطي (الأثلاث بقصاصات جاهزة، لأن طيّها صعب).",
  "screenPath": "على الشاشة يرى الطفل الكعكة المقطوعة بغير عدل، والشريط يُطوى نصفين ثم أربعة، ويختار الشكل المقسوم أجزاء متساوية ويسمّي الجزء؛ والطيّ الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagStrips": "شَرِيطُ وَرَقٍ",
  "bagCircles": "دَائِرَةٌ وَرَقِيَّةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ وَرَقٍ وَدَائِرَةٌ وَرَقِيَّةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "home.back": "{حَسَبْتَ|حَسَبْتِ} مُحِيطَ السَّجَّادَةِ {وَعَدَدْتَ|وَعَدَدْتِ} بَلَاطَهَا. اليَوْمَ تَقْطَعُ فَوْضَى كَعْكَةً وَتَقُولُ إِنَّ كُلَّ قِطْعَةٍ رُبْعٌ: هَلِ القِطَعُ مُتَسَاوِيَةٌ؟ وَكَيْفَ نَتَأَكَّدُ؟",
  "ck.01": "قَطَعَتْ فَوْضَى الكَعْكَةَ أَرْبَعَ قِطَعٍ، وَقَالَتْ: هَذِهِ القِطْعَةُ الصَّغِيرَةُ رُبْعٌ!",
  "ck.02": "لَكِنَّ القِطَعَ مُخْتَلِفَةُ الأَحْجَامِ: هَلْ هَذَا عَدْلٌ؟",
  "fs.01": "نَطْوِي شَرِيطَ الوَرَقِ حَتَّى تَنْطَبِقَ الحَافَّتَانِ.",
  "fs.02": "جُزْءَانِ مُتَطَابِقَانِ: كُلُّ جُزْءٍ نِصْفٌ.",
  "fs.03": "وَنَطْوِيهِ مَرَّةً ثَانِيَةً: أَرْبَعَةُ أَجْزَاءٍ مُتَسَاوِيَةٍ، كُلُّ جُزْءٍ رُبْعٌ. الكَسْرُ يَحْتَاجُ أَجْزَاءً مُتَسَاوِيَةً.",
  "pn.01": "جُزْءٌ مِنِ اثْنَيْنِ مُتَسَاوِيَيْنِ نِصْفٌ، وَمِنْ ثَلَاثَةٍ ثُلُثٌ، وَمِنْ أَرْبَعَةٍ رُبْعٌ.",
  "pn.02": "وَإِذَا اجْتَمَعَتِ الأَجْزَاءُ كُلُّهَا صَارَتِ الكَعْكَةَ كُلَّهَا: الوَاحِدَ الصَّحِيحَ.",
  "mat.01": "{اِطْوِ|اِطْوِي} شَرِيطَ وَرَقٍ وَدَائِرَةً وَرَقِيَّةً أَجْزَاءً مُتَسَاوِيَةً، {وَطَابِقِ|وَطَابِقِي} الأَجْزَاءَ {لِتَتَأَكَّدَ|لِتَتَأَكَّدِي} أَنَّهَا مُتَسَاوِيَةٌ، {وَقُلِ|وَقُولِي} اسْمَ كُلِّ جُزْءٍ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: قَاطِعُ الكَعْكَةِ! الحَكَمُ يَفْحَصُ: هَلِ القِطَعُ مُتَسَاوِيَةٌ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الأَجْزَاءِ المُتَسَاوِيَةِ.",
  "pr.equal": "أَيُّ الأَشْكَالِ مَقْسُومٌ أَجْزَاءً مُتَسَاوِيَةً؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.fair": "هَلِ القِطَعُ مُتَسَاوِيَةٌ؟",
  "pr.name": "الأَجْزَاءُ مُتَسَاوِيَةٌ. مَا اسْمُ الجُزْءِ المُلَوَّنِ؟",
  "ch.find": "قَطَعَتْ فَوْضَى الكَعْكَةَ ثَلَاثَ قِطَعٍ وَقَالَتْ: كُلُّ قِطْعَةٍ ثُلُثٌ! هَلِ القِطَعُ مُتَسَاوِيَةٌ؟",
  "ch.after": [
   "chaos",
   "آه! الثُّلُثُ جُزْءٌ مِنْ ثَلَاثَةِ أَجْزَاءٍ مُتَسَاوِيَةٍ، لَا أَيُّ قِطْعَةٍ."
  ],
  "ch.right": "نُطَابِقُ القِطَعَ: إِنْ لَمْ تَنْطَبِقْ فَلَيْسَتْ أَثْلَاثًا.",
  "ch.wrong": [
   "chaos",
   "كُلُّ قِطْعَةٍ مِنْ ثَلَاثٍ ثُلُثٌ."
  ],
  "ms.1": "لِمَاذَا لَا نُسَمِّي كُلَّ قِطْعَةٍ مِنْ أَرْبَعٍ رُبْعًا؟",
  "ms.1a": "لِأَنَّ الرُّبْعَ جُزْءٌ مِنْ أَرْبَعَةٍ مُتَسَاوِيَةٍ.",
  "ms.1b": "لِأَنَّ الرُّبْعَ أَكْبَرُ قِطْعَةٍ فِي الكَعْكَةِ.",
  "ms.1c": "لِأَنَّ الكَعْكَةَ يَجِبُ أَنْ تَكُونَ دَائِرَةً.",
  "ms.recall": "الكَسْرُ أَجْزَاءٌ مُتَسَاوِيَةٌ: نِصْفٌ مِنِ اثْنَيْنِ، وَثُلُثٌ مِنْ ثَلَاثَةٍ، وَرُبْعٌ مِنْ أَرْبَعَةٍ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} الأَجْزَاءَ المُتَسَاوِيَةَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "دَخَلْنَا حَيَّ المَخْبَزِ: كُلُّ كَعْكَةٍ تُقْطَعُ بِعَدْلٍ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِطْوِ|اِطْوِي} مِنْدِيلًا أَوْ وَرَقَةً أَرْبَعَةَ أَجْزَاءٍ مُتَسَاوِيَةٍ، {وَلَوِّنْ|وَلَوِّنِي} رُبْعًا وَاحِدًا."
  ]
 },
