  "ask": "bag.ask",
  "adult": "شرائط ورق وأقلام تلوين.",
  "screenPath": "أسئلة الوحدة على الشاشة: الأجزاء المتساوية، وقراءة الكسر وتلوينه، والنصف بأشكال، والكسر على القطعة، والتكافؤ، والمقارنة والترتيب، والكسر من مجموعة، واكتشاف الخطأ، والتعليل؛ والأشرطة الحقيقية في مسار «معي»."
 },
 "labels": {
  "bagStrips": "شَرِيطُ وَرَقٍ",
  "bagPens": "أَقْلَامُ تَلْوِينٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ وَرَقٍ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فِي مَخْبَزِ فَوْضَى كَعْكٌ بِأَخْطَاءٍ: قِطَعٌ غَيْرُ مُتَسَاوِيَةٍ، وَكَسْرٌ مَقْلُوبٌ، وَمُقَارَنَةٌ بِالمَقَامِ.",
  "hook.02": "مَنْ يُصَحِّحُ المَخْبَزَ يَأْخُذُ شَارَةَ الخَبَّازِ وَالحَجَرَ الثَّامِنَ.",
  "mat.01": "{لَوِّنْ|لَوِّنِي} بِأَقْلَامِ التَّلْوِينِ عَلَى شَرِيطِ وَرَقٍ وَأَشْرِطَةٍ مِثْلِهِ كُسُورًا {تَخْتَارُهَا|تَخْتَارِينَهَا}، {وَقَارِنْهَا|وَقَارِنِيهَا}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "{تَذَكَّرْ|تَذَكَّرِي}: الكَسْرُ أَجْزَاءٌ مُتَسَاوِيَةٌ؛ المَقَامُ تَحْتَ: الأَجْزَاءُ كُلُّهَا، وَالبَسْطُ فَوْقَ: مَا أَخَذْنَا.",
  "rv.02": "وَالكُسُورُ المُتَكَافِئَةُ مِقْدَارٌ وَاحِدٌ، وَنُقَارِنُ عَلَى أَشْرِطَةٍ مُتَطَابِقَةٍ.",
  "gm.intro": "لُعْبَةُ: مَخْبَزُ فَوْضَى! {صَحِّحْ|صَحِّحِي} كَعْكَهَا.",
  "gm.read": "كَتَبَتْ فَوْضَى الكَسْرَ مَقْلُوبًا. مَا الكَسْرُ المُلَوَّنُ حَقًّا؟",
  "gm.cmp": "قَارَنَتْ فَوْضَى بِالمَقَامِ وَحْدَهُ. أَيُّ الكَسْرَيْنِ أَكْبَرُ حَقًّا؟",
  "gm.fair": "قَالَتْ فَوْضَى إِنَّ هَذِهِ أَرْبَاعٌ. هَلِ القِطَعُ مُتَسَاوِيَةٌ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ الاخْتِبَارِ.",
  "q.equal": "أَيُّ الأَشْكَالِ مَقْسُومٌ أَجْزَاءً مُتَسَاوِيَةً؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "q.fair": "هَلِ القِطَعُ مُتَسَاوِيَةٌ؟",
  "q.read": "مَا الكَسْرُ المُلَوَّنُ؟",
  "q.color": "{لَوِّنْ|لَوِّنِي}:",
  "q.cells": "{لَوِّنْ|لَوِّنِي} مُرَبَّعَاتٍ بِأَيِّ شَكْلٍ {تُرِيدُ|تُرِيدِينَ}:",
  "q.half": "هَلِ الجُزْآنِ نِصْفَانِ؟",
  "q.lineR": "إِلَى أَيِّ كَسْرٍ يُشِيرُ السَّهْمُ؟",
  "q.eqvF": "كَمْ جُزْءًا نُلَوِّنُ فِي الشَّرِيطِ الثَّانِي لِيَكُونَ المِقْدَارُ نَفْسَهُ؟ الأَوَّلُ:",
  "q.eqvP": "أَيُّ هَذِهِ الكُسُورِ يُسَاوِي:",
  "q.cmp": "أَيُّ الكَسْرَيْنِ أَكْبَرُ؟",
  "q.order": "{اِلْمِسِ|اِلْمِسِي} الكُسُورَ مِنَ الأَصْغَرِ إِلَى الأَكْبَرِ.",
  "q.set": "كَمْ قِطْعَةً فِي هَذَا الكَسْرِ مِنَ المَجْمُوعَةِ:",
  "ts.13": "كَتَبَ طَالِبٌ: ثُمْنٌ أَكْبَرُ مِنْ رُبْعٍ. مَا خَطَؤُهُ؟",
  "ts.13a": "ظَنَّ أَنَّ المَقَامَ الأَكْبَرَ جُزْءٌ أَكْبَرُ.",
  "ts.13b": "قَلَبَ البَسْطَ وَالمَقَامَ فِي الكَسْرِ.",
  "ts.13c": "نَسِيَ أَنْ يَكْتُبَ الوَحْدَةَ المُرَبَّعَةَ.",
  "ts.14": "هَلْ نِصْفُ الكَعْكَةِ الصَّغِيرَةِ يُسَاوِي نِصْفَ الكَبِيرَةِ؟",
  "ts.14a": "لَا: النِّصْفُ مِنْ كُلٍّ أَكْبَرَ أَكْبَرُ.",
  "ts.14b": "نَعَمْ: النِّصْفُ نِصْفٌ دَائِمًا.",
  "ts.14c": "نَعَمْ، إِذَا قَسَمْنَاهُمَا بِالسِّكِّينِ نَفْسِهِ.",
  "ts.rem": "نَطْوِي مَعَ الكِبَارِ شَرَائِطَ وَنُقَسِّمُ خُبْزًا؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": "هَذَا الحَجَرُ الثَّامِنُ لِلْوَاحَةِ!",
  "ts.win1": "{أَنْتَ خَبَّازُ|أَنْتِ خَبَّازَةُ} الكُسُورِ!",
  "ts.win2": "{عَرَفْتَ|عَرَفْتِ} الكُسُورَ: تَقْرَؤُهَا، وَتُمَثِّلُهَا، وَتُقَارِنُهَا.",
  "wrap.01": "وَحَصَلْنَا عَلَى شَارَةِ المَخْبَزِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {أَرْشِدْ|أَرْشِدِي} {أَهْلَكَ|أَهْلَكِ} لِيَقْطَعُوا شَرِيحَةَ خُبْزٍ أَرْبَاعًا بِطَرِيقَةٍ، وَأُخْرَى أَرْبَاعًا بِطَرِيقَةٍ مُخْتَلِفَةٍ، ثُمَّ {وَزِّعِ|وَزِّعِي} اثْنَتَيْ عَشْرَةَ تَمْرَةً: نِصْفُهَا {لِأُمِّكَ|لِأُمِّكِ} وَرُبْعُهَا {لِأَخِيكَ|لِأَخِيكِ}."
  ]
 },
