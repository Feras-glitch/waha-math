 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ وَرَقٍ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "cs.01": "ثَلَاثَةُ أَثْمَانٍ وَخَمْسَةُ أَثْمَانٍ عَلَى شَرِيطَيْنِ مُتَطَابِقَيْنِ: المَقَامُ نَفْسُهُ، فَالأَكْبَرُ بَسْطًا أَكْبَرُ.",
  "cs.02": "ثُلُثٌ وَخُمْسٌ: البَسْطُ نَفْسُهُ. كُلَّمَا زَادَ المَقَامُ صَغُرَ الجُزْءُ، فَالثُّلُثُ أَكْبَرُ.",
  "cs.03": "وَالنِّصْفُ مَرْجِعٌ: ثَلَاثَةُ أَثْمَانٍ أَقَلُّ مِنَ النِّصْفِ، وَخَمْسَةُ أَثْمَانٍ أَكْثَرُ.",
  "mat.01": "{اِطْوِ|اِطْوِي} شَرِيطَ وَرَقٍ وَشَرِيطًا مِثْلَهُ طَيَّاتٍ مُخْتَلِفَةً، {وَلَوِّنْ|وَلَوِّنِي} بِأَقْلَامِ التَّلْوِينِ جُزْءًا مِنْ كُلٍّ مِنْهُمَا، {وَقَارِنْ|وَقَارِنِي}: أَيُّهُمَا أَطْوَلُ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: مَنْ يَأْخُذُ أَكْثَرَ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى مُقَارَنَةِ الكُسُورِ.",
  "pr.cmp": "أَيُّ الكَسْرَيْنِ أَكْبَرُ؟",
  "pr.bench": "أَكْبَرُ مِنَ النِّصْفِ أَمْ أَصْغَرُ؟",
  "ch.find": "قَالَتْ فَوْضَى: ثُمْنٌ أَكْبَرُ مِنْ رُبْعٍ، لِأَنَّ ثَمَانِيَةً أَكْبَرُ مِنْ أَرْبَعَةٍ! أَيُّ الكَسْرَيْنِ أَكْبَرُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! كُلَّمَا كَثُرَتِ الأَجْزَاءُ صَغُرَ كُلُّ جُزْءٍ."
  ],
  "ch.right": "{ضَعِ|ضَعِي} الشَّرِيطَيْنِ مُتَجَاوِرَيْنِ: الثُّمْنُ أَقْصَرُ.",
  "ch.wrong": [
   "chaos",
   "المَقَامُ الأَكْبَرُ كَسْرٌ أَكْبَرُ."
  ],
  "ms.1": "لِمَاذَا الثُّلُثُ أَكْبَرُ مِنَ الخُمْسِ؟",
  "ms.1a": "لِأَنَّ الكُلَّ مَقْسُومٌ أَجْزَاءً أَقَلَّ فَكُلُّ جُزْءٍ أَكْبَرُ.",
  "ms.1b": "لِأَنَّ ثَلَاثَةً أَصْغَرُ مِنْ خَمْسَةٍ وَالأَصْغَرُ يَغْلِبُ دَائِمًا.",
  "ms.1c": "لِأَنَّ الثُّلُثَ يَأْتِي قَبْلَ الخُمْسِ فِي العَدِّ وَالتَّرْتِيبِ.",
  "ms.recall": "المَقَامُ نَفْسُهُ: الأَكْبَرُ بَسْطًا أَكْبَرُ. البَسْطُ نَفْسُهُ: الأَصْغَرُ مَقَامًا أَكْبَرُ. وَالنِّصْفُ مَرْجِعٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُقَارِنُ|صِرْتِ تُقَارِنِينَ} الكُسُورَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "عَرَفْنَا مَنْ أَخَذَ أَكْثَرَ مِنَ الكَعْكَةِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِسْأَلْ|اِسْأَلِي} {أَهْلَكَ|أَهْلَكِ}: رُبْعُ تُفَّاحَةٍ أَمْ ثُمْنُهَا: أَيُّهُمَا {تُفَضِّلُ إِنْ كُنْتَ جَائِعًا|تُفَضِّلِينَ إِنْ كُنْتِ جَائِعَةً}؟ {وَعَلِّلْ|وَعَلِّلِي}."
  ]
 },
