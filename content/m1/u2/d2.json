 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} لَفَّةُ مَنَادِيلَ، وَقُبَّعَةُ حَفْلَةٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "فَوْضَى أَنَامَتِ المَخْرُوطَ، وَسَتَدْفَعُهُ نَحْوَ بَابِ الوَاحَةِ. هَلْ يَسِيرُ فِي خَطٍّ مُسْتَقِيمٍ، أَمْ يَدُورُ؟ {تَوَقَّعْ|تَوَقَّعِي}.",
  "hook.02": "نَنْظُرُ إِلَيْهِ مِنْ فَوْقُ.",
  "hook.03": "دَارَ حَوْلَ رَأْسِهِ! رَأْسُهُ يَبْقَى فِي مَكَانِهِ، وَقَاعِدَتُهُ تَدُورُ حَوْلَهُ.",
  "hook.04": [
   "chaos",
   "إِذَنْ، مَنْ يَتَدَحْرَجُ فِي خَطٍّ مُسْتَقِيمٍ؟"
  ],
  "mat.01": "{أَنِمْ|أَنِيمِي} لَفَّةَ المَنَادِيلِ وَ{دَحْرِجْهَا|دَحْرِجِيهَا}، ثُمَّ {أَنِمِ|أَنِيمِي} القُبَّعَةَ وَ{دَحْرِجْهَا|دَحْرِجِيهَا}. مَاذَا {رَأَيْتَ|رَأَيْتِ}؟ ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "هَيَّا نَرَى ذَلِكَ عَلَى الشَّاشَةِ أَيْضًا.",
  "cyl.01": "هَذِهِ أُسْطُوَانَةٌ نَائِمَةٌ، نَنْظُرُ إِلَيْهَا مِنْ فَوْقُ. {اِلْمَسْهَا|اِلْمَسِيهَا} لِنُدَحْرِجَهَا.",
  "cyl.02": "تَدَحْرَجَتِ الأُسْطُوَانَةُ فِي خَطٍّ مُسْتَقِيمٍ.",
  "push.cyl": "وَإِذَا كَانَتِ الأُسْطُوَانَةُ وَاقِفَةً، هَلْ تَتَدَحْرَجُ إِذَا دَفَعْنَاهَا؟",
  "push.cyl.after": "بَقِيَتْ وَاقِفَةً عَلَى طَرَفِهَا الدَّائِرِيِّ المُسَطَّحِ.",
  "push.end": "وَإِذَا نَامَتْ عَلَى جَانِبِهَا؟",
  "push.end.after": "تَدَحْرَجَتْ عَلَى سَطْحِهَا المُنْحَنِي. الأُسْطُوَانَةُ تَقِفُ، وَتَتَدَحْرَجُ.",
  "cone.01": "وَقُبَّعَةُ الحَفْلَةِ مَخْرُوطٌ: قَاعِدَتُهُ دَائِرِيَّةٌ مُسَطَّحَةٌ، وَرَأْسُهُ مُدَبَّبٌ. وَلِسَطْحِهِ المُنْحَنِي يَتَدَحْرَجُ حَوْلَ رَأْسِهِ.",
  "face.cube": "السَّطْحُ المُسَطَّحُ مِنَ المُجَسَّمِ اسْمُهُ: وَجْهٌ، نَلْمَسُهُ بِكَفِّنَا. {اِلْمَسِ|اِلْمَسِي} وُجُوهَ المُكَعَّبِ.",
  "face.cube.after": "كُلُّ وُجُوهِ المُكَعَّبِ مُسَطَّحَةٌ.",
  "face.cyl": "{اِلْمَسِ|اِلْمَسِي} وَجْهَ الأُسْطُوَانَةِ المُسَطَّحَ.",
  "face.cyl.flip": "نَقْلِبُهَا… وَهُنَاكَ وَجْهٌ آخَرُ. {اِلْمَسْهُ|اِلْمَسِيهِ}.",
  "face.cyl.after": "لِلْأُسْطُوَانَةِ وَجْهَانِ دَائِرِيَّانِ مُسَطَّحَانِ، وَبَيْنَهُمَا سَطْحٌ مُنْحَنٍ.",
  "face.cone": "وَالمَخْرُوطُ؟ قَلَبْنَاهُ لِنَرَى قَاعِدَتَهُ. {اِلْمَسِ|اِلْمَسِي} وَجْهَهُ المُسَطَّحَ.",
  "face.cone.after": "لِلْمَخْرُوطِ وَجْهٌ دَائِرِيٌّ وَاحِدٌ، وَرَأْسٌ مُدَبَّبٌ.",
  "face.sphere": "وَالكُرَةُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "face.sphere.after": "سَطْحُ الكُرَةِ مُنْحَنٍ كُلُّهُ: لَيْسَ لَهَا وَجْهٌ مُسَطَّحٌ.",
  "wk.01": "هَذِهِ طَبْلَةٌ: وَجْهَانِ دَائِرِيَّانِ مُسَطَّحَانِ، وَسَطْحٌ مُنْحَنٍ. إِنَّهَا أُسْطُوَانَةٌ.",
  "wk.02": "هَلْ مَا زَالَتْ أُسْطُوَانَةً؟",
  "wk.03": "مَا زَالَ لَهَا الوَجْهَانِ الدَّائِرِيَّانِ: أُسْطُوَانَةٌ نَائِمَةٌ.",
  "wk.04": "قُبَّعَةُ الحَفْلَةِ وَقِمْعُ البُوظَةِ مَخْرُوطَانِ: رَأْسٌ مُدَبَّبٌ وَقَاعِدَةٌ دَائِرِيَّةٌ، حَتَّى لَوْ كَانَ الرَّأْسُ إِلَى الأَسْفَلِ.",
  "pr.intro": "سِلَالُنَا: لِلْأُسْطُوَانَاتِ، وَلِلْمَخَارِيطِ، وَ«غَيْرُ ذَلِكَ». هَيَّا نَتَمَرَّنُ.",
  "pr.who": "مَنْ أَنَا؟ أَقِفُ وَأَتَدَحْرَجُ، وَلِي وَجْهَانِ دَائِرِيَّانِ.",
  "pr.coneRoll": "هَلْ يَتَدَحْرَجُ المَخْرُوطُ فِي خَطٍّ مُسْتَقِيمٍ؟",
  "pr.coneWhy": "يَدُورُ حَوْلَ رَأْسِهِ، لِأَنَّ رَأْسَهُ يَبْقَى فِي مَكَانِهِ.",
  "game.01": "مَتْجَرُ المُجَسَّمَاتِ: {اِسْمَعْ|اِسْمَعِي} طَلَبَ كُلِّ زَبُونٍ، وَ{أَعْطِهِ|أَعْطِيهِ} مَا يَطْلُبُ.",
  "shop.r1": "زَبُونٌ يَطْلُبُ شَيْئًا يَقِفُ، وَيَتَدَحْرَجُ فِي خَطٍّ مُسْتَقِيمٍ.",
  "shop.r2": "زَبُونَةٌ تَطْلُبُ شَيْئًا رَأْسُهُ مُدَبَّبٌ، وَقَاعِدَتُهُ دَائِرِيَّةٌ.",
  "shop.r3": "زَبُونٌ يَطْلُبُ شَيْئًا يَتَدَحْرَجُ فِي كُلِّ اتِّجَاهٍ، وَلَيْسَ لَهُ وَجْهٌ مُسَطَّحٌ.",
  "shop.r4": "زَبُونَةٌ تَطْلُبُ شَيْئًا لَهُ وَجْهَانِ دَائِرِيَّانِ مُسَطَّحَانِ.",
  "shop.r5": "زَبُونٌ يَطْلُبُ شَيْئًا يَدُورُ حَوْلَ رَأْسِهِ إِذَا دَحْرَجْنَاهُ.",
  "shop.r6": "زَبُونَةٌ تَطْلُبُ شَيْئًا تُوقِفُهُ فَيَقِفُ، وَإِذَا أَنَامَتْهُ تَدَحْرَجَ فِي خَطٍّ مُسْتَقِيمٍ.",
  "why.cyl": "وَجْهَانِ دَائِرِيَّانِ، وَسَطْحٌ مُنْحَنٍ بَيْنَهُمَا.",
  "why.cylLying": "نَائِمَةٌ فَقَطْ: مَا زَالَ لَهَا وَجْهَانِ دَائِرِيَّانِ.",
  "why.cone": "رَأْسٌ مُدَبَّبٌ، وَقَاعِدَةٌ دَائِرِيَّةٌ، مَهْمَا قَلَبْنَاهُ.",
  "why.other": "لَيْسَ لَهُ وَجْهٌ دَائِرِيٌّ وَرَأْسٌ مُدَبَّبٌ، وَلَا وَجْهَانِ دَائِرِيَّانِ.",
  "ch.after": "لَهَا وَجْهَانِ دَائِرِيَّانِ: إِنَّهَا أُسْطُوَانَةٌ نَائِمَةٌ. مَكَانُهَا سَلَّةُ الأُسْطُوَانَاتِ.",
  "ch.right": "الأُسْطُوَانَةُ النَّائِمَةُ مَا زَالَتْ أُسْطُوَانَةً: لَهَا وَجْهَانِ دَائِرِيَّانِ.",
