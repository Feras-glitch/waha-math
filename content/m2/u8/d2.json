 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} دَائِرَةٌ وَرَقِيَّةٌ وَأَقْلَامُ تَلْوِينٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "rf.01": "كَعْكَةٌ مَقْسُومَةٌ ثَمَانِيَةَ أَجْزَاءٍ مُتَسَاوِيَةٍ، أَكَلْنَا مِنْهَا ثَلَاثَةً.",
  "rf.02": "نَكْتُبُ: ثَلَاثَةٌ فَوْقَ الخَطِّ، وَثَمَانِيَةٌ تَحْتَهُ. نَقْرَؤُهُ: ثَلَاثَةُ أَثْمَانٍ.",
  "rf.03": "المَقَامُ تَحْتَ: كَمْ جُزْءًا مُتَسَاوِيًا فِي الكُلِّ. وَالبَسْطُ فَوْقَ: كَمْ جُزْءًا أَخَذْنَا.",
  "uw.01": "الكَسْرُ الَّذِي بَسْطُهُ وَاحِدٌ كَسْرٌ وَحْدَوِيٌّ: جُزْءٌ وَاحِدٌ مِنَ الكُلِّ.",
  "uw.02": "وَإِذَا لَوَّنَّا الأَجْزَاءَ كُلَّهَا، أَرْبَعَةً مِنْ أَرْبَعَةٍ، فَهَذَا الوَاحِدُ الصَّحِيحُ.",
  "mat.01": "{لَوِّنْ|لَوِّنِي} بِأَقْلَامِ التَّلْوِينِ أَجْزَاءً مِنْ دَائِرَةٍ وَرَقِيَّةٍ مَقْسُومَةٍ، {وَاكْتُبِ|وَاكْتُبِي} الكَسْرَ: البَسْطَ فَوْقَ وَالمَقَامَ تَحْتَ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: بَائِعُ الكَعْكِ! الزَّبُونُ يَطْلُبُ، {وَأَنْتَ تُلَوِّنُ|وَأَنْتِ تُلَوِّنِينَ} مَا طَلَبَ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى قِرَاءَةِ الكَسْرِ وَكِتَابَتِهِ.",
  "pr.read": "مَا الكَسْرُ المُلَوَّنُ؟",
  "pr.color": "{لَوِّنْ|لَوِّنِي}:",
  "pr.nameF": "أَيُّ هَذِهِ الكُسُورِ:",
  "pr.unit": "أَيُّ هَذِهِ الكُسُورِ كَسْرٌ وَحْدَوِيٌّ، بَسْطُهُ وَاحِدٌ؟",
  "pr.whole": "أَيُّ هَذِهِ الكُسُورِ يُسَاوِي الوَاحِدَ الصَّحِيحَ؟",
  "pr.notUnit": "أَيُّ هَذِهِ الكُسُورِ لَيْسَ وَحْدَوِيًّا، وَلَا وَاحِدًا صَحِيحًا؟",
  "ch.find": "عَدَّتْ فَوْضَى الأَجْزَاءَ المُلَوَّنَةَ وَغَيْرَ المُلَوَّنَةِ، وَكَتَبَتْ كَسْرًا غَرِيبًا! مَا الكَسْرُ المُلَوَّنُ حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! المَقَامُ عَدَدُ الأَجْزَاءِ كُلِّهَا، لَا غَيْرِ المُلَوَّنَةِ وَحْدَهَا."
  ],
  "ch.right": "المَقَامُ تَحْتَ: الأَجْزَاءُ كُلُّهَا. وَالبَسْطُ فَوْقَ: المُلَوَّنَةُ.",
  "ch.wrong": [
   "chaos",
   "المَقَامُ هُوَ الأَجْزَاءُ غَيْرُ المُلَوَّنَةِ."
  ],
  "ms.2": "لِمَاذَا أَرْبَعَةُ أَرْبَاعٍ تُسَاوِي الوَاحِدَ الصَّحِيحَ؟",
  "ms.2a": "لِأَنَّهَا الأَجْزَاءُ كُلُّهَا، فَهِيَ الكُلُّ.",
  "ms.2b": "لِأَنَّ البَسْطَ أَكْبَرُ مِنَ المَقَامِ.",
  "ms.2c": "لِأَنَّ كُلَّ كَسْرٍ يُسَاوِي وَاحِدًا.",
  "ms.recall": "البَسْطُ فَوْقَ: مَا أَخَذْنَا. وَالمَقَامُ تَحْتَ: الأَجْزَاءُ المُتَسَاوِيَةُ كُلُّهَا.",
  "ms.recall2": "الكَسْرُ الوَحْدَوِيُّ بَسْطُهُ وَاحِدٌ، وَالكَسْرُ الَّذِي بَسْطُهُ يُسَاوِي مَقَامَهُ وَاحِدٌ صَحِيحٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَقْرَأُ|صِرْتِ تَقْرَئِينَ} الكُسُورَ {وَتَكْتُبُهَا|وَتَكْتُبِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "بِعْنَا الكَعْكَ بِالكُسُورِ: لِكُلِّ زَبُونٍ مَا طَلَبَ!",
