 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} دُمْيَةٌ، وَصُنْدُوقٌ بِغِطَاءٍ، وَكُرَةٌ صَغِيرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.00": "نَلْعَبُ «فِرْجَار يَقُولُ»: {نَفِّذِ|نَفِّذِي} الأَمْرَ إِذَا بَدَأَ بِـ«فِرْجَار يَقُولُ»، وَإِلَّا فَ{الْمَسْ|الْمَسِي} «أَبْقَى مَكَانِي».",
  "hook.01": "فِرْجَار يَقُولُ: {ضَعِ|ضَعِي} الدُّمْيَةَ فَوْقَ الصُّنْدُوقِ.",
  "hook.02": "فِرْجَار يَقُولُ: {ضَعِ|ضَعِي} الدُّمْيَةَ تَحْتَ الصُّنْدُوقِ.",
  "hook.03": "فِرْجَار يَقُولُ: {ضَعِ|ضَعِي} الدُّمْيَةَ دَاخِلَ الصُّنْدُوقِ.",
  "hook.04": "{ضَعِ|ضَعِي} الدُّمْيَةَ بِجَانِبِ الصُّنْدُوقِ.",
  "hook.stayed": "قُلْتُ «فِرْجَار يَقُولُ»، فَنُنَفِّذُ الأَمْرَ.",
  "hook.moved": "لَمْ أَقُلْ «فِرْجَار يَقُولُ»، فَنَبْقَى مَكَانَنَا!",
  "hook.wrong": "هَذَا مَكَانٌ آخَرُ. {اُنْظُرْ|اُنْظُرِي}: هُنَا قَالَ فِرْجَار.",
  "hook.after": "لَعِبٌ جَمِيلٌ! كَلِمَاتٌ مِثْلُ «فَوْقَ» وَ«تَحْتَ» وَ«دَاخِلَ» تُخْبِرُنَا أَيْنَ الأَشْيَاءُ.",
  "mat.01": "{ضَعِ|ضَعِي} الكُرَةَ دَاخِلَ الصُّنْدُوقِ، وَ{أَغْلِقِ|أَغْلِقِي} الغِطَاءَ. ثُمَّ {ضَعِ|ضَعِي} الدُّمْيَةَ فَوْقَهُ. ثُمَّ {اِلْمَسْ|اِلْمَسِي} «تَمَّ».",
  "mat.02": "نَرَى ذَلِكَ عَلَى الشَّاشَةِ أَيْضًا.",
  "lid.01": "الكُرَةُ دَاخِلَ الصُّنْدُوقِ. {اِلْمَسِ|اِلْمَسِي} الصُّنْدُوقَ لِنُغْلِقَ الغِطَاءَ.",
  "lid.02": "انْغَلَقَ الغِطَاءُ عَلَى الكُرَةِ: هِيَ دَاخِلَ الصُّنْدُوقِ.",
  "lid.03": "وَالآنَ الكُرَةُ فَوْقَ الصُّنْدُوقِ. {اِلْمَسِ|اِلْمَسِي} الصُّنْدُوقَ مَرَّةً أُخْرَى.",
  "lid.04": "لَا يَنْغَلِقُ الغِطَاءُ عَلَيْهَا: الغِطَاءُ تَحْتَهَا، فَهِيَ فَوْقَ الصُّنْدُوقِ.",
  "lid.05": "وَهَذِهِ القِطَّةُ؟ {اِلْمَسْهَا|اِلْمَسِيهَا}.",
  "lid.06": "القِطَّةُ بِجَانِبِ الصُّنْدُوقِ: عَلَى الأَرْضِ نَفْسِهَا، لَا فَوْقَهُ وَلَا تَحْتَهُ.",
  "ex.01": "غُرْفَةُ الأَلْعَابِ! {ضَعِ|ضَعِي} كُلَّ شَيْءٍ حَيْثُ {تَظُنُّ|تَظُنِّينَ}، وَنَتَحَقَّقُ مَعًا.",
  "ex.under": "{ضَعِ|ضَعِي} الدُّبَّ تَحْتَ الطَّاوِلَةِ.",
