{
 "id": "m2.u3.d1",
 "title": "مَا الزَّاوِيَةُ؟ وَكَيْفَ نُسَمِّيهَا؟",
 "icon": [
  "angx"
 ],
 "concepts": {
  "C130": "الزاوية: رأس وضلعان وانفتاح",
