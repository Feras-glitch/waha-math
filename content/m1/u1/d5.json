 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} ثَلَاثُ عُلَبٍ، وَقُصَاصَاتُ وَرَقٍ، وَصِينِيَّةُ رَمْلٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "هِيهِي! بَعْثَرْتُ البِطَاقَاتِ!"
  ],
  "hook.02": "كَيْفَ يَعْرِفُ سَاعِي البَرِيدِ كَمْ رِسَالَةً فِي كُلِّ صُنْدُوقٍ، دُونَ أَنْ يَفْتَحَهُ؟",
  "e.c3": "{عُدَّ|عُدِّي} رَسَائِلَ هَذَا الصُّنْدُوقِ: {اِلْمِسْ|اِلْمِسِي} كُلَّ رِسَالَةٍ.",
  "e.ask": "أَيُّ بِطَاقَةٍ لَهُ؟ عَلَى كُلِّ بِطَاقَةٍ رَقْمٌ وَاحِدٌ. {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "e.a3": "هَذَا الرَّقْمُ نَقْرَؤُهُ: ثَلَاثَة.",
  "e.c5": "وَهَذَا الصُّنْدُوقُ: {عُدَّ|عُدِّي} رَسَائِلَهُ.",
  "e.a5": "خَمْسَة. لِكُلِّ عَدَدٍ رَقْمٌ نَكْتُبُهُ.",
  "e.c0": "وَهَذَا الصُّنْدُوقُ؟ {اُنْظُرْ|اُنْظُرِي} دَاخِلَهُ.",
  "e.ask0": "كَمْ رِسَالَةً فِيهِ؟ أَيُّ بِطَاقَةٍ لَهُ؟",
  "e.a0": "لَا شَيْءَ فِيهِ: صِفْرٌ. وَالصِّفْرُ عَدَدٌ لَهُ بِطَاقَةٌ، مِثْلُ غَيْرِهِ.",
  "cards.01": "هَذِهِ بِطَاقَاتُ الأَرْقَامِ، مِنْ صِفْرٍ إِلَى عَشَرَةٍ. نَقْرَؤُهَا مَعًا.",
  "cards.02": "{اِلْمِسْ|اِلْمِسِي} أَيَّ بِطَاقَةٍ {لِتَسْمَعَ|لِتَسْمَعِي} اسْمَهَا.",
  "mat.01": "{اُكْتُبْ|اُكْتُبِي} {بِإِصْبَعِكَ|بِإِصْبَعِكِ} فِي صِينِيَّةِ الرَّمْلِ رَقْمَ أَرْبَعَةٍ، ثُمَّ رَقْمَ سَبْعَة. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ نَكْتُبُ عَلَى الشَّاشَةِ.",
  "mat.03": "{ضَعْ|ضَعِي} فِي العُلَبِ رَسَائِلَ مِنْ قُصَاصَاتِ الوَرَقِ: فِي عُلْبَةٍ سَبْعًا، وَ{اتْرُكِ|اتْرُكِي} البَاقِيَةَ فَارِغَةً. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.04": "كَمْ رِسَالَةً فِي كُلِّ صُنْدُوقٍ؟ نَعُدُّ عَلَى الشَّاشَةِ.",
  "tr.01": "نَكْتُبُ الرَّقْمَ: نَبْدَأُ مِنَ النُّقْطَةِ الخَضْرَاءِ، وَنَتْبَعُ الخَطَّ.",
  "tr.02": "{أَحْسَنْتَ|أَحْسَنْتِ}! هَكَذَا نَكْتُبُ كُلَّ رَقْمٍ.",
  "wk.01": "صُنْدُوقَانِ مُتَشَابِهَانِ. نَعُدُّ رَسَائِلَ كُلٍّ مِنْهُمَا، وَنُعَلِّقُ بِطَاقَتَهُ.",
  "wk.02": "وَالرَّقْمَانِ مُتَشَابِهَانِ أَيْضًا. {اُنْظُرْ|اُنْظُرِي} إِلَى أَعْلَاهُمَا: فِي هَذَا سِنٌّ وَاحِدَةٌ، وَفِي ذَاكَ سِنَّانِ.",
  "wk.03": "وَهَذَانِ الرَّقْمَانِ: أَحَدُهُمَا مَقْلُوبُ الآخَرِ. فَعَدُّ الرَّسَائِلِ هُوَ الَّذِي يَحْكُمُ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الأَرْقَامِ.",
  "g.intro": "لُعْبَةُ سَاعِي البَرِيدِ: عَلَى كُلِّ صُنْدُوقٍ بِطَاقَةٌ، {فَضَعْ|فَضَعِي} فِيهِ مَا تَقُولُهُ.",
  "ch.find": "فَوْضَى عَلَّقَتْ بِطَاقَةً عَلَى هَذَا الصُّنْدُوقِ. هَلْ هِيَ بِطَاقَتُهُ؟ {عُدَّ|عُدِّي} الرَّسَائِلَ: {اِلْمِسْ|اِلْمِسِي} كُلَّ رِسَالَةٍ.",
  "ch.after": "عَلَّقْنَا بِطَاقَتَهُ الصَّحِيحَةَ.",
  "ch.right": "نَعُدُّ الرَّسَائِلَ، لِنَعْرِفَ البِطَاقَةَ.",
  "ch.wrong": [
   "chaos",
   "سَبْعَةٌ وَثَمَانِيَةٌ مُتَشَابِهَانِ، فَلَا فَرْقَ."
  ],
  "ms.recall": "لِكُلِّ عَدَدٍ رَقْمٌ: نَعُدُّ الرَّسَائِلَ، ثُمَّ نَبْحَثُ عَنْ رَقْمِهَا. وَالصُّنْدُوقُ الفَارِغُ رَقْمُهُ صِفْرٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَقْرَأُ|صِرْتِ تَقْرَئِينَ} أَرْقَامَ الوَاحَةِ {وَتَكْتُبُهَا|وَتَكْتُبِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "صَارَ لِصَنَادِيقِ البَرِيدِ فِي الوَاحَةِ بِطَاقَاتٌ بِأَرْقَامِهَا!",
  "wrap.02": "وَمِنَ اليَوْمِ {تَسْتَطِيعُ|تَسْتَطِيعِينَ} أَنْ {تَخْتَارَ|تَخْتَارِي} كِتَابَةَ الأَرْقَامِ مِنْ زِرِّ «أَرْقَامِي» فِي الخَرِيطَةِ.",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُكْتُبْ|اُكْتُبِي} مَعَ الكِبَارِ أَرْقَامَ الوَاحَةِ فِي الرَّمْلِ أَوِ المِلْحِ، مِنْ صِفْرٍ إِلَى خَمْسَةٍ."
  ]
 },
