{
 "id": "m2.u2.d1",
 "title": "المُسْتَقِيمَانِ المُتَقَاطِعَانِ",
 "icon": [
  "crsx"
 ],
 "concepts": {
  "C120": "المستقيمان المتقاطعان ونقطة التقاطع (نقطة واحدة فقط، ويُمدّان للتحقق)"
 },
 "bag": {
  "items": [
   {
    "icon": "sticks",
    "label": "bagSticks"
   }
  ],
  "ask": "bag.ask",
  "adult": "عودان (أعواد مثلّجات أو قلمان).",
  "screenPath": "على الشاشة يلمس الطفل نقطة التقاء شارعين، ويدير عوداً فوق عود، ويمدّ خطّين ليعرف هل يلتقيان؛ والعودان الحقيقيان في مسار «معي»."
 },
 "labels": {
  "bagSticks": "عُودَانِ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} عُودَانِ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "home.back": "فِي البَيْتِ كَانَ الخَيْطُ المَشْدُودُ قِطْعَةً لَهَا طَرَفَانِ. فَمَاذَا لَوْ مَرَّ فَوْقَهُ خَيْطٌ ثَانٍ؟ أَيْنَ يَلْتَقِيَانِ، وَكَمْ مَرَّةً؟",
  "hook.01": "هَذَانِ شَارِعَانِ فِي المَدِينَةِ. {اِلْمِسِ|اِلْمِسِي} المَكَانَ الَّذِي يَلْتَقِيَانِ فِيهِ.",
  "hook.02": "اِلْتَقَى الشَّارِعَانِ فِي نُقْطَةٍ وَاحِدَةٍ. نَقُولُ: مُسْتَقِيمَانِ مُتَقَاطِعَانِ، وَهَذِهِ نُقْطَةُ التَّقَاطُعِ.",
  "mat.01": "{ضَعْ|ضَعِي} عُودًا فَوْقَ عُودٍ آخَرَ عَلَى الطَّاوِلَةِ بِأَوْضَاعٍ مُخْتَلِفَةٍ، وَ{اُنْظُرْ|اُنْظُرِي}: فِي كَمْ مَكَانٍ يَلْتَقِي العُودُ بِالعُودِ الآخَرِ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "st.01": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنُدِيرَ العُودَ الثَّانِيَ، وَ{اُنْظُرْ|اُنْظُرِي} إِلَى النُّقْطَةِ الحَمْرَاءِ.",
  "st.02": "فِي كُلِّ وَضْعٍ نُقْطَةٌ مُشْتَرَكَةٌ وَاحِدَةٌ. المُسْتَقِيمَانِ المُتَقَاطِعَانِ يَلْتَقِيَانِ فِي نُقْطَةٍ وَاحِدَةٍ فَقَطْ.",
  "ex.01": "هَذَانِ الخَطَّانِ لَا يَلْتَقِيَانِ فِي الرَّسْمِ. وَلَكِنَّ المُسْتَقِيمَ يَمْتَدُّ! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَمُدَّهُمَا.",
  "ex.02": "اِلْتَقَيَا بَعْدَ أَنْ مَدَدْنَاهُمَا: هُمَا مُتَقَاطِعَانِ. لَا نَحْكُمُ قَبْلَ أَنْ نَمُدَّ الخَطَّيْنِ.",
  "game.01": "لُعْبَةُ: مَيْدَانُ المُرُورِ!",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُسْتَقِيمَاتِ المُتَقَاطِعَةِ.",
  "pr.1": "أَيُّ نُقْطَةٍ هِيَ نُقْطَةُ التَّقَاطُعِ؟ {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "pr.2": "{اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَمُدَّ الخَطَّيْنِ. هَلْ يَلْتَقِيَانِ؟",
  "pr.3": "فِي أَيِّ رَسْمٍ مُسْتَقِيمَانِ مُتَقَاطِعَانِ؟",
  "ch.find": "تَقُولُ فَوْضَى: لَا يَلْتَقِيَانِ عَلَى الوَرَقَةِ، فَلَنْ يَلْتَقِيَا أَبَدًا! {اِلْمِسِ|اِلْمِسِي} الوَرَقَةَ لِنَمُدَّهُمَا. هَلْ يَلْتَقِيَانِ؟",
  "ch.after": [
   "chaos",
   "آه! أَمُدُّ الخَطَّيْنِ قَبْلَ أَنْ أَحْكُمَ."
  ],
  "ch.right": "نَمُدُّ الخَطَّيْنِ لِنَعْرِفَ هَلْ يَلْتَقِيَانِ.",
  "ch.wrong": [
   "chaos",
   "مَا لَا يَلْتَقِي عَلَى الوَرَقَةِ لَا يَلْتَقِي أَبَدًا."
  ],
  "ms.4": "فِي كَمْ نُقْطَةٍ يَلْتَقِي مُسْتَقِيمَانِ مُتَقَاطِعَانِ؟",
  "ms.4a": "فِي نُقْطَةٍ وَاحِدَةٍ فَقَطْ.",
  "ms.4b": "فِي نُقْطَتَيْنِ مُتَبَاعِدَتَيْنِ.",
  "ms.4c": "فِي نُقَطٍ كَثِيرَةٍ.",
  "ms.recall": "المُسْتَقِيمَانِ المُتَقَاطِعَانِ يَلْتَقِيَانِ فِي نُقْطَةٍ وَاحِدَةٍ، وَنَمُدُّهُمَا لِنَتَأَكَّدَ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَعْرِفُ|صِرْتِ تَعْرِفِينَ} المُسْتَقِيمَيْنِ المُتَقَاطِعَيْنِ وَنُقْطَةَ تَقَاطُعِهِمَا. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "اِلْتَقَى فِي حَيِّ التَّقَاطُعَاتِ شَارِعَانِ عِنْدَ نُقْطَةٍ وَاحِدَةٍ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِبْحَثْ|اِبْحَثِي} فِي البَيْتِ عَنْ خَطَّيْنِ مُتَقَاطِعَيْنِ، وَ{ضَعْ|ضَعِي} إِصْبَعًا عَلَى نُقْطَةِ التَّقَاطُعِ."
  ]
 },
