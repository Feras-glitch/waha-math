 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} مِنْقَلَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "قِسْتُ وَرَسَمْتُ الزَّوَايَا {مَعَكَ|مَعَكِ}! {أَجِبْ|أَجِيبِي} عَنْ أَسْئِلَةِ الوَاحَةِ، وَأَشُقُّ أَنَا القَنَاةَ الرَّابِعَةَ."
  ],
  "hook.02": "{لَا تَقْلَقْ|لَا تَقْلَقِي}! هَيَّا نَتَذَكَّرُ أَوَّلًا.",
  "mat.01": "{ضَعِ|ضَعِي} المِنْقَلَةَ عَلَى زَاوِيَةِ كِتَابٍ مَفْتُوحٍ، وَ{اِقْرَأْ|اِقْرَئِي} قِيَاسَهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "rv.01": "لِلزَّاوِيَةِ رَأْسٌ وَضِلْعَانِ، وَهِيَ دَوَرَانٌ يُقَاسُ بِالدَّرَجَاتِ، وَنُسَمِّيهَا وَالرَّأْسُ فِي الوَسَطِ.",
  "rv.02": "حَادَّةٌ، وَقَائِمَةٌ، وَمُنْفَرِجَةٌ، وَمُسْتَقِيمَةٌ، وَمُنْعَكِسَةٌ، وَكَامِلَةٌ.",
  "rv.03": "بِالمِنْقَلَةِ نَقِيسُ وَنَرْسُمُ، وَنَقْرَأُ مِنَ الصِّفْرِ الَّذِي عِنْدَ الضِّلْعِ، وَنُقَدِّرُ قَبْلَ أَنْ نَقِيسَ.",
  "gm.intro": "لُعْبَةُ: مُهَنْدِسُ الزَّوَايَا! تَصْنِيفٌ، ثُمَّ قِيَاسٌ، ثُمَّ رَسْمٌ.",
  "gm.pk": "فِي أَيِّ رَسْمٍ زَاوِيَةٌ مُنْفَرِجَةٌ؟",
  "gm.pr": "كَمْ دَرَجَةً قِيَاسُ هَذِهِ الزَّاوِيَةِ؟",
  "pr.intro": "هَيَّا نَتَمَرَّنُ قَبْلَ أَسْئِلَةِ الوَاحَةِ.",
  "q.kind": "مَا نَوْعُ هَذِهِ الزَّاوِيَةِ؟",
  "q.rkind": "مَا نَوْعُ الزَّاوِيَةِ الَّتِي قَوْسُهَا بَنَفْسَجِيٌّ؟",
  "q.prot": "كَمْ دَرَجَةً قِيَاسُ هَذِهِ الزَّاوِيَةِ؟",
  "q.rfx": "قِيَاسُ الزَّاوِيَةِ الصُّغْرَى مَكْتُوبٌ. كَمْ دَرَجَةً الزَّاوِيَةُ المُنْعَكِسَةُ؟",
  "q.est": "بِلَا أَدَاةٍ: أَيُّ تَقْدِيرٍ أَقْرَبُ إِلَى قِيَاسِ هَذِهِ الزَّاوِيَةِ؟",
  "q.name": "مَا اسْمُ هَذِهِ الزَّاوِيَةِ؟",
  "q.cmp": "{تَنْظُرُ|تَنْظُرِينَ} إِلَى الجَنُوبِ، وَ{اِلْتَفَتَّ|اِلْتَفَتِّ} رُبْعَ دَوْرَةٍ مَعَ عَقَارِبِ السَّاعَةِ. إِلَى أَيْنَ {تَنْظُرُ|تَنْظُرِينَ}؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ts.9": "هَذِهِ زَاوِيَةٌ حَادَّةٌ، وَقِيَاسُهَا المَكْتُوبُ خَطَأٌ. لِمَاذَا؟",
  "ts.9a": "قُرِئَ المِقْيَاسُ الآخَرُ مِنَ المِنْقَلَةِ.",
  "ts.9b": "لَا خَطَأَ: الحَادَّةُ أَكْبَرُ مِنْ تِسْعِينَ.",
  "ts.9c": "المِنْقَلَةُ لَا تَقِيسُ الزَّوَايَا الحَادَّةَ.",
  "ts.13": "عَقْرَبٌ لَمْ يَدُرْ، وَعَقْرَبٌ دَارَ دَوْرَةً وَعَادَ. مَا الفَرْقُ؟",
  "ts.13a": "الثَّانِي دَارَ دَوْرَةً كَامِلَةً.",
  "ts.13b": "لَا فَرْقَ بَيْنَهُمَا: الشَّكْلُ وَاحِدٌ.",
  "ts.13c": "العَقْرَبُ الثَّانِي أَطْوَلُ قَلِيلًا.",
  "ts.rem": "نَقِيسُ مَعَ الكِبَارِ زَوَايَا فِي البَيْتِ بِالمِنْقَلَةِ، وَنُسَمِّي أَنْوَاعَهَا؛ ثُمَّ نُرَاجِعُ هَذَا الدَّرْسَ.",
  "ts.stone": [
   "chaos",
   "{أَحْسَنْتَ|أَحْسَنْتِ}! سَأَشُقُّ القَنَاةَ الرَّابِعَةَ."
  ],
  "ts.win1": "{أَنْتَ سَيِّدُ الزَّوَايَا|أَنْتِ سَيِّدَةُ الزَّوَايَا}!",
  "ts.win2": "جَرَى المَاءُ فِي القَنَاةِ الرَّابِعَةِ مِنْ قَنَوَاتِ الأَدَوَاتِ!",
  "wrap.01": "صَارَتْ أَنْوَاعُ الزَّوَايَا السِّتَّةُ فِي دَفْتَرِ المُهَنْدِسِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِصْطَدْ|اِصْطَادِي} فِي البَيْتِ زَاوِيَتَيْنِ مِنْ كُلِّ نَوْعٍ: حَادَّةٍ وَقَائِمَةٍ وَمُنْفَرِجَةٍ، وَ{تَحَقَّقْ|تَحَقَّقِي} بِرُكْنِ الوَرَقَةِ. ثُمَّ {أَدِرْ|أَدِيرِي} عَقْرَبَيِ السَّاعَةِ {لِتَصْنَعَ|لِتَصْنَعِي} زَاوِيَةً قَائِمَةً، وَ{قُلِ|قُولِي} الوَقْتَ."
  ]
 },
