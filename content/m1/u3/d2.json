 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} ثَلَاثُ دُمًى، وَقِطَارُ أَلْعَابٍ أَوْ عُلَبٌ صَغِيرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "طَابُورُ الدِّبَبَةِ إِلَى الدُّكَّانِ. فَوْضَى وَقَفَتْ فِي أَوَّلِهِ، وَعَلَّقَتْ عَلَى نَفْسِهَا شَارَةَ «الأَخِيرِ»! مَنْ يَسْتَحِقُّهَا؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "hook.02": "الأَخِيرُ لَا أَحَدَ خَلْفَهُ. {اُنْظُرْ|اُنْظُرِي} مَرَّةً أُخْرَى.",
  "hook.03": "نَقَلْنَا الشَّارَةَ إِلَى الدُّبِّ الأَخِيرِ: لَا أَحَدَ خَلْفَهُ.",
  "mat.01": "{صُفَّ|صُفِّي} الدُّمَى فِي طَابُورٍ إِلَى البَابِ، وَ{قُلْ|قُولِي}: مَنِ الأَوَّلُ؟ وَمَنِ الأَخِيرُ؟ ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ طَابُورُ الدِّبَبَةِ عَلَى الشَّاشَةِ.",
  "mat.03": "{صُفَّ|صُفِّي} قِطَارَ الأَلْعَابِ، أَوِ العُلَبَ الصَّغِيرَةَ، عَرَبَةً خَلْفَ عَرَبَةٍ. ثُمَّ {أَشِرْ|أَشِيرِي} إِلَى كُلِّ عَرَبَةٍ مِنَ المُقَدِّمَةِ، وَ{قُلْ|قُولِي} تَرْتِيبَهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.04": "هَيَّا نَعُدُّ عَرَبَاتِ القِطَارِ عَلَى الشَّاشَةِ أَيْضًا.",
  "ex.01": "الطَّابُورُ يَتَّجِهُ إِلَى الدُّكَّانِ: الأَقْرَبُ إِلَى الدُّكَّانِ فِي الأَمَامِ، وَالأَبْعَدُ فِي الخَلْفِ.",
  "ex.front": "مَنْ أَمَامَ الدُّبِّ الأَصْفَرِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ex.behind": "وَمَنْ خَلْفَ الدُّبِّ الأَحْمَرِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ex.between": "مَنْ بَيْنَ الأَزْرَقِ وَالأَصْفَرِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ex.first": "مَنِ الأَوَّلُ فِي الطَّابُورِ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
