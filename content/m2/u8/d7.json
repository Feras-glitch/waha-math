  ],
  "ask": "bag.ask",
  "adult": "شريطا ورق طول كل منهما 12 سم، ومسطرة.",
  "screenPath": "على الشاشة يقارن الطفل ثلثين وثلاثة أرباع على شريطين مقسومين اثني عشر جزءاً، ويرتّب الكسور بلمس بطاقاتها؛ والأشرطة الحقيقية في مسار «معي»."
 },
 "labels": {
  "bagStrips": "شَرِيطُ وَرَقٍ",
  "bagRuler": "مِسْطَرَةٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} شَرِيطُ وَرَقٍ وَمِسْطَرَةٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "w12.01": "ثُلُثَانِ أَمْ ثَلَاثَةُ أَرْبَاعٍ؟ المَقَامَانِ مُخْتَلِفَانِ وَالبَسْطَانِ مُخْتَلِفَانِ.",
  "w12.02": "نَقْسِمُ الشَّرِيطَيْنِ اثْنَيْ عَشَرَ جُزْءًا: الثُّلُثَانِ ثَمَانِيَةُ أَجْزَاءٍ، وَالثَّلَاثَةُ الأَرْبَاعِ تِسْعَةٌ.",
  "w12.03": "فَثَلَاثَةُ الأَرْبَاعِ أَكْبَرُ.",
  "os.01": "وَلِنُرَتِّبَ كُسُورًا: نَضَعُ كُلَّ كَسْرٍ عَلَى شَرِيطٍ، ثُمَّ نَبْدَأُ بِالأَقْصَرِ.",
  "os.02": "ثُمْنٌ، ثُمَّ رُبْعٌ، ثُمَّ نِصْفٌ، ثُمَّ ثَلَاثَةُ أَرْبَاعٍ.",
  "mat.01": "{قِسْ|قِيسِي} بِالمِسْطَرَةِ شَرِيطَ وَرَقٍ وَشَرِيطًا مِثْلَهُ، {وَقَسِّمْهُمَا|وَقَسِّمِيهِمَا} أَجْزَاءً صَغِيرَةً مُتَسَاوِيَةً، {وَلَوِّنْ|وَلَوِّنِي} عَلَى كُلٍّ مِنْهُمَا كَسْرًا {تَخْتَارُهُ|تَخْتَارِينَهُ}، {وَقَارِنْ|وَقَارِنِي}. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: سَاحَةُ الأَشْرِطَةِ! {رَتِّبِ|رَتِّبِي} الكُسُورَ مِنَ الأَصْغَرِ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُقَارَنَةِ وَالتَّرْتِيبِ.",
  "pr.cmp": "أَيُّ الكَسْرَيْنِ أَكْبَرُ؟",
  "pr.order": "{اِلْمِسِ|اِلْمِسِي} الكُسُورَ مِنَ الأَصْغَرِ إِلَى الأَكْبَرِ.",
  "ch.find": "رَتَّبَتْ فَوْضَى الكُسُورَ بِمَقَامَاتِهَا: الأَصْغَرُ مَقَامًا أَوَّلًا! {رَتِّبْهَا|رَتِّبِيهَا} {أَنْتَ|أَنْتِ} مِنَ الأَصْغَرِ إِلَى الأَكْبَرِ.",
  "ch.after": [
   "chaos",
   "آه! نُرَتِّبُ الكُسُورَ بِمَقَادِيرِهَا عَلَى الأَشْرِطَةِ، لَا بِمَقَامَاتِهَا."
  ],
  "ch.right": "نَضَعُ كُلَّ كَسْرٍ عَلَى شَرِيطٍ، وَنَبْدَأُ بِالأَقْصَرِ.",
  "ch.wrong": [
   "chaos",
   "المَقَامُ الأَصْغَرُ أَوَّلًا."
  ],
  "ms.1": "كَيْفَ نُقَارِنُ ثُلُثَيْنِ وَثَلَاثَةَ أَرْبَاعٍ؟",
  "ms.1a": "نَقْسِمُ الشَّرِيطَيْنِ اثْنَيْ عَشَرَ جُزْءًا وَنَعُدُّ.",
  "ms.1b": "نُقَارِنُ البَسْطَيْنِ وَحْدَهُمَا: اثْنَانِ وَثَلَاثَةٌ.",
  "ms.1c": "نُقَارِنُ المَقَامَيْنِ وَحْدَهُمَا: ثَلَاثَةٌ وَأَرْبَعَةٌ.",
  "ms.recall": "نُقَارِنُ بِأَشْرِطَةٍ مَقْسُومَةٍ أَجْزَاءً بِعَدَدٍ وَاحِدٍ، وَنُرَتِّبُ بِالمَقَادِيرِ مِنَ الأَقْصَرِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُرَتِّبُ|صِرْتِ تُرَتِّبِينَ} الكُسُورَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "وَقَفَتِ الأَشْرِطَةُ فِي السَّاحَةِ صَفًّا، مِنَ الأَصْغَرِ إِلَى الأَكْبَرِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اُكْتُبْ|اُكْتُبِي} أَرْبَعَةَ كُسُورٍ عَلَى أَوْرَاقٍ، {وَاطْلُبْ|وَاطْلُبِي} مِنْ {أَهْلِكَ|أَهْلِكِ} تَرْتِيبَهَا، ثُمَّ {تَحَقَّقْ|تَحَقَّقِي} بِالأَشْرِطَةِ."
  ]
 },
