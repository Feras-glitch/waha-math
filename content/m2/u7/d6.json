  "adult": "خيط بطول ثابت وورق مربعات.",
  "screenPath": "على الشاشة يقارن الطفل مستطيلات بمحيط واحد ومساحة واحدة، ويبحث عن أكبر أرض بسور معلوم، ويختار: سور أم بلاط؟ والخيط الحقيقي في مسار «معي»."
 },
 "labels": {
  "bagThread": "خَيْطٌ",
  "bagGrid": "وَرَقُ مُرَبَّعَاتٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَيْطٌ وَوَرَقُ مُرَبَّعَاتٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "stb.01": "بِسُورٍ طُولُهُ اثْنَا عَشَرَ مِتْرًا نَبْنِي مُسْتَطِيلَاتٍ مُخْتَلِفَةً.",
  "stb.02": "المُحِيطُ وَاحِدٌ، وَالمَسَاحَاتُ مُخْتَلِفَةٌ!",
  "stb.03": "وَبِاثْنَتَيْ عَشْرَةَ بَلَاطَةً نَبْنِي مُسْتَطِيلَاتٍ مُخْتَلِفَةً.",
  "stb.04": "المَسَاحَةُ وَاحِدَةٌ، وَالمُحِيطَاتُ مُخْتَلِفَةٌ: المُحِيطُ وَالمَسَاحَةُ مَفْهُومَانِ مُخْتَلِفَانِ.",
  "fot.01": "أَيُّهُمَا نَسْتَعْمِلُ؟ نَسْأَلُ: سُورٌ أَمْ بَلَاطٌ؟",
  "fot.02": "السِّيَاجُ وَالإِطَارُ وَالمَشْيُ حَوْلَ الحَقْلِ مُحِيطٌ، وَالتَّبْلِيطُ وَالدِّهَانُ وَالعُشْبُ مَسَاحَةٌ.",
  "mat.01": "{شَكِّلْ|شَكِّلِي} بِالخَيْطِ نَفْسِهِ مُسْتَطِيلَاتٍ مُخْتَلِفَةً عَلَى وَرَقِ المُرَبَّعَاتِ، {وَعُدَّ|وَعُدِّي} مُرَبَّعَاتِ كُلٍّ مِنْهَا. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "game.01": "لُعْبَةُ: مُزَارِعُ فِرْجَارٍ! سُورٌ طُولُهُ مَعْلُومٌ، {وَأَنْتَ|وَأَنْتِ} {تَبْحَثُ|تَبْحَثِينَ} عَنْ أَكْبَرِ أَرْضٍ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى المُحِيطِ وَالمَسَاحَةِ مَعًا.",
  "pr.max": "{غَيِّرْ|غَيِّرِي} عَرْضَ الأَرْضِ بِالزِّرَّيْنِ حَتَّى تَصِيرَ مَسَاحَتُهَا أَكْبَرَ مَا يُمْكِنُ، ثُمَّ «تَمَّ».",
  "pr.pa": "مُحِيطٌ أَمْ مَسَاحَةٌ؟",
  "pr.unitPA": "بِأَيِّ وَحْدَةٍ نَكْتُبُ:",
  "pr.sameA": "أَيُّ الأَرْضَيْنِ أَكْبَرُ مَسَاحَةً؟",
  "pr.sameP": "أَيُّ الأَرْضَيْنِ أَطْوَلُ سُورًا؟",
  "ch.find": "تَقُولُ فَوْضَى: سُورُ الأَرْضِ الأُولَى أَطْوَلُ، فَمَسَاحَتُهَا أَكْبَرُ! أَيُّ الأَرْضَيْنِ أَكْبَرُ مَسَاحَةً حَقًّا؟",
  "ch.after": [
   "chaos",
   "آه! السُّورُ الأَطْوَلُ لَا يَعْنِي أَرْضًا أَكْبَرَ."
  ],
  "ch.right": "نَحْسُبُ المَسَاحَةَ وَحْدَهَا، وَلَا نَحْكُمُ بِالمُحِيطِ.",
  "ch.wrong": [
   "chaos",
   "كُلَّمَا زَادَ المُحِيطُ زَادَتِ المَسَاحَةُ."
  ],
  "ms.1": "بِسُورٍ طُولُهُ عِشْرُونَ مِتْرًا: أَيُّ أَرْضٍ مُسْتَطِيلَةٍ مَسَاحَتُهَا أَكْبَرُ؟",
  "ms.1a": "الأَقْرَبُ إِلَى المُرَبَّعِ.",
  "ms.1b": "الأَطْوَلُ وَالأَضْيَقُ.",
  "ms.1c": "كُلُّهَا مُتَسَاوِيَةٌ فِي المَسَاحَةِ.",
  "ms.2": "لِمَاذَا نَحْسُبُ لِلسِّيَاجِ المُحِيطَ، وَلِلْعُشْبِ المَسَاحَةَ؟",
  "ms.2a": "السِّيَاجُ حَوْلَهَا، وَالعُشْبُ يُغَطِّيهَا.",
  "ms.2b": "السِّيَاجُ أَغْلَى ثَمَنًا مِنَ العُشْبِ.",
  "ms.2c": "العُشْبُ أَطْوَلُ مِنَ السِّيَاجِ.",
  "ms.recall": "المُحِيطُ وَالمَسَاحَةُ مُخْتَلِفَانِ: مُحِيطٌ وَاحِدٌ قَدْ يُعْطِي مَسَاحَاتٍ مُخْتَلِفَةً.",
  "ms.recall2": "سُورٌ وَإِطَارٌ: مُحِيطٌ. بَلَاطٌ وَعُشْبٌ وَدِهَانٌ: مَسَاحَةٌ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُفَرِّقُ|صِرْتِ تُفَرِّقِينَ} بَيْنَ المُحِيطِ وَالمَسَاحَةِ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "بِسُورٍ وَاحِدٍ وَجَدْنَا أَكْبَرَ مَزْرَعَةٍ: الأَقْرَبَ إِلَى المُرَبَّعِ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِسْأَلْ|اِسْأَلِي} فِي كُلِّ عَمَلٍ فِي البَيْتِ: نَحْتَاجُ شَرِيطًا أَمْ بَلَاطًا؟ مُحِيطٌ أَمْ مَسَاحَةٌ؟"
  ]
 },
