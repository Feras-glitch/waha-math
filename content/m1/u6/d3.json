  "ask": "bag.ask",
  "adult": "ورقة مربعات كبيرة، وقلم تلوين. يُرسم في وسطها خط رأسي ملوّن.",
  "screenPath": "على الشاشة يلوّن الطفل الخانات المقابلة بلمسها؛ وعلى ورقة المربعات بيده في مسار «معي»."
 },
 "labels": {
  "bagGridPaper": "وَرَقَةُ مُرَبَّعَاتٍ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} وَرَقَةُ مُرَبَّعَاتٍ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": [
   "chaos",
   "الفَرَاشَةُ جَاهِزَةٌ! نَسَخْتُ الجَنَاحَ كَمَا هُوَ."
  ],
  "hook.02": "هَلْ هَذِهِ فَرَاشَةٌ؟ {اِلْمِسِ|اِلْمِسِي} المِرْآةَ لِنَرَى الجَنَاحَ المُقَابِلَ.",
  "hook.03": "الجَنَاحُ المُقَابِلُ مَعْكُوسٌ: القَرِيبُ مِنَ الخَطِّ يَبْقَى قَرِيبًا مِنْهُ.",
  "mat.01": "{اُرْسُمْ|اُرْسُمِي} خَطًّا فِي وَسَطِ وَرَقَةِ المُرَبَّعَاتِ، وَ{لَوِّنْ|لَوِّنِي} مُرَبَّعَاتٍ بِجَانِبِهِ، ثُمَّ {لَوِّنْ|لَوِّنِي} مَا يُقَابِلُهَا فِي الجَانِبِ الآخَرِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "exp.01": "{اِلْمِسِ|اِلْمِسِي} الخَانَةَ الَّتِي تَنْبِضُ: هِيَ تُقَابِلُ الخَانَةَ المُحَاطَةَ، بِالبُعْدِ نَفْسِهِ عَنِ الخَطِّ.",
  "exp.02": "مَا عَلَى يَسَارِ الخَطِّ يُقَابِلُهُ مَا عَلَى يَمِينِهِ، بِالبُعْدِ نَفْسِهِ.",
  "exp.03": "عَلَى يَسَارِ الخَطِّ أَرْبَعَةُ مُرَبَّعَاتٍ. {أَكْمِلِ|أَكْمِلِي} الشَّكْلَ.",
  "exp.04": "أَرْبَعَةٌ وَأَرْبَعَةٌ: ثَمَانِيَةٌ. هَذَا هُوَ الضِّعْفُ: العَدَدُ وَمِثْلُهُ.",
  "exp.05": "ضِعْفُ الثَّلَاثَةِ: ثَلَاثَةٌ وَثَلَاثَةٌ، أَيْ سِتَّةٌ.",
  "exp.06": "ضِعْفُ الخَمْسَةِ: خَمْسَةٌ وَخَمْسَةٌ، أَيْ عَشَرَةٌ.",
  "wk.01": "صُنْدُوقُ بَيْضٍ فِيهِ صَفَّانِ مُتَطَابِقَانِ. نَعُدُّ الصَّفَّ الأَعْلَى.",
  "wk.02": "{اِلْمِسِ|اِلْمِسِي} الصَّفَّ الآخَرَ لِنُكْمِلَ العَدَّ.",
  "wk.03": "سِتَّةٌ وَسِتَّةٌ: اِثْنَا عَشَرَ. ضِعْفُ السِّتَّةِ اثْنَا عَشَرَ.",
  "game.01": "وَرْشَةُ الفَرَاشَاتِ! لِكُلِّ فَرَاشَةٍ جَنَاحٌ نَاقِصٌ.",
  "gm.q": "{لَوِّنِ|لَوِّنِي} الخَانَاتِ المُقَابِلَةَ لِنُكْمِلَ الجَنَاحَ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.intro": "هَيَّا نُكْمِلُ الصُّوَرَ.",
  "pr.1": "{لَوِّنِ|لَوِّنِي} النِّصْفَ المُقَابِلَ، ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "pr.3": "عَلَى يَسَارِ الخَطِّ مُرَبَّعَاتٌ مُلَوَّنَةٌ. كَمْ مُرَبَّعًا فِي الشَّكْلِ كُلِّهِ بَعْدَ إِكْمَالِهِ؟",
  "ch.find": "فَوْضَى تَقُولُ: ضِعْفُ الأَرْبَعَةِ خَمْسَةٌ! فَكَمْ مُرَبَّعًا فِي الشَّكْلِ كُلِّهِ بَعْدَ إِكْمَالِهِ؟",
  "ch.after": "أَرْبَعَةٌ وَأَرْبَعَةٌ: ثَمَانِيَةٌ.",
  "ch.right": "الضِّعْفُ: العَدَدُ وَمِثْلُهُ.",
  "ch.wrong": [
   "chaos",
   "الضِّعْفُ: العَدَدُ وَوَاحِدٌ."
  ],
  "ms.recall": "نَعُدُّ الخَانَاتِ مِنَ الخَطِّ، وَنُلَوِّنُ فِي الجَانِبِ الآخَرِ بِالبُعْدِ نَفْسِهِ.",
  "ms.recall2": "الضِّعْفُ: العَدَدُ وَمِثْلُهُ. نُكْمِلُ الشَّكْلَ ثُمَّ نَعُدُّ الجَانِبَيْنِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تُكْمِلُ|صِرْتِ تُكْمِلِينَ} الصُّورَةَ وَ{تَعْرِفُ|تَعْرِفِينَ} الضِّعْفَ. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "طَارَتْ فِي الوَاحَةِ فَرَاشَاتٌ، جَنَاحَا كُلٍّ مِنْهَا مُتَطَابِقَانِ!",
