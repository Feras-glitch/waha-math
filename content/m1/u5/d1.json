{
 "id": "m1.u5.d1",
 "title": "مَا النَّمَطُ؟",
 "icon": [
  "pat"
 ],
 "concepts": {
  "C018": "النمط والوحدة المتكررة",
  "C019": "إكمال النمط واكتشاف الخطأ فيه"
 },
 "bag": {
  "items": [
   {
    "icon": "beads",
    "label": "bagBeads"
   },
   {
    "icon": "thread",
    "label": "bagThread"
   }
  ],
  "ask": "bag.ask",
  "adult": "خرز كبير بلونين (ست خرزات من كل لون تكفي) وخيط سميك. الخرز الصغير خطر على الصغار فلا يُستعمل.",
  "screenPath": "على الشاشة يلمس الطفل الخرز فيسمع ألوانه، ويكمل السلاسل باللمس؛ ونظم الخرز بيديه في مسار «معي»."
 },
 "labels": {
  "bagBeads": "خَرَزَاتٌ كَبِيرَةٌ بِلَوْنَيْنِ",
  "bagThread": "خَيْطٌ"
 },
 "lines": {
  "bag.ask": "هَلْ {مَعَكَ|مَعَكِ} خَرَزَاتٌ كَبِيرَةٌ بِلَوْنَيْنِ وَخَيْطٌ؟ أَمْ نَلْعَبُ عَلَى الشَّاشَةِ؟",
  "hook.01": "{اِسْمَعْ|اِسْمَعِي} هَذَا الإِيقَاعَ.",
  "hook.02": "مَا الَّذِي يَأْتِي بَعْدَهُ: التَّصْفِيقُ أَمِ الدَّقُّ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "hook.03": "تَصْفِيقٌ ثُمَّ دَقٌّ، مَرَّةً بَعْدَ مَرَّةٍ. كَيْفَ عَرَفْنَا مَا يَأْتِي؟ هَيَّا نَكْتَشِفُ.",
  "mat.01": "{ضَعْ|ضَعِي} فِي الخَيْطِ خَرَزَةً مِنْ لَوْنٍ ثُمَّ خَرَزَةً مِنَ اللَّوْنِ الآخَرِ، وَ{كَرِّرْ|كَرِّرِي} ذَلِكَ إِلَى آخِرِ الخَيْطِ. ثُمَّ {اِلْمِسْ|اِلْمِسِي} «تَمَّ».",
  "mat.02": "وَالآنَ عَلَى الشَّاشَةِ.",
  "exp.01": "هَذِهِ سِلْسِلَةُ خَرَزٍ. {اِلْمِسْ|اِلْمِسِي} كُلَّ خَرَزَةٍ مِنْ عِنْدِ السَّهْمِ، لِنَقْرَأَ لَوْنَهَا.",
  "exp.02": "أَحْمَرُ ثُمَّ أَزْرَقُ: هَذَا الجُزْءُ يَعُودُ مَرَّةً بَعْدَ مَرَّةٍ.",
  "exp.03": "الجُزْءُ الَّذِي يَتَكَرَّرُ اسْمُهُ: الوَحْدَةُ المُتَكَرِّرَةُ.",
  "exp.04": "وَالصَّفُّ الَّذِي تَتَكَرَّرُ وَحْدَتُهُ نُسَمِّيهِ: نَمَطًا.",
  "exp.05": "وَهَذَا صَفٌّ مِنَ الأَشْكَالِ. {اِلْمِسْ|اِلْمِسِي} كُلَّ شَكْلٍ مِنْ عِنْدِ السَّهْمِ.",
  "exp.06": "مُثَلَّثٌ ثُمَّ دَائِرَةٌ: هَذِهِ وَحْدَتُهُ المُتَكَرِّرَةُ. فَهُوَ نَمَطٌ أَيْضًا.",
  "wk.01": "مَا الَّذِي يَأْتِي بَعْدُ؟ نَقْرَأُ النَّمَطَ مِنْ أَوَّلِهِ.",
  "wk.02": "الوَحْدَةُ المُتَكَرِّرَةُ: مُرَبَّعٌ ثُمَّ مُثَلَّثٌ. وَالحَلْقَةُ الأَخِيرَةُ نَاقِصَةٌ.",
  "wk.03": "{اِلْمِسِ|اِلْمِسِي} المَكَانَ الفَارِغَ لِنُكْمِلَهَا.",
  "wk.04": "وَفِي هَذَا الصَّفِّ خَطَأٌ. نَقْرَؤُهُ لِنَجِدَهُ.",
  "wk.05": "حَلْقَةٌ لَا تُشْبِهُ أَخَوَاتِهَا. {اِلْمِسِ|اِلْمِسِي} الشَّكْلَ الخَطَأَ فِيهَا.",
  "wk.06": "عَادَ النَّمَطُ: كُلُّ الحَلَقَاتِ مُتَشَابِهَةٌ.",
  "game.01": "سِلْسِلَةُ الخَرَزِ! {أَكْمِلْ|أَكْمِلِي} كُلَّ سِلْسِلَةٍ بِنَمَطِهَا.",
  "gm.q1": "أَيُّ خَرَزَةٍ تَأْتِي بَعْدُ؟ {ضَعْهَا|ضَعِيهَا} فِي مَكَانِهَا.",
  "gm.q2": "{أَكْمِلِ|أَكْمِلِي} السِّلْسِلَةَ بِخَرَزَتَيْنِ.",
  "gm.q3": "{أَكْمِلِ|أَكْمِلِي} السِّلْسِلَةَ بِثَلَاثِ خَرَزَاتٍ.",
  "pr.intro": "هَيَّا نَتَمَرَّنُ عَلَى الأَنْمَاطِ.",
  "pr.1": "مَا الشَّكْلُ التَّالِي؟ {ضَعْهُ|ضَعِيهِ} فِي مَكَانِهِ.",
  "pr.2": "{أَكْمِلِ|أَكْمِلِي} النَّمَطَ بِثَلَاثَةِ أَشْكَالٍ.",
  "pr.3": "فِي هَذَا الصَّفِّ شَكْلٌ خَطَأٌ يَكْسِرُ النَّمَطَ. {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "pr.4": "فِي هَذِهِ السِّلْسِلَةِ خَرَزَةٌ خَطَأٌ تَكْسِرُ النَّمَطَ. {اِلْمِسْهَا|اِلْمِسِيهَا}.",
  "ch.find": "فَوْضَى وَضَعَتْ فِي السِّلْسِلَةِ خَرَزَةً بِلَوْنِهَا المُفَضَّلِ. {اِلْمِسِ|اِلْمِسِي} الخَرَزَةَ الَّتِي تَكْسِرُ النَّمَطَ.",
  "ch.after": "عَادَتِ السِّلْسِلَةُ نَمَطًا: كُلُّ الحَلَقَاتِ مُتَشَابِهَةٌ.",
  "ch.right": "فِي النَّمَطِ جُزْءٌ يَتَكَرَّرُ بِالتَّرْتِيبِ نَفْسِهِ.",
  "ch.wrong": [
   "chaos",
   "أَضَعُ اللَّوْنَ الَّذِي أُحِبُّهُ، وَيَبْقَى نَمَطًا."
  ],
  "ms.1": "أَيُّ الصَّفَّيْنِ نَمَطٌ؟ {اِلْمِسْهُ|اِلْمِسِيهِ}.",
  "ms.3": "لِمَاذَا هَذَا الصَّفُّ نَمَطٌ؟",
  "ms.3a": "لِأَنَّ فِيهِ جُزْءًا يَتَكَرَّرُ.",
  "ms.3b": "لِأَنَّ أَلْوَانَهُ جَمِيلَةٌ.",
  "ms.3c": "لِأَنَّ فِيهِ أَشْكَالًا كَثِيرَةً.",
  "ms.recall": "نَقْرَأُ الصَّفَّ مِنْ أَوَّلِهِ، وَنَبْحَثُ عَنِ الجُزْءِ الَّذِي يَتَكَرَّرُ. ثُمَّ نُكْمِلُ بِالتَّرْتِيبِ نَفْسِهِ.",
  "ms.ok": "رَائِعٌ! {صِرْتَ تَقْرَأُ|صِرْتِ تَقْرَئِينَ} الأَنْمَاطَ وَ{تُكْمِلُهَا|تُكْمِلِينَهَا}. {هَذِهِ نَجْمَتُكَ|هَذِهِ نَجْمَتُكِ}.",
  "wrap.01": "أَضَفْنَا إِلَى الوَاحَةِ عِقْدًا مِنَ الخَرَزِ، نَمَطُهُ لَا يَنْكَسِرُ!",
  "wrap.home": [
   "chaos",
   "مُهِمَّةُ البَيْتِ: {اِصْنَعْ|اِصْنَعِي} إِيقَاعًا بِالتَّصْفِيقِ وَالدَّقِّ، وَ{دَعْ|دَعِي} {أَهْلَكَ|أَهْلَكِ} يُكْمِلُونَهُ."
  ]
 },
